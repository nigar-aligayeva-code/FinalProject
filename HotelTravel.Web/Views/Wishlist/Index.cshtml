@model List<HotelTravel.Application.DTOs.Home.FeaturedRoomDto>

@{
    ViewData["Title"] = "Saved";

    string RatingLabel(double rating) => rating switch
    {
        >= 4.5 => "Exceptional",
        >= 4.0 => "Excellent",
        >= 3.5 => "Very good",
        >= 3.0 => "Good",
        _ => "Pleasant"
    };
}

<section class="hh-hero hh-hero-small">
    <div class="container">
        <h1><i class="bi bi-heart me-2"></i>Saved</h1>
        <p>Rooms you liked, all in one place.</p>
    </div>
</section>

<div class="container hh-section pt-4">

    <div class="hh-empty @(Model.Any() ? "d-none" : "")" id="savedEmpty">
        <i class="bi bi-heart fs-2 d-block mb-2"></i>
        <strong class="d-block mb-1">You haven't saved any rooms yet</strong>
        Tap the <i class="bi bi-heart"></i> on any room to save it here.
        <div class="mt-3">
            <a asp-controller="Home"
               asp-action="Index"
               class="hh-btn hh-btn-primary">
                Explore rooms
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="hh-room-grid" id="savedGrid">
            @foreach (var room in Model)
            {
                <div class="hh-room-wrap">
                    <button type="button"
                            class="hh-save saved"
                            data-room-id="@room.Id"
                            data-remove-card="1"
                            aria-label="Remove from saved"
                            aria-pressed="true">
                        <i class="bi bi-heart-fill"></i>
                    </button>

                    <a asp-controller="Rooms"
                       asp-action="Details"
                       asp-route-id="@room.Id"
                       class="hh-room">

                        <div class="hh-room-img">
                            @if (!string.IsNullOrWhiteSpace(room.MainImage))
                            {
                                <img src="@room.MainImage" alt="@room.Name" loading="lazy" />
                            }
                            <span class="hh-room-type">@room.RoomType</span>
                        </div>

                        <div class="hh-room-body">
                            <h3>@room.Name</h3>

                            <div class="hh-room-meta">
                                @room.HotelName · @room.City
                                <br />
                                <i class="bi bi-people"></i>
                                Up to @room.Capacity guest@(room.Capacity == 1 ? "" : "s")
                            </div>

                            <div class="hh-rating">
                                @if (room.ReviewCount > 0)
                                {
                                    <span class="hh-score">@room.AverageRating.ToString("0.0")</span>
                                    <strong>@RatingLabel(room.AverageRating)</strong>
                                    <span>@room.ReviewCount review@(room.ReviewCount == 1 ? "" : "s")</span>
                                }
                                else
                                {
                                    <span class="hh-badge-new">New</span>
                                    <span>No reviews yet</span>
                                }
                            </div>

                            <div class="hh-room-price">
                                <small>per night from</small>
                                <strong>@room.PricePerNight.ToString("0.00") AZN</strong>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

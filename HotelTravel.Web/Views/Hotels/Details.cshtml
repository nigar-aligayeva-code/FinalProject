@model HotelTravel.Application.DTOs.Hotels.GetHotelDto

@{
    ViewData["Title"] = Model.Name;

    var images = Model.Images ?? new List<HotelTravel.Application.DTOs.Hotels.GetHotelImageDto>();

    // Gallery boş olsa MainImage fallback kimi istifadə olunur
    var sliderImages = images.Select(x => x.ImageUrl).ToList();

    if (sliderImages.Count == 0 && !string.IsNullOrWhiteSpace(Model.MainImage))
    {
        sliderImages.Add(Model.MainImage);
    }
}

<section class="hotel-details-page">

    <div class="container">

        <!-- BACK -->
        <a asp-action="Index" class="hotel-back-link">
            <i class="bi bi-arrow-left"></i>
            Back to Hotels
        </a>


        <!-- HOTEL HEADING -->
        <div class="hotel-details-heading">

            <div>
                <div class="hotel-details-location">
                    <i class="bi bi-geo-alt-fill"></i>
                    @Model.City, @Model.Country
                </div>

                <h1>@Model.Name</h1>

                <div class="hotel-heading-bottom">

                    <div class="hotel-detail-stars">
                        @for (int i = 0; i < Model.StarRating; i++)
                        {
                            <i class="bi bi-star-fill"></i>
                        }

                        <span>@Model.StarRating Star Hotel</span>
                    </div>

                    <span class="hotel-type-dot"></span>

                    <div class="hotel-chain-name">
                        <i class="bi bi-buildings"></i>

                        @if (!string.IsNullOrWhiteSpace(Model.HotelChainName))
                        {
                            @Model.HotelChainName
                        }
                        else
                        {
                            <span>Independent Hotel</span>
                        }
                    </div>

                </div>
            </div>


            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="hotel-edit-btn">

                    <i class="bi bi-pencil"></i>
                    Edit Hotel

                </a>
            }

        </div>


        <!-- =========================
             MAIN SLIDER
        ========================== -->

        <div class="hotel-slider">

            @if (sliderImages.Count > 0)
            {
                @for (int i = 0; i < sliderImages.Count; i++)
                {
                    <div class="hotel-slide @(i == 0 ? "active" : "")">
                        <img src="@sliderImages[i]"
                             alt="@Model.Name" />
                    </div>
                }


                @if (sliderImages.Count > 1)
                {
                    <button type="button"
                            class="slider-arrow slider-prev"
                            aria-label="Previous image">

                        <i class="bi bi-chevron-left"></i>

                    </button>

                    <button type="button"
                            class="slider-arrow slider-next"
                            aria-label="Next image">

                        <i class="bi bi-chevron-right"></i>

                    </button>
                }


                <button type="button"
                        class="gallery-count-btn"
                        id="openHotelGallery">

                    <i class="bi bi-images"></i>

                    <span>
                        @sliderImages.Count Photos
                    </span>

                </button>


                <div class="slider-counter">
                    <span id="currentSlideNumber">1</span>
                    /
                    <span>@sliderImages.Count</span>
                </div>
            }
            else
            {
                <div class="hotel-no-image">
                    <i class="bi bi-image"></i>
                    <span>No images available</span>
                </div>
            }

        </div>


        <!-- =========================
             ABOUT
        ========================== -->

        <div class="hotel-content-grid">

            <div class="hotel-about">

                <span class="section-eyebrow">
                    <i class="bi bi-gem"></i>
                    THE EXPERIENCE
                </span>

                <h2>About the Hotel</h2>

                <p>
                    @Model.Description
                </p>

            </div>


            <div class="hotel-quick-info">

                <!-- LOCATION -->
                <div class="quick-info-item">

                    <div class="quick-info-icon">
                        <i class="bi bi-geo-alt"></i>
                    </div>

                    <div>
                        <span>Location</span>

                        <strong>
                            @Model.Address
                        </strong>

                        <p>
                            @Model.City, @Model.Country
                        </p>
                    </div>

                </div>


                <!-- PHONE -->
                <div class="quick-info-item">

                    <div class="quick-info-icon">
                        <i class="bi bi-telephone"></i>
                    </div>

                    <div>
                        <span>Reservations</span>

                        <strong>
                            @Model.Phone
                        </strong>

                        <p>Available for enquiries</p>
                    </div>

                </div>


                <!-- EMAIL -->
                <div class="quick-info-item">

                    <div class="quick-info-icon">
                        <i class="bi bi-envelope"></i>
                    </div>

                    <div>
                        <span>Email</span>

                        <strong>
                            @Model.Email
                        </strong>

                        <p>Guest assistance</p>
                    </div>

                </div>


                <!-- HOTEL TYPE -->
                <div class="quick-info-item">

                    <div class="quick-info-icon">
                        <i class="bi bi-building"></i>
                    </div>

                    <div>
                        <span>Hotel Type</span>

                        <strong>
                            @Model.StarRating Star Hotel
                        </strong>

                        <p>
                            @(string.IsNullOrWhiteSpace(Model.HotelChainName)
                                ? "Independent Hotel"
                                : Model.HotelChainName)
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================
     FULL SCREEN GALLERY
========================================== -->
@if (images.Count > 0)
{
    <div class="hotel-gallery-modal"
         id="hotelGalleryModal">

        <div class="gallery-modal-header">

            <div>

                <span class="gallery-small-title">
                    PHOTO GALLERY
                </span>

                <h2>@Model.Name</h2>

            </div>


            <button type="button"
                    class="gallery-close-btn"
                    id="closeHotelGallery">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>


        <div class="gallery-modal-body">

            <!-- FILTERS -->
            <div class="gallery-filters">

                <button type="button"
                        class="gallery-filter active"
                        data-category="All">

                    All
                    <span>@images.Count</span>

                </button>


                @foreach (var category in images
                    .Select(x => x.Category)
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .Distinct())
                {
                    var count = images.Count(x => x.Category == category);

                    <button type="button"
                            class="gallery-filter"
                            data-category="@category">

                        @category
                        <span>@count</span>

                    </button>
                }

            </div>


            <!-- IMAGES -->
            <div class="gallery-grid">

                @foreach (var image in images)
                {
                    <button type="button"
                            class="gallery-image-card"
                            data-category="@image.Category"
                            data-image="@image.ImageUrl">

                        <img src="@image.ImageUrl"
                             alt="@Model.Name - @image.Category" />

                        <div class="gallery-image-overlay">

                            <span>
                                @image.Category
                            </span>

                            <i class="bi bi-arrows-fullscreen"></i>

                        </div>

                    </button>
                }

            </div>

        </div>

    </div>


    <!-- IMAGE LIGHTBOX -->
    <div class="image-lightbox"
         id="imageLightbox">

        <button type="button"
                class="lightbox-close"
                id="closeLightbox">

            <i class="bi bi-x-lg"></i>

        </button>


        <button type="button"
                class="lightbox-arrow lightbox-prev"
                id="lightboxPrev">

            <i class="bi bi-chevron-left"></i>

        </button>


        <img id="lightboxImage"
             src=""
             alt="@Model.Name" />


        <button type="button"
                class="lightbox-arrow lightbox-next"
                id="lightboxNext">

            <i class="bi bi-chevron-right"></i>

        </button>

    </div>
}



<style>


@model HotelTravel.Application.DTOs.Hotels.GetHotelDto

@{
    ViewData["Title"] = "Delete Hotel";
}

<div class="container mt-5 mb-5">

    <h2 class="mb-4">Delete Hotel</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this hotel?
    </div>

    <div class="card mb-4">
        <div class="card-body">

            <p>
                <strong>Name:</strong>
                @Model.Name
            </p>

            <p>
                <strong>City:</strong>
                @Model.City
            </p>

            <p>
                <strong>Country:</strong>
                @Model.Country
            </p>

            <p>
                <strong>Star Rating:</strong>
                @Model.StarRating ⭐
            </p>

            <p>
                <strong>Phone:</strong>
                @Model.Phone
            </p>

            <p>
                <strong>Email:</strong>
                @Model.Email
            </p>

        </div>
    </div>

    <form asp-action="DeleteConfirmed"
          asp-route-id="@Model.Id"
          method="post">

        <button type="submit"
                class="btn btn-danger">
            Yes, Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>
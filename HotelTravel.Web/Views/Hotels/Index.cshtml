@model List<HotelTravel.Application.DTOs.Hotels.GetHotelDto>

@{
    ViewData["Title"] = "Hotels";

    // Seed otellərinin exterior şəkilləri (kartlardakı ilə eyni)
    var exteriorImages = new Dictionary<string, string>
    {
        ["Caspian Grand Hotel"] = "/assets/images/hotels/baku-exterior.jpg",
        ["Gabala Mountain Resort"] = "/assets/images/hotels/gabala-exterior.jpg",
        ["Bosphorus Palace Hotel"] = "/assets/images/hotels/istanbul-exterior.jpg",
        ["Antalya Blue Resort"] = "/assets/images/hotels/antalya-exterior.jpg",
        ["Tbilisi Heritage Hotel"] = "/assets/images/hotels/tbilisi-exterior.jpg",
        ["Batumi Sea View Hotel"] = "/assets/images/hotels/batumi-exterior.jpg",
        ["Dubai Marina Luxury Hotel"] = "/assets/images/hotels/dubai-exterior.jpg"
    };

    // Xəritə üçün: koordinatı olan otellər (JSON -> Leaflet)
    var mapHotels = (Model ?? new List<HotelTravel.Application.DTOs.Hotels.GetHotelDto>())
        .Where(h => h.Latitude != 0 || h.Longitude != 0)
        .Select(h => new
        {
            id = h.Id,
            name = h.Name,
            city = h.City,
            country = h.Country,
            lat = h.Latitude,
            lng = h.Longitude,
            stars = h.StarRating,
            image = exteriorImages.TryGetValue(h.Name ?? "", out var ext) ? ext : h.MainImage,
            url = Url.Action("Details", "Hotels", new { id = h.Id })
        })
        .ToList();

    var mapHotelsJson = System.Text.Json.JsonSerializer.Serialize(mapHotels);
}

<section class="hotels-page">

    <div class="container">

        <!-- HEADER -->
        <div class="hotels-page-header">

            <div>
                <span class="hotels-eyebrow">
                    <i class="bi bi-compass"></i>
                    @T["CURATED STAYS"]
                </span>

                <h1>@T["Discover Exceptional Stays"]</h1>

                <p>
                    Handpicked hotels designed for memorable journeys,
                    exceptional comfort and unforgettable experiences.
                </p>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Hotels"
                   asp-action="Create"
                   class="add-hotel-btn">

                    <i class="bi bi-plus-lg"></i>
                    @T["Add Hotel"]

                </a>
            }

        </div>


        @if (Model == null || Model.Count == 0)
        {
            <div class="hotels-empty">

                <i class="bi bi-building"></i>

                <h3>@T["No hotels found"]</h3>

                <p>
                    @T["There are currently no hotels available."]
                </p>

            </div>
        }
        else
        {
            @if (mapHotels.Any())
            {
                <!-- XƏRİTƏ -->
                <div class="hotels-map-card">
                    <div class="hotels-map-head">
                        <div>
                            <h3><i class="bi bi-map"></i> @T["Hotels on the map"]</h3>
                            <p>@(T["{0} hotels across {1} cities. Tap a pin to see the hotel.", mapHotels.Count, mapHotels.Select(h => h.city).Distinct().Count()])</p>
                        </div>
                        <button type="button" class="hotels-map-toggle" id="mapToggle">
                            <i class="bi bi-eye-slash"></i> <span>@T["Hide map"]</span>
                        </button>
                    </div>
                    <div id="hotelsMap" class="hotels-map"></div>
                </div>
            }

            <div class="hotels-grid">

                @foreach (var hotel in Model)
                {
                    var imagePath = hotel.MainImage;

                    // Seed etdiyimiz hotellərin əsas şəkillərini
                    // gallery-dəki exterior şəkilləri ilə uyğunlaşdırırıq.
                    if (hotel.Name == "Caspian Grand Hotel")
                    {
                        imagePath = "/assets/images/hotels/baku-exterior.jpg";
                    }
                    else if (hotel.Name == "Gabala Mountain Resort")
                    {
                        imagePath = "/assets/images/hotels/gabala-exterior.jpg";
                    }
                    else if (hotel.Name == "Bosphorus Palace Hotel")
                    {
                        imagePath = "/assets/images/hotels/istanbul-exterior.jpg";
                    }
                    else if (hotel.Name == "Antalya Blue Resort")
                    {
                        imagePath = "/assets/images/hotels/antalya-exterior.jpg";
                    }
                    else if (hotel.Name == "Tbilisi Heritage Hotel")
                    {
                        imagePath = "/assets/images/hotels/tbilisi-exterior.jpg";
                    }
                    else if (hotel.Name == "Batumi Sea View Hotel")
                    {
                        imagePath = "/assets/images/hotels/batumi-exterior.jpg";
                    }
                    else if (hotel.Name == "Dubai Marina Luxury Hotel")
                    {
                        imagePath = "/assets/images/hotels/dubai-exterior.jpg";
                    }

                    <article class="hotel-card">

                        <!-- IMAGE -->
                        <div class="hotel-card-image">

                            @if (!string.IsNullOrWhiteSpace(imagePath))
                            {
                                <img src="@imagePath"
                                     alt="@hotel.Name" />
                            }
                            else
                            {
                                <div class="hotel-image-placeholder">
                                    <i class="bi bi-building"></i>
                                </div>
                            }


                            <!-- STARS -->
                            <div class="hotel-rating">

                                <i class="bi bi-star-fill"></i>

                                <span>
                                    @hotel.StarRating
                                </span>

                            </div>


                            <!-- ADMIN ACTIONS -->
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="hotel-admin-actions">

                                    <a asp-action="Edit"
                                       asp-route-id="@hotel.Id"
                                       class="hotel-admin-btn"
                                       title="@T["Edit hotel"]">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@hotel.Id"
                                       class="hotel-admin-btn delete"
                                       title="@T["Delete hotel"]">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </div>
                            }

                        </div>


                        <!-- CONTENT -->
                        <div class="hotel-card-content">

                            <div class="hotel-location">

                                <i class="bi bi-geo-alt-fill"></i>

                                <span>
                                    @hotel.City, @hotel.Country
                                </span>

                            </div>


                            <h2>
                                @hotel.Name
                            </h2>


                            <div class="hotel-chain">

                                <i class="bi bi-buildings"></i>

                                @if (!string.IsNullOrWhiteSpace(hotel.HotelChainName))
                                {
                                    <span>
                                        @hotel.HotelChainName
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        @T["Independent Hotel"]
                                    </span>
                                }

                            </div>


                            @if (!string.IsNullOrWhiteSpace(hotel.Description))
                            {
                                <p class="hotel-description">
                                    @hotel.Description
                                </p>
                            }


                            <div class="hotel-card-footer">

                                <div class="hotel-stars">

                                    @for (int i = 0; i < hotel.StarRating; i++)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }

                                </div>


                                <a asp-action="Details"
                                   asp-route-id="@hotel.Id"
                                   class="view-hotel-btn">

                                    @T["View Hotel"]

                                    <i class="bi bi-arrow-right"></i>

                                </a>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

    </div>

</section>


<style>

    /* =========================================
       HOTELS PAGE
    ========================================= */

    .hotels-page {
        background: #F3EEE5;
        min-height: 100vh;
        padding: 80px 0 100px;
    }


    /* HEADER */

    .hotels-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 30px;
        margin-bottom: 50px;
    }

    .hotels-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #C69B45;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        margin-bottom: 12px;
    }

    .hotels-page-header h1 {
        color: #1F2421;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 48px;
        font-weight: 500;
        line-height: 1.1;
        margin: 0 0 14px;
    }

    .hotels-page-header p {
        color: #686C68;
        font-size: 15px;
        line-height: 1.8;
        max-width: 620px;
        margin: 0;
    }


    /* ADD HOTEL */

    .add-hotel-btn {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;

        background: #1F2421;
        color: #fff;

        padding: 14px 22px;

        text-decoration: none;
        font-size: 14px;
        font-weight: 600;

        transition: .25s ease;
    }

    .add-hotel-btn:hover {
        background: #C69B45;
        color: #fff;
    }


    /* GRID */

    .hotels-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }


    /* CARD */

    .hotel-card {
        background: #fff;
        overflow: hidden;
        border: 1px solid rgba(31, 36, 33, .08);
        box-shadow: 0 12px 35px rgba(31, 36, 33, .08);

        transition:
            transform .3s ease,
            box-shadow .3s ease;
    }

    .hotel-card:hover {
        transform: translateY(-7px);
        box-shadow: 0 20px 45px rgba(31, 36, 33, .14);
    }


    /* IMAGE */

    .hotel-card-image {
        height: 270px;
        position: relative;
        overflow: hidden;
        background: #dedbd4;
    }

    .hotel-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;

        transition: transform .5s ease;
    }

    .hotel-card:hover .hotel-card-image img {
        transform: scale(1.05);
    }

    .hotel-image-placeholder {
        width: 100%;
        height: 100%;

        display: flex;
        align-items: center;
        justify-content: center;

        color: #8d8d8d;
        font-size: 55px;
    }


    /* RATING */

    .hotel-rating {
        position: absolute;
        left: 18px;
        bottom: 18px;

        display: flex;
        align-items: center;
        gap: 6px;

        background: rgba(31, 36, 33, .88);
        color: #fff;

        padding: 8px 12px;
        font-size: 13px;
        font-weight: 700;

        backdrop-filter: blur(5px);
    }

    .hotel-rating i {
        color: #C69B45;
    }


    /* ADMIN ICONS */

    .hotel-admin-actions {
        position: absolute;
        top: 16px;
        right: 16px;

        display: flex;
        gap: 8px;
    }

    .hotel-admin-btn {
        width: 38px;
        height: 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: rgba(255, 255, 255, .94);
        color: #1F2421;

        text-decoration: none;

        border-radius: 50%;

        box-shadow: 0 5px 15px rgba(0, 0, 0, .15);

        transition: .2s ease;
    }

    .hotel-admin-btn:hover {
        background: #C69B45;
        color: #fff;
    }

    .hotel-admin-btn.delete:hover {
        background: #9f3434;
        color: #fff;
    }


    /* CONTENT */

    .hotel-card-content {
        padding: 25px 25px 22px;
    }

    .hotel-location {
        display: flex;
        align-items: center;
        gap: 6px;

        color: #C69B45;

        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;

        margin-bottom: 10px;
    }

    .hotel-card-content h2 {
        color: #1F2421;

        font-family: Georgia, "Times New Roman", serif;

        font-size: 25px;
        font-weight: 500;
        line-height: 1.25;

        margin: 0 0 12px;
    }

    .hotel-chain {
        display: flex;
        align-items: center;
        gap: 7px;

        color: #777;
        font-size: 13px;

        margin-bottom: 15px;
    }

    .hotel-chain i {
        color: #C69B45;
    }

    .hotel-description {
        color: #686C68;

        font-size: 14px;
        line-height: 1.7;

        margin: 0;

        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;

        min-height: 48px;
    }


    /* FOOTER */

    .hotel-card-footer {
        border-top: 1px solid #ece9e2;

        margin-top: 22px;
        padding-top: 18px;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .hotel-stars {
        display: flex;
        gap: 3px;
    }

    .hotel-stars i {
        color: #C69B45;
        font-size: 12px;
    }

    .view-hotel-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        color: #1F2421;

        text-decoration: none;
        font-size: 13px;
        font-weight: 700;

        transition: .2s ease;
    }

    .view-hotel-btn i {
        color: #C69B45;
        transition: transform .2s ease;
    }

    .view-hotel-btn:hover {
        color: #C69B45;
    }

    .view-hotel-btn:hover i {
        transform: translateX(4px);
    }


    /* EMPTY */

    .hotels-empty {
        background: #fff;

        padding: 70px 20px;

        text-align: center;

        border: 1px solid rgba(31, 36, 33, .08);
    }

    .hotels-empty > i {
        color: #C69B45;
        font-size: 55px;
    }

    .hotels-empty h3 {
        font-family: Georgia, "Times New Roman", serif;
        color: #1F2421;
        margin: 18px 0 8px;
    }

    .hotels-empty p {
        color: #777;
        margin: 0;
    }


    /* RESPONSIVE */

    @@media (max-width: 991px) {

        .hotels-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .hotels-page-header h1 {
            font-size: 40px;
        }
    }


    @@media (max-width: 767px) {

        .hotels-page {
            padding: 50px 0 70px;
        }

        .hotels-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .hotels-page-header h1 {
            font-size: 34px;
        }

        .hotels-grid {
            grid-template-columns: 1fr;
        }

        .hotel-card-image {
            height: 240px;
        }
    }

</style>


@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <style>
        .hotels-map-card { background: #fff; border-radius: 24px; padding: 22px; margin-bottom: 40px; box-shadow: 0 10px 30px rgba(31, 36, 33, .06); }
        .hotels-map-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; }
        .hotels-map-head h3 { font-family: Georgia, "Times New Roman", serif; margin: 0 0 4px; font-size: 22px; color: #1F2421; }
        .hotels-map-head h3 i { color: #52614e; }
        .hotels-map-head p { margin: 0; color: #6b7280; font-size: 14px; }
        .hotels-map-toggle { border: 1px solid #e3ddd2; background: #fcfbf8; border-radius: 999px; padding: 8px 16px; font-weight: 700; color: #1F2421; }
        .hotels-map { height: 430px; border-radius: 18px; overflow: hidden; z-index: 0; }
        .hotels-map.collapsed { display: none; }

        .map-pin { background: #1F2421; color: #fff; border-radius: 999px; padding: 4px 10px; font-size: 12px; font-weight: 700; white-space: nowrap; border: 2px solid #fff; box-shadow: 0 4px 12px rgba(0,0,0,.25); display: inline-flex; gap: 4px; align-items: center; }
        .map-pin i { color: #f5c451; }
        .map-popup { width: 220px; }
        .map-popup img { width: 100%; height: 110px; object-fit: cover; border-radius: 10px; margin-bottom: 8px; }
        .map-popup strong { display: block; font-size: 14px; color: #1F2421; }
        .map-popup span { color: #6b7280; font-size: 12px; }
        .map-popup a { display: inline-block; margin-top: 8px; color: #52614e; font-weight: 700; text-decoration: none; }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script>
        (function () {
            const el = document.getElementById('hotelsMap');
            if (!el || typeof L === 'undefined') return;

            const hotels = @Html.Raw(mapHotelsJson);
            const map = L.map(el, { scrollWheelZoom: false });

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

            const markers = hotels.map(h => {
                const icon = L.divIcon({
                    className: '',
                    html: `<span class="map-pin"><i class="bi bi-star-fill"></i>${h.stars} ${esc(h.city)}</span>`,
                    iconSize: null
                });

                const img = h.image ? `<img src="${esc(h.image)}" alt="">` : '';

                return L.marker([h.lat, h.lng], { icon })
                    .bindPopup(`<div class="map-popup">${img}<strong>${esc(h.name)}</strong><span>${esc(h.city)}, ${esc(h.country)}</span><br><a href="${h.url}">View hotel &rarr;</a></div>`)
                    .addTo(map);
            });

            map.fitBounds(L.featureGroup(markers).getBounds().pad(0.2));

            // Gizlət / göstər
            const btn = document.getElementById('mapToggle');
            btn.addEventListener('click', () => {
                const hidden = el.classList.toggle('collapsed');
                btn.querySelector('span').textContent = hidden ? 'Show map' : 'Hide map';
                btn.querySelector('i').className = hidden ? 'bi bi-eye' : 'bi bi-eye-slash';
                if (!hidden) map.invalidateSize();
            });
        })();
    </script>
}

@model HotelTravel.Application.DTOs.Reviews.CreateReviewDto

@{
    ViewData["Title"] = "Write a Review";

    var eligibility =
        ViewBag.Eligibility as HotelTravel.Application.DTOs.Reviews.ReviewEligibilityDto;
}

<style>
    .review-page {
        padding: 50px 0 70px;
        background: #F8F5F0;
    }

    .review-card {
        background: #FFFFFF;
        border: 1px solid #E8E0D5;
        border-radius: 16px;
        padding: 36px;
    }

    .review-title {
        font-family: Georgia, serif;
        font-size: 30px;
        margin-bottom: 6px;
    }

    .review-stay {
        background: #F8F5F0;
        border-radius: 12px;
        padding: 16px 20px;
        margin: 22px 0 28px;
        color: #55514A;
    }

    /* STAR PICKER: radio-lar tərsinə düzülür ki,
       hover/checked soldakı ulduzları da rəngləsin */
    .star-picker {
        display: inline-flex;
        flex-direction: row-reverse;
        gap: 6px;
    }

        .star-picker input {
            display: none;
        }

        .star-picker label {
            font-size: 38px;
            color: #D9D2C5;
            cursor: pointer;
            transition: color .15s;
            line-height: 1;
        }

            .star-picker input:checked ~ label,
            .star-picker label:hover,
            .star-picker label:hover ~ label {
                color: #C69B45;
            }

    .review-btn {
        background: #C69B45;
        color: #FFFFFF;
        border: none;
        border-radius: 30px;
        padding: 12px 28px;
        font-weight: 600;
    }

        .review-btn:hover {
            background: #B0873A;
            color: #FFFFFF;
        }
</style>

<section class="review-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">

                <div class="review-card">

                    <h1 class="review-title">
                        <i class="bi bi-chat-heart me-2" style="color:#C69B45"></i>
                        @T["How was your stay?"]
                    </h1>

                    <p class="text-muted mb-0">
                        @T["Your feedback helps other guests choose the right room."]
                    </p>

                    @if (eligibility != null)
                    {
                        <div class="review-stay">
                            <div>
                                <strong>@T["Room {0}", eligibility.RoomNumber]</strong>
                                &mdash; @eligibility.RoomName
                            </div>
                            <div class="small mt-1">
                                @eligibility.CheckInDate.ToString("dd.MM.yyyy")
                                &rarr;
                                @eligibility.CheckOutDate.ToString("dd.MM.yyyy")
                                <span class="mx-2">•</span>
                                @T["Booking"] @eligibility.ConfirmationCode
                            </div>
                        </div>
                    }

                    <form asp-controller="Reviews"
                          asp-action="Create"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <input type="hidden" asp-for="ConfirmationCode" />

                        <!-- RATING -->
                        <div class="mb-4">
                            <label class="form-label d-block fw-semibold">
                                @T["Your rating"]
                            </label>

                            <div class="star-picker">
                                @for (int star = 5; star >= 1; star--)
                                {
                                    <input type="radio"
                                           id="star@(star)"
                                           name="Rating"
                                           value="@star"
                                           @(Model.Rating == star ? "checked" : "") />

                                    <label for="star@(star)"
                                           title="@T.Plural(star, "star", "stars")">
                                        <i class="bi bi-star-fill"></i>
                                    </label>
                                }
                            </div>

                            <span asp-validation-for="Rating"
                                  class="text-danger d-block small"></span>
                        </div>

                        <!-- COMMENT -->
                        <div class="mb-4">
                            <label asp-for="Comment"
                                   class="form-label fw-semibold">
                                @T["Your review"]
                            </label>

                            <textarea asp-for="Comment"
                                      class="form-control"
                                      rows="5"
                                      maxlength="1000"
                                      placeholder="@T["Tell us about the room, cleanliness, comfort, service..."]"></textarea>

                            <span asp-validation-for="Comment"
                                  class="text-danger small"></span>
                        </div>

                        <!-- EMAIL -->
                        <div class="mb-4">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                @T["Booking email"]
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="@T["The email used for this reservation"]" />

                            <div class="form-text">
                                @T["We use it only to confirm that this booking is yours."]
                                @T["It will not be shown publicly."]
                            </div>

                            <span asp-validation-for="Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="review-btn">
                                <i class="bi bi-send me-1"></i>
                                @T["Submit Review"]
                            </button>

                            <a asp-controller="Bookings"
                               asp-action="Find"
                               asp-route-confirmationCode="@Model.ConfirmationCode"
                               class="btn btn-outline-secondary rounded-pill px-4">
                                @T["Cancel"]
                            </a>
                        </div>
                    </form>

                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

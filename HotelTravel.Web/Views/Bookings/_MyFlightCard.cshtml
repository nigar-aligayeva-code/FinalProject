@model HotelTravel.Application.DTOs.Flights.FlightBookingDto
@using HotelTravel.Domain.Enums
@{
    var flight = Model;

    // Ləğv qiyməti: pulsuz və ya cərimə ilə (CancellationPolicy)
    var cancelQuote = HotelTravel.Application.Services.CancellationPolicy.ForFlight(
        flight.Status, flight.DepartureTime, flight.TotalPrice, DateTime.Now);

    var cancelText = cancelQuote.IsFree
        ? T["Cancel this flight? Cancellation is free."].Value
        : T["Cancel this flight? A cancellation fee of {0} AZN ({1}%) will be charged.", cancelQuote.Fee.ToString("0.00"), cancelQuote.FeePercent].Value;
}

<div class="my-booking-card">
    <div class="my-booking-image hh-car-media hh-flight-media">
        <i class="fa-solid fa-plane-up"></i>
    </div>

    <div class="my-booking-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <div class="my-booking-room">@flight.FromCity → @flight.ToCity</div>
                <div class="my-booking-meta">
                    @flight.Airline · @flight.FlightNumber · @T.Enum(flight.Cabin)
                    <span class="mx-1">•</span>
                    <strong>@flight.ConfirmationCode</strong>
                </div>
                @if (flight.Status == FlightBookingStatus.Cancelled && flight.CancellationFee > 0)
                {
                    <div class="small text-danger mt-1">
                        <i class="bi bi-receipt"></i>
                        @T["Cancellation fee: {0} AZN", flight.CancellationFee.ToString("0.00")]
                    </div>
                }
            </div>

            <span class="my-booking-status @(flight.Status == FlightBookingStatus.Cancelled ? "status-cancelled" : flight.Status == FlightBookingStatus.Completed ? "status-checkedout" : "status-confirmed")">
                @T.Enum(flight.Status)
            </span>
        </div>

        <div class="row mt-3 my-booking-meta">
            <div class="col-sm-8 mb-2">
                <i class="bi bi-calendar-event me-1"></i>
                @flight.DepartureTime.ToString("dd MMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)
                <span class="mx-1">•</span>
                <i class="bi bi-clock me-1"></i>
                @flight.DepartureTime.ToString("HH:mm") @flight.FromCode
                &rarr;
                @flight.ArrivalTime.ToString("HH:mm") @flight.ToCode
                <span class="mx-1">•</span>
                <i class="bi bi-people me-1"></i>
                @flight.Passengers
            </div>
            <div class="col-sm-4 mb-2 text-sm-end">
                <strong class="text-dark fs-5">@flight.TotalPrice.ToString("0.00") AZN</strong>
            </div>
        </div>

        <div class="my-booking-actions d-flex flex-wrap gap-2 mt-2">
            <a asp-controller="Flights"
               asp-action="Confirmation"
               asp-route-confirmationCode="@flight.ConfirmationCode"
               class="btn btn-sm btn-outline-secondary">
                @T["Details"]
            </a>

            <a asp-controller="Flights"
               asp-action="CalendarFile"
               asp-route-confirmationCode="@flight.ConfirmationCode"
               class="btn btn-sm btn-outline-primary"
               title="Add to calendar (.ics)">
                <i class="bi bi-calendar-plus me-1"></i>
                @T["Calendar"]
            </a>

            @if (flight.CanCancel)
            {
                <form asp-controller="Flights"
                      asp-action="CancelMine"
                      asp-route-id="@flight.Id"
                      method="post"
                      class="d-inline"
                      onsubmit='return confirm(@Json.Serialize(cancelText));'>
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-x-circle me-1"></i>
                        @T["Cancel"]
                    </button>
                </form>
            }
        </div>
    </div>
</div>

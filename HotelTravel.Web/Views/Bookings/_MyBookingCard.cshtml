@model HotelTravel.Application.DTOs.Bookings.GetBookingDto
@using HotelTravel.Domain.Enums

@{
    var nights = (Model.CheckOutDate.Date - Model.CheckInDate.Date).Days;

    var statusClass = Model.Status switch
    {
        BookingStatus.Pending => "status-pending",
        BookingStatus.Confirmed => "status-confirmed",
        BookingStatus.CheckedIn => "status-checkedin",
        BookingStatus.CheckedOut => "status-checkedout",
        BookingStatus.Cancelled => "status-cancelled",
        _ => "status-checkedout"
    };

    // Confirmed / Pending və giriş günü hələ gəlməyibsə
    var canChange =
        HotelTravel.Application.Services.BookingRules.CanGuestChange(
            Model.Status,
            Model.CheckInDate,
            DateTime.Today) == null;

    var guestsText =
        Model.AdultCount + (Model.AdultCount == 1 ? " adult" : " adults");

    if (Model.ChildrenCount > 0)
    {
        guestsText += ", " + Model.ChildrenCount +
            (Model.ChildrenCount == 1 ? " child" : " children");
    }

    var canReview =
        Model.Status == BookingStatus.CheckedOut && !Model.HasReview;

    // Ləğv qiyməti: pulsuz və ya cərimə ilə (CancellationPolicy)
    var cancelQuote = HotelTravel.Application.Services.CancellationPolicy.ForHotel(
        Model.Status, Model.CheckInDate, Model.TotalPrice, DateTime.Now);

    var cancelText = cancelQuote.IsFree
        ? T["Cancel this booking? Cancellation is free."].Value
        : T["Cancel this booking? A cancellation fee of {0} AZN ({1}%) will be charged.", cancelQuote.Fee.ToString("0.00"), cancelQuote.FeePercent].Value;
}

<div class="my-booking-card">

    <div class="my-booking-image">
        @if (!string.IsNullOrWhiteSpace(Model.RoomImage))
        {
            <img src="@Model.RoomImage" alt="@Model.RoomName" />
        }
    </div>

    <div class="my-booking-body">

        <div class="d-flex justify-content-between align-items-start gap-2">
            <div>
                <div class="my-booking-room">@Model.RoomName</div>
                <div class="my-booking-meta">
                    @T["Room {0}", Model.RoomNumber]
                    <span class="mx-1">•</span>
                    <strong>@Model.ConfirmationCode</strong>
                </div>
                <partial name="_CancellationInfo" model="Model" />
            </div>

            <div class="d-flex flex-column align-items-end gap-1">
                <span class="my-booking-status @statusClass">
                    @T.Enum(Model.Status)
                </span>
                @if (Model.PaymentStatus == HotelTravel.Domain.Enums.PaymentStatus.Paid)
                {
                    <small class="text-success fw-semibold"><i class="bi bi-credit-card"></i> @T["Paid online"]</small>
                }
                else if (Model.PaymentStatus == HotelTravel.Domain.Enums.PaymentStatus.Refunded)
                {
                    <small class="text-muted fw-semibold"><i class="bi bi-arrow-counterclockwise"></i> @T["Refunded"]</small>
                }
                else if (Model.Status == BookingStatus.Pending)
                {
                    <small class="text-muted"><i class="bi bi-hourglass-split"></i> @T["Hotel confirms within {0}h", HotelTravel.Application.Services.BookingRules.HotelAnswerHours]</small>
                }
            </div>
        </div>

        <div class="row mt-3 my-booking-meta">
            <div class="col-sm-4 mb-2">
                <i class="bi bi-calendar-event me-1"></i>
                @Model.CheckInDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)
                &rarr;
                @Model.CheckOutDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)
            </div>
            <div class="col-sm-4 mb-2">
                <i class="bi bi-moon me-1"></i>
                @T.Plural(nights, "night", "nights")
                <span class="mx-1">•</span>
                <i class="bi bi-people me-1"></i>
                @guestsText
            </div>
            <div class="col-sm-4 mb-2 text-sm-end">
                @if (Model.DiscountAmount > 0)
                {
                    <div class="small text-decoration-line-through">
                        @Model.OriginalPrice.ToString("0.00") AZN
                    </div>
                }

                <strong class="text-dark fs-5">
                    @Model.TotalPrice.ToString("0.00") AZN
                </strong>

                @if (Model.DiscountAmount > 0)
                {
                    <div class="small text-success">
                        -@Model.DiscountPercent% discount
                    </div>
                }
            </div>
        </div>

        <div class="my-booking-actions d-flex flex-wrap gap-2 mt-2">

            <a asp-controller="Rooms"
               asp-action="Details"
               asp-route-id="@Model.RoomId"
               class="btn btn-sm btn-outline-secondary">
                @T["View Room"]
            </a>

            @if (ViewBag.PaymentsEnabled is true &&
                 Model.Status == BookingStatus.Confirmed &&
                 Model.PaymentStatus == HotelTravel.Domain.Enums.PaymentStatus.Unpaid)
            {
                <form asp-controller="Payments" asp-action="Pay" method="post" class="m-0">
                    <input type="hidden" name="confirmationCode" value="@Model.ConfirmationCode" />
                    <button type="submit" class="btn btn-sm btn-success">
                        <i class="bi bi-credit-card me-1"></i>
                        @T["Pay now"]
                    </button>
                </form>
            }

            @if (Model.Status != BookingStatus.Cancelled &&
                 Model.Status != BookingStatus.Pending)
            {
                <a asp-controller="Bookings"
                   asp-action="Voucher"
                   asp-route-confirmationCode="@Model.ConfirmationCode"
                   target="_blank"
                   class="btn btn-sm btn-outline-success">
                    <i class="bi bi-qr-code me-1"></i>
                    @T["Voucher"]
                </a>

                <a asp-controller="Bookings"
                   asp-action="CalendarFile"
                   asp-route-confirmationCode="@Model.ConfirmationCode"
                   class="btn btn-sm btn-outline-primary"
                   title="Add to calendar (.ics)">
                    <i class="bi bi-calendar-plus me-1"></i>
                    @T["Calendar"]
                </a>

                <a asp-controller="Bookings"
                   asp-action="VoucherPdf"
                   asp-route-confirmationCode="@Model.ConfirmationCode"
                   class="btn btn-sm btn-outline-dark">
                    <i class="bi bi-file-earmark-pdf me-1"></i>
                    @T["PDF"]
                </a>
            }

            @if (canChange && Model.HotelId > 0)
            {
                <a asp-controller="Taxis"
                   asp-action="Index"
                   asp-route-hotelId="@Model.HotelId"
                   asp-route-date="@Model.CheckInDate.ToString("yyyy-MM-dd")"
                   class="btn btn-sm btn-outline-dark">
                    <i class="fa-solid fa-taxi me-1"></i>
                    @T["Airport taxi"]
                </a>
            }

            @if (canChange)
            {
                <a asp-controller="Bookings"
                   asp-action="Modify"
                   asp-route-confirmationCode="@Model.ConfirmationCode"
                   class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i>
                    @T["Modify"]
                </a>

                <form asp-controller="Bookings"
                      asp-action="CancelMine"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline"
                      onsubmit='return confirm(@Json.Serialize(cancelText));'>
                    <button type="submit" class="btn btn-sm btn-outline-danger"
                            title="@(cancelQuote.IsFree ? T["Free cancellation"].Value : T["Cancellation fee: {0} AZN", cancelQuote.Fee.ToString("0.00")].Value)">
                        <i class="bi bi-x-circle me-1"></i>
                        @T["Cancel"]
                        @if (!cancelQuote.IsFree)
                        {
                            <small>(−@cancelQuote.FeePercent%)</small>
                        }
                    </button>
                </form>
            }

            @if (canReview)
            {
                <a asp-controller="Reviews"
                   asp-action="Create"
                   asp-route-confirmationCode="@Model.ConfirmationCode"
                   class="btn btn-sm btn-warning">
                    <i class="bi bi-star-fill me-1"></i>
                    @T["Write a Review"]
                </a>
            }
            else if (Model.HasReview)
            {
                <span class="small text-muted align-self-center">
                    <i class="bi bi-check2-circle me-1"></i>
                    @T["Reviewed"]
                </span>
            }
        </div>

    </div>
</div>

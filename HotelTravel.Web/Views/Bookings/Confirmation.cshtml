@model HotelTravel.Application.DTOs.Bookings.GetBookingDto

@{
    ViewData["Title"] = "Booking Confirmation";

    // Otel hələ təsdiqləməyib: sorğu gözləmədədir
    var isPending = Model.Status == HotelTravel.Domain.Enums.BookingStatus.Pending;
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow border-0">

                <div class="card-body p-5">

                    <div class="text-center mb-4">

                        @if (isPending)
                        {
                            <h2 class="text-warning-emphasis">
                                <i class="bi bi-hourglass-split"></i>
                                @T["Request sent to the hotel"]
                            </h2>

                            <p class="text-muted">
                                @T["The hotel checks its real availability and answers within {0} hours. We will email you as soon as it is confirmed.", HotelTravel.Application.Services.BookingRules.HotelAnswerHours]
                            </p>
                        }
                        else
                        {
                            <h2 class="text-success">
                                @T["Booking Confirmed"]
                            </h2>

                            <p class="text-muted">
                                @T["Your reservation has been created successfully."]
                            </p>
                        }

                    </div>

                    @* Stripe-dan qayıdandan sonra nəticə *@
                    @if (TempData["PaymentSuccess"] is string paidMessage)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2">
                            <i class="bi bi-credit-card-2-front fs-4"></i> @paidMessage
                        </div>
                    }
                    @if (TempData["PaymentError"] is string payError)
                    {
                        <div class="alert alert-warning d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle fs-4"></i> @payError
                        </div>
                    }

                    <div class="alert @(isPending ? "alert-warning" : "alert-success") text-center">

                        <strong>@T["Confirmation Code"]</strong>

                        <h3 class="mt-2 mb-0">
                            @Model.ConfirmationCode
                        </h3>

                    </div>

                    @if (TempData["VoucherEmailSuccess"] is string emailOk)
                    {
                        <div class="alert alert-info"><i class="bi bi-envelope-check me-1"></i> @emailOk</div>
                    }
                    else if (TempData["VoucherEmailError"] is string emailErr)
                    {
                        <div class="alert alert-danger"><i class="bi bi-envelope-x me-1"></i> @emailErr</div>
                    }
                    else if (isPending)
                    {
                        <p class="text-center text-muted mb-0">
                            <i class="bi bi-envelope me-1"></i>
                            @T["We have emailed your request details to {0}.", Model.GuestEmail]
                        </p>
                    }
                    else
                    {
                        <p class="text-center text-muted mb-0">
                            <i class="bi bi-envelope me-1"></i>
                            @T["A confirmation email with your PDF voucher has been sent to {0}.", Model.GuestEmail]
                        </p>
                    }

                    <hr />

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <strong>@T["Guest"]</strong>
                            <p>
                                @Model.GuestName
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>@T["Email"]</strong>
                            <p>
                                @Model.GuestEmail
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>@T["Room"]</strong>
                            <p>
                                @Model.RoomNumber -
                                @Model.RoomName
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>@T["Status"]</strong>
                            <p>
                                <span class="badge @(isPending ? "bg-warning text-dark" : Model.Status == HotelTravel.Domain.Enums.BookingStatus.Cancelled ? "bg-danger" : "bg-success")">
                                    @T.Enum(Model.Status)
                                </span>
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>@T["Payment"]</strong>
                            <p>
                                @if (Model.PaymentStatus == HotelTravel.Domain.Enums.PaymentStatus.Paid)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> @T["Paid online"]</span>
                                    @if (Model.PaidAt is DateTime paidAt)
                                    {
                                        <small class="text-muted d-block">@paidAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm", System.Globalization.CultureInfo.CurrentUICulture)</small>
                                    }
                                }
                                else if (Model.PaymentStatus == HotelTravel.Domain.Enums.PaymentStatus.Refunded)
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-arrow-counterclockwise"></i> @T["Refunded"]</span>
                                }
                                else if (isPending)
                                {
                                    <span class="badge bg-light text-dark border">@T["After hotel confirmation"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@T["Pay at the hotel"]</span>
                                }
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>@T["Check-in"]</strong>
                            <p>
                                @Model.CheckInDate.ToString("dd MMMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>@T["Check-out"]</strong>
                            <p>
                                @Model.CheckOutDate.ToString("dd MMMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>@T["Guests"]</strong>
                            <p>
                                @T["Adults:"] @Model.AdultCount
                                <br />
                                @T["Children:"] @Model.ChildrenCount
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>@T["Total Price"]</strong>

                            @if (Model.DiscountAmount > 0)
                            {
                                <div class="text-muted text-decoration-line-through small">
                                    @Model.OriginalPrice.ToString("0.00") AZN
                                </div>
                            }

                            <h4 class="text-dark">
                                @Model.TotalPrice.ToString("0.00") AZN
                            </h4>

                            @if (Model.DiscountAmount > 0)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-tag"></i>
                                    @Model.DiscountNote
                                </span>
                            }
                        </div>

                    </div>

                    @if (ViewBag.Weather is HotelTravel.Application.DTOs.Weather.TripWeatherDto weather)
                    {
                        ViewData["WeatherTitle"] = T["Weather during your stay in {0}", weather.Location].Value;
                        <partial name="_WeatherWidget" model="weather" />
                    }

                    <hr />

                    <div class="alert alert-warning">
                        @T["Please save your confirmation code."]
                        @T["You can use it later to find your booking."]
                    </div>

                    @if (Model.Status == HotelTravel.Domain.Enums.BookingStatus.Cancelled)
                    {
                        <partial name="_CancellationInfo" model="Model" />
                    }
                    else
                    {
                        <div class="border rounded-3 p-3 mb-3">
                            <strong class="d-block mb-1"><i class="bi bi-shield-check"></i> @T["Cancellation policy"]</strong>
                            <partial name="_CancellationPolicy" />
                        </div>
                    }

                    @* Hələ ödənilməyibsə: Stripe ilə indi ödə *@
                    @if (ViewBag.PaymentsEnabled is true &&
                         Model.PaymentStatus == HotelTravel.Domain.Enums.PaymentStatus.Unpaid &&
                         Model.Status == HotelTravel.Domain.Enums.BookingStatus.Confirmed)
                    {
                        <form asp-controller="Payments" asp-action="Pay" method="post" class="text-center mt-4">
                            <input type="hidden" name="confirmationCode" value="@Model.ConfirmationCode" />
                            <button type="submit" class="btn btn-success btn-lg px-4">
                                <i class="bi bi-credit-card"></i>
                                @T["Pay now"] · @Model.TotalPrice.ToString("0.00") AZN
                            </button>
                            <div class="small text-muted mt-2">
                                <i class="bi bi-shield-lock"></i> @T["Secure payment by Stripe (test mode)."]
                                @T["Test card: 4242 4242 4242 4242"]
                            </div>
                        </form>
                    }

                    @if (isPending)
                    {
                        <div class="alert alert-light border text-center mt-4">
                            <i class="bi bi-info-circle"></i>
                            @T["Hotels also sell rooms on other channels, so every request is checked by the hotel first."]
                            @T["You will be able to pay and download the voucher after confirmation."]
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
                        @if (!isPending)
                        {
                        <a asp-controller="Bookings"
                           asp-action="VoucherPdf"
                           asp-route-confirmationCode="@Model.ConfirmationCode"
                           class="btn btn-dark">
                            <i class="bi bi-file-earmark-pdf"></i>
                            @T["Download PDF voucher"]
                        </a>
                        }

                        @{
                            var calEvent = HotelTravel.Application.Services.CalendarRules.ForHotel(
                                Model.ConfirmationCode, Model.HotelName ?? "Hotel", Model.HotelAddress, Model.HotelCity,
                                Model.CheckInDate, Model.CheckOutDate, Model.RoomName);
                        }
                        <a asp-controller="Bookings"
                           asp-action="CalendarFile"
                           asp-route-confirmationCode="@Model.ConfirmationCode"
                           class="btn btn-outline-primary">
                            <i class="bi bi-calendar-plus"></i>
                            @T["Add to calendar"]
                        </a>
                        <a href="@(HotelTravel.Application.Services.CalendarRules.GoogleUrl(calEvent))"
                           target="_blank" rel="noopener"
                           class="btn btn-outline-primary">
                            <i class="bi bi-google"></i>
                            @T["Google Calendar"]
                        </a>

                        <form asp-controller="Bookings"
                              asp-action="SendVoucherEmail"
                              method="post"
                              class="m-0">
                            <input type="hidden" name="confirmationCode" value="@Model.ConfirmationCode" />
                            <button type="submit" class="btn btn-outline-dark">
                                <i class="bi bi-envelope"></i>
                                @T["Email me a copy"]
                            </button>
                        </form>
                    </div>

                    <div class="d-flex justify-content-between mt-4">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            @T["Back to Home"]
                        </a>

                        <a asp-controller="Bookings"
                           asp-action="Voucher"
                           asp-route-confirmationCode="@Model.ConfirmationCode"
                           target="_blank"
                           class="btn btn-success">
                            <i class="bi bi-qr-code"></i>
                            @T["Voucher / Print"]
                        </a>

                        <a asp-controller="Bookings"
                           asp-action="Find"
                           class="btn btn-primary">
                            @T["Find My Booking"]
                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>

@model HotelTravel.Application.DTOs.Bookings.GetBookingDto

@{
    ViewData["Title"] = "Booking Confirmation";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow border-0">

                <div class="card-body p-5">

                    <div class="text-center mb-4">

                        <h2 class="text-success">
                            Booking Confirmed
                        </h2>

                        <p class="text-muted">
                            Your reservation has been created successfully.
                        </p>

                    </div>

                    <div class="alert alert-success text-center">

                        <strong>Confirmation Code</strong>

                        <h3 class="mt-2 mb-0">
                            @Model.ConfirmationCode
                        </h3>

                    </div>

                    @if (TempData["VoucherEmailSuccess"] is string emailOk)
                    {
                        <div class="alert alert-info"><i class="bi bi-envelope-check me-1"></i> @emailOk</div>
                    }
                    else if (TempData["VoucherEmailError"] is string emailErr)
                    {
                        <div class="alert alert-danger"><i class="bi bi-envelope-x me-1"></i> @emailErr</div>
                    }
                    else
                    {
                        <p class="text-center text-muted mb-0">
                            <i class="bi bi-envelope me-1"></i>
                            A confirmation email with your PDF voucher has been sent to <strong>@Model.GuestEmail</strong>.
                        </p>
                    }

                    <hr />

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <strong>Guest</strong>
                            <p>
                                @Model.GuestName
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Email</strong>
                            <p>
                                @Model.GuestEmail
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Room</strong>
                            <p>
                                @Model.RoomNumber -
                                @Model.RoomName
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Status</strong>
                            <p>
                                <span class="badge bg-success">
                                    @Model.Status
                                </span>
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Check-in</strong>
                            <p>
                                @Model.CheckInDate.ToString("dd MMMM yyyy")
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Check-out</strong>
                            <p>
                                @Model.CheckOutDate.ToString("dd MMMM yyyy")
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Guests</strong>
                            <p>
                                Adults: @Model.AdultCount
                                <br />
                                Children: @Model.ChildrenCount
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Total Price</strong>

                            @if (Model.DiscountAmount > 0)
                            {
                                <div class="text-muted text-decoration-line-through small">
                                    @Model.OriginalPrice.ToString("0.00") AZN
                                </div>
                            }

                            <h4 class="text-dark">
                                @Model.TotalPrice.ToString("0.00") AZN
                            </h4>

                            @if (Model.DiscountAmount > 0)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-tag"></i>
                                    @Model.DiscountNote
                                </span>
                            }
                        </div>

                    </div>

                    @if (ViewBag.Weather is HotelTravel.Application.DTOs.Weather.TripWeatherDto weather)
                    {
                        ViewData["WeatherTitle"] = $"Weather during your stay in {weather.Location}";
                        <partial name="_WeatherWidget" model="weather" />
                    }

                    <hr />

                    <div class="alert alert-warning">
                        Please save your confirmation code.
                        You can use it later to find your booking.
                    </div>

                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
                        <a asp-controller="Bookings"
                           asp-action="VoucherPdf"
                           asp-route-confirmationCode="@Model.ConfirmationCode"
                           class="btn btn-dark">
                            <i class="bi bi-file-earmark-pdf"></i>
                            Download PDF voucher
                        </a>

                        <form asp-controller="Bookings"
                              asp-action="SendVoucherEmail"
                              method="post"
                              class="m-0">
                            <input type="hidden" name="confirmationCode" value="@Model.ConfirmationCode" />
                            <button type="submit" class="btn btn-outline-dark">
                                <i class="bi bi-envelope"></i>
                                Email me a copy
                            </button>
                        </form>
                    </div>

                    <div class="d-flex justify-content-between mt-4">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Back to Home
                        </a>

                        <a asp-controller="Bookings"
                           asp-action="Voucher"
                           asp-route-confirmationCode="@Model.ConfirmationCode"
                           target="_blank"
                           class="btn btn-success">
                            <i class="bi bi-qr-code"></i>
                            Voucher / Print
                        </a>

                        <a asp-controller="Bookings"
                           asp-action="Find"
                           class="btn btn-primary">
                            Find My Booking
                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>
@model HotelTravel.Application.DTOs.Bookings.GetBookingDto

@{
    ViewData["Title"] = "Booking Details";
}

<div class="container mt-5 mb-5">

    <h2 class="mb-4">@T["Booking Details"]</h2>

    <div class="card">
        <div class="card-body">

            <h4 class="card-title mb-4">
                @T["Confirmation code"]: @Model.ConfirmationCode
            </h4>

            <hr />

            <h5>@T["Guest Information"]</h5>

            <p>
                <strong>@T["Name:"]</strong>
                @Model.GuestName
            </p>

            <p>
                <strong>@T["Email:"]</strong>
                @Model.GuestEmail
            </p>

            <hr />

            <h5>@T["Room Information"]</h5>

            <p>
                <strong>@T["Room:"]</strong>
                @Model.RoomNumber - @Model.RoomName
            </p>

            <hr />

            <h5>@T["Booking Information"]</h5>

            <p>
                <strong>@T["Check-in:"]</strong>
                @Model.CheckInDate.ToString("dd.MM.yyyy")
            </p>

            <p>
                <strong>@T["Check-out:"]</strong>
                @Model.CheckOutDate.ToString("dd.MM.yyyy")
            </p>

            <p>
                <strong>@T["Adults:"]</strong>
                @Model.AdultCount
            </p>

            <p>
                <strong>@T["Children:"]</strong>
                @Model.ChildrenCount
            </p>

            <p>
                <strong>@T["Total Price:"]</strong>
                @Model.TotalPrice.ToString("0.00") AZN
            </p>

            <p>
                <strong>@T["Status:"]</strong>
                @T.Enum(Model.Status)
            </p>

            <hr />

            <a asp-action="Index"
               class="btn btn-secondary">
                @T["Back to Bookings"]
            </a>

        </div>
    </div>

</div>
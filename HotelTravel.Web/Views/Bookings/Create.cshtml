@model HotelTravel.Application.DTOs.Bookings.CreateBookingDto

@{
    ViewData["Title"] = "Complete your booking";

    var room = ViewBag.Room as HotelTravel.Application.DTOs.Rooms.GetRoomDto;

    var nights = Math.Max(1, (Model.CheckOutDate.Date - Model.CheckInDate.Date).Days);
    var baseTotal = room == null ? 0 : room.PricePerNight * nights;

    var guestsText = Model.AdultCount + (Model.AdultCount == 1 ? " adult" : " adults");
    if (Model.ChildrenCount > 0)
    {
        guestsText += ", " + Model.ChildrenCount + (Model.ChildrenCount == 1 ? " child" : " children");
    }
}

<section class="hh-hero hh-hero-small">
    <div class="container">
        <h1>@T["Complete your booking"]</h1>
        <p>@T["Just one step left. Enter your details to confirm the stay."]</p>
    </div>
</section>

<div class="container">
    <form asp-controller="Bookings"
          asp-action="Create"
          method="post"
          class="hh-checkout"
          id="bookingForm">

        <!-- Bunlar görünmür, amma backend-ə göndərilir -->
        <input asp-for="RoomId" type="hidden" />
        <input asp-for="CheckInDate" type="hidden" value="@Model.CheckInDate.ToString("yyyy-MM-dd")" />
        <input asp-for="CheckOutDate" type="hidden" value="@Model.CheckOutDate.ToString("yyyy-MM-dd")" />
        <input asp-for="AdultCount" type="hidden" />
        <input asp-for="ChildrenCount" type="hidden" />

        <!-- ============================= -->
        <!-- LEFT: GUEST DETAILS -->
        <!-- ============================= -->
        <div class="hh-checkout-main">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="hh-panel">
                <h2 class="hh-panel-title">@T["Enter your details"]</h2>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label">@T["First name"]</label>
                        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">@T["Last name"]</label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">@T["Email"]</label>
                        <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
                        <div class="form-text">@T["Your confirmation code will be linked to this email."]</div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">@T["Phone"]</label>
                        <input asp-for="Phone" class="form-control" autocomplete="tel" placeholder="+994 ..." />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- PROMO CODE -->
            <div class="hh-panel">
                <h2 class="hh-panel-title">
                    <i class="bi bi-tag me-1"></i>
                    @T["Have a promo code?"]
                </h2>

                <div class="hh-promo">
                    <input asp-for="PromoCode"
                           class="form-control"
                           placeholder="@T["Enter code"]"
                           style="text-transform:uppercase" />
                    <button type="button" class="hh-btn hh-btn-outline" id="applyPromo">
                        @T["Apply"]
                    </button>
                </div>

                <div class="hh-promo-msg" id="promoMessage"></div>

                <div class="hh-loyalty d-none" id="loyaltyBox">
                    <i class="bi bi-stars"></i>
                    <span id="loyaltyText"></span>
                </div>
            </div>

            <div class="hh-panel hh-perks">
                <div><i class="bi bi-check-circle-fill"></i> @T["Free cancellation up to {0} days before check-in.", HotelTravel.Application.Services.CancellationPolicy.FreeHours / 24]</div>
                <div><i class="bi bi-check-circle-fill"></i> @T["Request code right away"]</div>
                <div><i class="bi bi-check-circle-fill"></i> @T["Change dates or guests any time before check-in"]</div>
                <details class="mt-2">
                    <summary class="small fw-semibold">@T["Cancellation policy"]</summary>
                    <partial name="_CancellationPolicy" />
                </details>
            </div>

            <!-- OTEL TƏSDİQİ: biz otelin real boş yerlərini bilmirik, ona görə sorğu göndəririk -->
            <div class="hh-panel hh-request-note">
                <i class="bi bi-hourglass-split"></i>
                <div>
                    <strong>@T["Request to book"]</strong>
                    <small>@T["The hotel confirms within {0} hours. Nothing is charged until then.", HotelTravel.Application.Services.BookingRules.HotelAnswerHours]</small>
                    @if (ViewBag.PaymentsEnabled is true)
                    {
                        <small>@T["After confirmation you can pay online by card or at the hotel."]</small>
                    }
                </div>
            </div>

            <button type="submit" class="hh-search-btn hh-confirm-btn">
                @T["Send booking request"]
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>


        <!-- ============================= -->
        <!-- RIGHT: SUMMARY -->
        <!-- ============================= -->
        <aside class="hh-checkout-side">
            <div class="hh-panel hh-summary-card">

                @if (room != null)
                {
                    @if (!string.IsNullOrWhiteSpace(room.MainImage))
                    {
                        <img src="@room.MainImage" alt="@room.Name" class="hh-summary-img" />
                    }

                    <h3>@room.Name</h3>
                    <div class="hh-room-meta">
                        <i class="bi bi-geo-alt"></i>
                        @room.HotelName · @room.City
                    </div>
                }

                <div class="hh-summary-dates">
                    <div>
                        <small>@T["Check-in"]</small>
                        <strong>@Model.CheckInDate.ToString("ddd, MMM d, yyyy", System.Globalization.CultureInfo.CurrentUICulture)</strong>
                    </div>
                    <div>
                        <small>@T["Check-out"]</small>
                        <strong>@Model.CheckOutDate.ToString("ddd, MMM d, yyyy", System.Globalization.CultureInfo.CurrentUICulture)</strong>
                    </div>
                </div>

                <div class="hh-summary-line">
                    <span>@T["Length of stay"]</span>
                    <strong>@T.Plural(nights, "night", "nights")</strong>
                </div>
                <div class="hh-summary-line">
                    <span>@T["Guests"]</span>
                    <strong>@guestsText</strong>
                </div>

                <hr />

                <h4 class="hh-summary-sub">@T["Price summary"]</h4>

                <div class="hh-summary-line">
                    <span>
                        @(room?.PricePerNight.ToString("0.00") ?? "0.00") AZN × @T.Plural(nights, "night", "nights")
                    </span>
                    <span id="sumBase">@baseTotal.ToString("0.00") AZN</span>
                </div>

                <div class="hh-summary-line hh-discount-line d-none" id="sumDiscountRow">
                    <span id="sumDiscountNote">@T["Discount"]</span>
                    <span id="sumDiscount"></span>
                </div>

                <div class="hh-summary-total">
                    <span>@T["Total"]</span>
                    <strong id="sumTotal">@baseTotal.ToString("0.00") AZN</strong>
                </div>

                <small class="text-muted d-block mt-1">
                    @T["Final price is calculated and confirmed when you book."]
                </small>
            </div>
        </aside>
    </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const previewUrl = "@Url.Action("PricePreview", "Bookings")";

            const form = document.getElementById("bookingForm");
            const emailInput = document.getElementById("Email");
            const promoInput = document.getElementById("PromoCode");
            const promoMessage = document.getElementById("promoMessage");
            const loyaltyBox = document.getElementById("loyaltyBox");
            const loyaltyText = document.getElementById("loyaltyText");

            const money = (value) => Number(value).toFixed(2) + " AZN";

            async function refreshPrice(showPromoResult) {
                const params = new URLSearchParams({
                    roomId: form.querySelector('[name="RoomId"]').value,
                    checkInDate: form.querySelector('[name="CheckInDate"]').value,
                    checkOutDate: form.querySelector('[name="CheckOutDate"]').value,
                    email: emailInput.value || "",
                    promoCode: promoInput.value || ""
                });

                try {
                    const response = await fetch(previewUrl + "?" + params.toString());
                    if (!response.ok) return;

                    const q = await response.json();
                    if (!q.success) return;

                    document.getElementById("sumBase").textContent = money(q.baseTotal);
                    document.getElementById("sumTotal").textContent = money(q.total);

                    const discountRow = document.getElementById("sumDiscountRow");

                    if (q.discountAmount > 0) {
                        document.getElementById("sumDiscountNote").textContent = q.discountNote;
                        document.getElementById("sumDiscount").textContent = "−" + money(q.discountAmount);
                        discountRow.classList.remove("d-none");
                    } else {
                        discountRow.classList.add("d-none");
                    }

                    // Explorer reward
                    if (q.loyaltyEligible) {
                        loyaltyText.textContent =
                            "Explorer reward: you stayed with us in " + q.loyaltyCity +
                            ", so you get 10% off this trip.";
                        loyaltyBox.classList.remove("d-none");
                    } else {
                        loyaltyBox.classList.add("d-none");
                    }

                    // Promo nəticəsi
                    if (showPromoResult) {
                        promoMessage.className = "hh-promo-msg";

                        if (!promoInput.value.trim()) {
                            promoMessage.textContent = "";
                        } else if (q.promoError) {
                            promoMessage.classList.add("error");
                            promoMessage.textContent = q.promoError;
                        } else if (q.appliedPromoCode) {
                            promoMessage.classList.add("success");
                            promoMessage.textContent =
                                "Code " + q.appliedPromoCode + " applied: " + q.discountPercent + "% off.";
                        } else {
                            promoMessage.classList.add("info");
                            promoMessage.textContent =
                                "Your Explorer reward is bigger, so we kept that discount.";
                        }
                    }
                } catch (e) {
                    // Önizləmə alınmasa da forma işləyir, qiymət serverdə hesablanır
                }
            }

            document.getElementById("applyPromo").addEventListener("click", () => refreshPrice(true));

            promoInput.addEventListener("keydown", (e) => {
                if (e.key === "Enter") {
                    e.preventDefault();
                    refreshPrice(true);
                }
            });

            emailInput.addEventListener("change", () => refreshPrice(false));

            // Daxil olmuş istifadəçinin emaili artıq doludur
            refreshPrice(!!promoInput.value);
        })();
    </script>
}

<style>
    /* Ödəniş üsulu seçimi */
    .hh-request-note { display: flex; gap: 12px; align-items: flex-start; background: #FFF7E6; border: 1px solid #f3dfb0; }
    .hh-request-note > i { font-size: 22px; color: #92600a; }
    .hh-request-note div { display: flex; flex-direction: column; gap: 2px; }
    .hh-request-note small { color: #6b7280; }
</style>

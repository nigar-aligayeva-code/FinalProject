@model HotelTravel.Application.DTOs.Bookings.CreateBookingDto

@{
    ViewData["Title"] = "Create Booking";
}

<div class="container mt-5 mb-5">

    <h2 class="mb-4">Complete Your Booking</h2>

    <form asp-controller="Bookings"
          asp-action="Create"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <!-- Seçilmiş booking məlumatları -->
        <div class="card mb-4">

            <div class="card-header">
                <h4 class="mb-0">
                    Your Reservation
                </h4>
            </div>

            <div class="card-body">

                <p>
                    <strong>Check-in:</strong>
                    @Model.CheckInDate.ToString("dd.MM.yyyy")
                </p>

                <p>
                    <strong>Check-out:</strong>
                    @Model.CheckOutDate.ToString("dd.MM.yyyy")
                </p>

                <p>
                    <strong>Adults:</strong>
                    @Model.AdultCount
                </p>

                <p>
                    <strong>Children:</strong>
                    @Model.ChildrenCount
                </p>

            </div>

        </div>

        <!-- Bunlar görünmür, amma backend-ə göndərilir -->

        <input asp-for="RoomId"
               type="hidden" />

        <input asp-for="CheckInDate"
               type="hidden" />

        <input asp-for="CheckOutDate"
               type="hidden" />

        <input asp-for="AdultCount"
               type="hidden" />

        <input asp-for="ChildrenCount"
               type="hidden" />


        <h4 class="mb-3">
            Guest Information
        </h4>

        <div class="mb-3">

            <label asp-for="FirstName"
                   class="form-label">
                First Name
            </label>

            <input asp-for="FirstName"
                   class="form-control" />

            <span asp-validation-for="FirstName"
                  class="text-danger">
            </span>

        </div>


        <div class="mb-3">

            <label asp-for="LastName"
                   class="form-label">
                Last Name
            </label>

            <input asp-for="LastName"
                   class="form-control" />

            <span asp-validation-for="LastName"
                  class="text-danger">
            </span>

        </div>


        <div class="mb-3">

            <label asp-for="Email"
                   class="form-label">
                Email
            </label>

            <input asp-for="Email"
                   type="email"
                   class="form-control" />

            <span asp-validation-for="Email"
                  class="text-danger">
            </span>

        </div>


        <div class="mb-3">

            <label asp-for="Phone"
                   class="form-label">
                Phone
            </label>

            <input asp-for="Phone"
                   class="form-control" />

            <span asp-validation-for="Phone"
                  class="text-danger">
            </span>

        </div>


        <button type="submit"
                class="btn btn-success">
            Confirm Booking
        </button>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
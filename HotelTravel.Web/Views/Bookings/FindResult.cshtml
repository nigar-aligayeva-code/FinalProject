@model HotelTravel.Application.DTOs.Bookings.GetBookingDto

@{
    ViewData["Title"] = "My Booking";
}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h3 class="mb-0">
                        Booking Details
                    </h3>
                </div>

                <div class="card-body">

                    <div class="alert alert-success">
                        Booking found successfully.
                    </div>

                    <table class="table table-bordered">

                        <tbody>

                            <tr>
                                <th>Confirmation Code</th>
                                <td>
                                    <strong>
                                        @Model.ConfirmationCode
                                    </strong>
                                </td>
                            </tr>

                            <tr>
                                <th>Guest</th>
                                <td>@Model.GuestName</td>
                            </tr>

                            <tr>
                                <th>Room</th>
                                <td>
                                    @Model.RoomNumber - @Model.RoomName
                                </td>
                            </tr>

                            <tr>
                                <th>Check-in</th>
                                <td>
                                    @Model.CheckInDate.ToString("dd.MM.yyyy")
                                </td>
                            </tr>

                            <tr>
                                <th>Check-out</th>
                                <td>
                                    @Model.CheckOutDate.ToString("dd.MM.yyyy")
                                </td>
                            </tr>

                            <tr>
                                <th>Adults</th>
                                <td>@Model.AdultCount</td>
                            </tr>

                            <tr>
                                <th>Children</th>
                                <td>@Model.ChildrenCount</td>
                            </tr>

                            <tr>
                                <th>Total Price</th>
                                <td>
                                    <strong>
                                        @Model.TotalPrice.ToString("0.00") AZN
                                    </strong>
                                </td>
                            </tr>

                            <tr>
                                <th>Status</th>

                                <td>
                                    @if (Model.Status.ToString() == "Confirmed")
                                    {
                                        <span class="badge bg-success">
                                            Confirmed
                                        </span>
                                    }
                                    else if (Model.Status.ToString() == "CheckedIn")
                                    {
                                        <span class="badge bg-primary">
                                            Checked In
                                        </span>
                                    }
                                    else if (Model.Status.ToString() == "CheckedOut")
                                    {
                                        <span class="badge bg-secondary">
                                            Checked Out
                                        </span>
                                    }
                                    else if (Model.Status.ToString() == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                </td>
                            </tr>

                        </tbody>

                    </table>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-3">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-3">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    <div class="d-flex gap-2 mt-3">

                        <a asp-controller="Bookings"
                           asp-action="Find"
                           class="btn btn-outline-secondary">
                            Search Another Booking
                        </a>

                        @if (Model.Status ==
                             HotelTravel.Domain.Enums.BookingStatus.Confirmed)
                        {
                            <button type="button"
                                    class="btn btn-danger"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#cancelBookingForm">
                                Cancel Booking
                            </button>
                        }

                    </div>

                    @if (Model.Status ==
                         HotelTravel.Domain.Enums.BookingStatus.Confirmed)
                    {
                        <div class="collapse mt-3"
                             id="cancelBookingForm">

                            <div class="card card-body">

                                <h5>Cancel Booking</h5>

                                <p class="text-muted">
                                    Enter the email address used when making
                                    this reservation.
                                </p>

                                <form asp-controller="Bookings"
                                      asp-action="CancelByGuest"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to cancel this booking?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="confirmationCode"
                                           value="@Model.ConfirmationCode" />

                                    <div class="mb-3">

                                        <label class="form-label">
                                            Email
                                        </label>

                                        <input type="email"
                                               name="email"
                                               class="form-control"
                                               required />

                                    </div>

                                    <button type="submit"
                                            class="btn btn-danger">
                                        Confirm Cancellation
                                    </button>

                                </form>

                            </div>
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
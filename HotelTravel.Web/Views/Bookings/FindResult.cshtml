@model HotelTravel.Application.DTOs.Bookings.GetBookingDto

@{
    ViewData["Title"] = "My Booking";
}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h3 class="mb-0">
                        @T["Booking Details"]
                    </h3>
                </div>

                <div class="card-body">

                    <div class="alert alert-success">
                        @T["Booking found successfully."]
                    </div>

                    <table class="table table-bordered">

                        <tbody>

                            <tr>
                                <th>@T["Confirmation Code"]</th>
                                <td>
                                    <strong>
                                        @Model.ConfirmationCode
                                    </strong>
                                </td>
                            </tr>

                            <tr>
                                <th>@T["Guest"]</th>
                                <td>@Model.GuestName</td>
                            </tr>

                            <tr>
                                <th>@T["Room"]</th>
                                <td>
                                    @Model.RoomNumber - @Model.RoomName
                                </td>
                            </tr>

                            <tr>
                                <th>@T["Check-in"]</th>
                                <td>
                                    @Model.CheckInDate.ToString("dd.MM.yyyy")
                                </td>
                            </tr>

                            <tr>
                                <th>@T["Check-out"]</th>
                                <td>
                                    @Model.CheckOutDate.ToString("dd.MM.yyyy")
                                </td>
                            </tr>

                            <tr>
                                <th>@T["Adults"]</th>
                                <td>@Model.AdultCount</td>
                            </tr>

                            <tr>
                                <th>@T["Children"]</th>
                                <td>@Model.ChildrenCount</td>
                            </tr>

                            <tr>
                                <th>@T["Total Price"]</th>
                                <td>
                                    @if (Model.DiscountAmount > 0)
                                    {
                                        <span class="text-muted text-decoration-line-through me-2">
                                            @Model.OriginalPrice.ToString("0.00") AZN
                                        </span>
                                    }

                                    <strong>
                                        @Model.TotalPrice.ToString("0.00") AZN
                                    </strong>

                                    @if (Model.DiscountAmount > 0)
                                    {
                                        <div class="small text-success mt-1">
                                            <i class="bi bi-tag"></i>
                                            @Model.DiscountNote
                                        </div>
                                    }
                                </td>
                            </tr>

                            <tr>
                                <th>@T["Status"]</th>

                                <td>
                                    @if (Model.Status == HotelTravel.Domain.Enums.BookingStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-hourglass-split"></i>
                                            @T.Enum(Model.Status)
                                        </span>
                                        <div class="small text-muted mt-1">
                                            @T["The hotel confirms within {0} hours. Nothing is charged until then.", HotelTravel.Application.Services.BookingRules.HotelAnswerHours]
                                        </div>
                                    }
                                    else if (Model.Status.ToString() == "Confirmed")
                                    {
                                        <span class="badge bg-success">
                                            @T["Confirmed"]
                                        </span>
                                    }
                                    else if (Model.Status.ToString() == "CheckedIn")
                                    {
                                        <span class="badge bg-primary">
                                            @T["Checked In"]
                                        </span>
                                    }
                                    else if (Model.Status.ToString() == "CheckedOut")
                                    {
                                        <span class="badge bg-secondary">
                                            @T["Checked Out"]
                                        </span>
                                    }
                                    else if (Model.Status.ToString() == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            @T["Cancelled"]
                                        </span>
                                        <partial name="_CancellationInfo" model="Model" />
                                    }
                                </td>
                            </tr>

                        </tbody>

                    </table>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mt-3">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mt-3">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    <div class="d-flex gap-2 mt-3">

                        <a asp-controller="Bookings"
                           asp-action="Find"
                           class="btn btn-outline-secondary">
                            @T["Search Another Booking"]
                        </a>

                        @if (Model.Status == HotelTravel.Domain.Enums.BookingStatus.Confirmed ||
                             Model.Status == HotelTravel.Domain.Enums.BookingStatus.Pending)
                        {
                            <button type="button"
                                    class="btn btn-danger"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#cancelBookingForm">
                                @T["Cancel Booking"]
                            </button>
                        }

                        @* F4 - Rezervasiyanı dəyişmək *@
                        @if (HotelTravel.Application.Services.BookingRules.CanGuestChange(
                                 Model.Status,
                                 Model.CheckInDate,
                                 DateTime.Today) == null)
                        {
                            <a asp-controller="Bookings"
                               asp-action="Modify"
                               asp-route-confirmationCode="@Model.ConfirmationCode"
                               class="btn btn-primary">
                                <i class="bi bi-pencil me-1"></i>
                                @T["Modify Booking"]
                            </a>
                        }

                        @* F8 - Tamamlanmış qalış üçün rəy *@
                        @if (Model.Status ==
                             HotelTravel.Domain.Enums.BookingStatus.CheckedOut &&
                             !Model.HasReview)
                        {
                            <a asp-controller="Reviews"
                               asp-action="Create"
                               asp-route-confirmationCode="@Model.ConfirmationCode"
                               class="btn btn-warning">
                                <i class="bi bi-star-fill me-1"></i>
                                @T["Write a Review"]
                            </a>
                        }

                        <a asp-controller="Rooms"
                           asp-action="Details"
                           asp-route-id="@Model.RoomId"
                           class="btn btn-outline-primary">
                            @T["View Room"]
                        </a>

                        @* Otel təsdiqləyib, hələ ödənilməyib: onlayn ödə *@
                        @if (ViewBag.PaymentsEnabled is true &&
                             Model.Status == HotelTravel.Domain.Enums.BookingStatus.Confirmed &&
                             Model.PaymentStatus == HotelTravel.Domain.Enums.PaymentStatus.Unpaid)
                        {
                            <form asp-controller="Payments" asp-action="Pay" method="post" class="m-0">
                                <input type="hidden" name="confirmationCode" value="@Model.ConfirmationCode" />
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-credit-card"></i>
                                    @T["Pay now"] · @Model.TotalPrice.ToString("0.00") AZN
                                </button>
                            </form>
                        }

                        @if (Model.Status != HotelTravel.Domain.Enums.BookingStatus.Cancelled &&
                             Model.Status != HotelTravel.Domain.Enums.BookingStatus.Pending)
                        {
                            <a asp-controller="Bookings"
                               asp-action="Voucher"
                               asp-route-confirmationCode="@Model.ConfirmationCode"
                               target="_blank"
                               class="btn btn-success">
                                <i class="bi bi-qr-code"></i>
                                @T["Voucher"]
                            </a>

                            <a asp-controller="Bookings"
                               asp-action="VoucherPdf"
                               asp-route-confirmationCode="@Model.ConfirmationCode"
                               class="btn btn-dark">
                                <i class="bi bi-file-earmark-pdf"></i>
                                @T["PDF"]
                            </a>
                        }

                    </div>

                    @if (Model.Status ==
                         HotelTravel.Domain.Enums.BookingStatus.CheckedOut &&
                         Model.HasReview)
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            <i class="bi bi-check2-circle me-1"></i>
                            @T["Thank you! You have already reviewed this stay."]
                        </div>
                    }

                    @if (Model.Status == HotelTravel.Domain.Enums.BookingStatus.Confirmed ||
                         Model.Status == HotelTravel.Domain.Enums.BookingStatus.Pending)
                    {
                        <div class="collapse mt-3"
                             id="cancelBookingForm">

                            <div class="card card-body">

                                <h5>@T["Cancel Booking"]</h5>

                                @{
                                    var cancelQuote = HotelTravel.Application.Services.CancellationPolicy.ForHotel(
                                        Model.Status, Model.CheckInDate, Model.TotalPrice, DateTime.Now);
                                }

                                @if (!cancelQuote.Allowed)
                                {
                                    <div class="alert alert-secondary">@T[cancelQuote.Error ?? "This booking can no longer be cancelled."]</div>
                                }
                                else if (cancelQuote.IsFree)
                                {
                                    <div class="alert alert-success py-2"><i class="bi bi-check-circle"></i> @T["Cancellation is free."]</div>
                                }
                                else
                                {
                                    <div class="alert alert-warning py-2">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        @T["A cancellation fee of {0} AZN ({1}%) will be charged.", cancelQuote.Fee.ToString("0.00"), cancelQuote.FeePercent]
                                        @if (Model.PaymentStatus == HotelTravel.Domain.Enums.PaymentStatus.Paid)
                                        {
                                            <div>@T["{0} AZN will be refunded to your card.", HotelTravel.Application.Services.PaymentRules.RefundFor(Model.TotalPrice, cancelQuote.Fee).ToString("0.00")]</div>
                                        }
                                    </div>
                                }

                                <partial name="_CancellationPolicy" />

                                <p class="text-muted mt-3">
                                    @T["Enter the email address used when making this reservation."]
                                </p>

                                <form asp-controller="Bookings"
                                      asp-action="CancelByGuest"
                                      method="post"
                                      onsubmit='return confirm(@Json.Serialize(T["Are you sure you want to cancel this booking?"].Value));'>

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="confirmationCode"
                                           value="@Model.ConfirmationCode" />

                                    <div class="mb-3">

                                        <label class="form-label">
                                            @T["Email"]
                                        </label>

                                        <input type="email"
                                               name="email"
                                               class="form-control"
                                               required />

                                    </div>

                                    <button type="submit"
                                            class="btn btn-danger">
                                        @T["Confirm Cancellation"]
                                    </button>

                                </form>

                            </div>
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@model List<HotelTravel.Application.DTOs.Bookings.GetBookingDto>

@{
    ViewData["Title"] = "Bookings";
}

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Bookings</h2>

        <a asp-action="Create"
           class="btn btn-primary">
            New Booking
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No bookings have been created yet.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Confirmation</th>
                    <th>Guest</th>
                    <th>Room</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var booking in Model)
                {
                    <tr>
                        <td>
                            @booking.ConfirmationCode
                        </td>

                        <td>
                            @booking.GuestName
                        </td>

                        <td>
                            @booking.RoomNumber -
                            @booking.RoomName
                        </td>

                        <td>
                            @booking.CheckInDate.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @booking.CheckOutDate.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @booking.TotalPrice.ToString("0.00") AZN
                        </td>
                        <td>

                            <form asp-action="UpdateStatus"
                                  method="post"
                                  class="d-flex gap-2">

                                <input type="hidden"
                                       name="id"
                                       value="@booking.Id" />

                                <select name="status"
                                        class="form-select form-select-sm">

                                    @foreach (var status in
                                        Enum.GetValues<HotelTravel.Domain.Enums.BookingStatus>())
                                    {
                                        if (status == booking.Status)
                                        {
                                            <option value="@status" selected>
                                                @status
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@status">
                                                @status
                                            </option>
                                        }
                                    }

                                </select>

                                <button type="submit"
                                        class="btn btn-warning btn-sm">
                                    Update
                                </button>

                            </form>

                        </td>
                        <td>
                            <a asp-action="Details"
                               asp-route-id="@booking.Id"
                               class="btn btn-info btn-sm">
                                Details
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>
    }

</div>
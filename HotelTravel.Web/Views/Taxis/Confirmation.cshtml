@model HotelTravel.Application.DTOs.Taxis.TaxiBookingDto
@using HotelTravel.Application.Services
@using HotelTravel.Domain.Enums

@{
    ViewData["Title"] = "Airport taxi booked";

    var vehicle = TaxiRules.GetVehicle(Model.VehicleType);
}

<section class="hh-hero hh-hero-small">
    <div class="container">
        <h1><i class="bi bi-check-circle me-2"></i>@T["Your taxi is booked"]</h1>
        <p>@T["We have saved your transfer. Show the code below to your driver."]</p>
    </div>
</section>

<div class="container">
    <div class="hh-soon text-start">
        <div class="row g-4 align-items-center">
            <div class="col-md-7">
                <span class="hh-search-label">@T["Confirmation code"]</span>
                <div class="hh-car-code">@Model.ConfirmationCode</div>

                <h2 class="h4 mt-3 mb-1">@vehicle.Name taxi <small class="text-muted fs-6">@vehicle.Example</small></h2>
                <div class="text-muted">
                    @T.Plural(Model.Passengers, "passenger", "passengers")
                    · @T.Plural(Model.Luggage, "bag", "bags")
                    · @Model.DistanceKm km
                </div>

                <div class="hh-summary-dates mt-3">
                    <div>
                        <small>@T["From"]</small>
                        <strong>@Model.FromText</strong>
                    </div>
                    <div>
                        <small>@T["To"]</small>
                        <strong>@Model.ToText</strong>
                    </div>
                </div>

                <div class="hh-summary-line">
                    <span>@T["Pick-up"]</span>
                    <strong>@Model.PickupTime.ToString("ddd, MMM d, yyyy · HH:mm", System.Globalization.CultureInfo.CurrentUICulture)</strong>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.FlightNumber))
                {
                    <div class="hh-summary-line">
                        <span>@T["Flight"]</span>
                        <strong>@Model.FlightNumber</strong>
                    </div>
                }

                <div class="hh-summary-line">
                    <span>@T["Lead passenger"]</span>
                    <strong>@Model.PassengerName</strong>
                </div>
                <div class="hh-summary-line">
                    <span>@T["Status"]</span>
                    <strong>@T.Enum(Model.Status)</strong>
                </div>
            </div>

            <div class="col-md-5">
                <div class="hh-summary-total">
                    <span>@T["Fixed price"]</span>
                    <strong>@Model.Price.ToString("0.00") AZN</strong>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Bookings"
                           asp-action="MyBookings"
                           class="hh-btn hh-btn-primary">
                            @T["My Bookings"]
                        </a>
                    }

                    <a asp-controller="Taxis"
                       asp-action="Index"
                       asp-route-hotelId="@Model.HotelId"
                       asp-route-direction="@(Model.Direction == TaxiDirection.FromAirport ? TaxiDirection.ToAirport : TaxiDirection.FromAirport)"
                       class="hh-btn hh-btn-outline">
                        @T["Book return trip"]
                    </a>
                </div>

                <p class="small text-muted mt-3 mb-0">
                    @if (Model.Direction == TaxiDirection.FromAirport)
                    {
                        <text>@T["Your driver will wait in the arrivals hall with a sign showing your name."]</text>
                    }
                    else
                    {
                        <text>@T["Your driver will meet you at the hotel reception."]</text>
                    }
                    @T["Signed-in guests can cancel for free up to {0} hours before pick-up from My Bookings.", TaxiRules.FreeCancelHours]
                </p>
            </div>
        </div>
    </div>
</div>

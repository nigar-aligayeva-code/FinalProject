@model HotelTravel.Domain.Enums.TaxiVehicleType
@using HotelTravel.Domain.Enums
@using Microsoft.AspNetCore.Mvc.ViewFeatures

@{
    // Taksi sinfi -> maşın illüstrasiyası
    var category = Model switch
    {
        TaxiVehicleType.Minivan => CarCategory.Van,
        TaxiVehicleType.Executive => CarCategory.Premium,
        _ => CarCategory.Sedan
    };

    var data = new ViewDataDictionary(ViewData)
    {
        ["TaxiSign"] = Model == TaxiVehicleType.Standard
    };
}

@await Html.PartialAsync("~/Views/Cars/_CarIcon.cshtml", category, data)

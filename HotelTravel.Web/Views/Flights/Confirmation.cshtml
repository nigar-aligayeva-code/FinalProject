@model HotelTravel.Application.DTOs.Flights.FlightBookingDto
@using HotelTravel.Application.Services

@{
    ViewData["Title"] = "Flight booked";

    var stayNights = 3;
}

<section class="hh-hero hh-hero-small">
    <div class="container">
        <h1><i class="bi bi-check-circle me-2"></i>@T["Your flight is booked"]</h1>
        <p>@T["We have saved your ticket. Use the code below at check-in."]</p>
    </div>
</section>

<div class="container">
    <div class="hh-soon text-start">
        <div class="row g-4">
            <div class="col-lg-7">
                <span class="hh-search-label">@T["Booking reference"]</span>
                <div class="hh-car-code">@Model.ConfirmationCode</div>

                <div class="hh-flight-airline mt-3">
                    <partial name="_AirlineBadge" model="Model.Airline" />
                    <div>
                        <strong>@Model.Airline</strong>
                        <small>@Model.FlightNumber · @T.Enum(Model.Cabin)</small>
                    </div>
                </div>

                <div class="hh-flight-times hh-flight-times-sm mt-3">
                    <div class="hh-flight-point">
                        <strong>@Model.DepartureTime.ToString("HH:mm")</strong>
                        <span>@Model.FromCode · @Model.FromCity</span>
                    </div>

                    <div class="hh-flight-path">
                        <small>@Model.DepartureTime.ToString("ddd, MMM d", System.Globalization.CultureInfo.CurrentUICulture)</small>
                        <span class="hh-flight-line"><i class="fa-solid fa-plane"></i></span>
                        <small class="text-success">@T["Direct"]</small>
                    </div>

                    <div class="hh-flight-point">
                        <strong>@Model.ArrivalTime.ToString("HH:mm")</strong>
                        <span>@Model.ToCode · @Model.ToCity</span>
                    </div>
                </div>

                <div class="hh-summary-line">
                    <span>@T["Passengers"]</span>
                    <strong class="text-end">@string.Join(", ", Model.PassengerList)</strong>
                </div>
                <div class="hh-summary-line">
                    <span>@T["Contact"]</span>
                    <strong>@Model.ContactName</strong>
                </div>
                <div class="hh-summary-line">
                    <span>@T["Status"]</span>
                    <strong>@T.Enum(Model.Status)</strong>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="hh-summary-total">
                    <span>@T["Total"] (@T.Plural(Model.Passengers, "passenger", "passengers"))</span>
                    <strong>@Model.TotalPrice.ToString("0.00") AZN</strong>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Bookings"
                           asp-action="MyBookings"
                           class="hh-btn hh-btn-primary">
                            @T["My Bookings"]
                        </a>
                    }

                    <a asp-controller="Flights"
                       asp-action="Index"
                       asp-route-from="@Model.ToCity"
                       asp-route-to="@Model.FromCity"
                       asp-route-date="@Model.FlightDate.AddDays(stayNights).ToString("yyyy-MM-dd")"
                       asp-route-passengers="@Model.Passengers"
                       asp-route-cabin="@Model.Cabin"
                       class="hh-btn hh-btn-outline">
                        @T["Book return flight"]
                    </a>

                    <a asp-controller="Flights"
                       asp-action="CalendarFile"
                       asp-route-confirmationCode="@Model.ConfirmationCode"
                       class="hh-btn hh-btn-outline">
                        <i class="bi bi-calendar-plus"></i> Add to calendar
                    </a>

                    <a href="@(HotelTravel.Application.Services.CalendarRules.GoogleUrl(HotelTravel.Application.Services.CalendarRules.ForFlight(Model.ConfirmationCode, Model.Airline, Model.FlightNumber, Model.FromCity, Model.FromCode, Model.ToCity, Model.ToCode, Model.DepartureTime, Model.ArrivalTime)))"
                       target="_blank" rel="noopener"
                       class="hh-btn hh-btn-outline">
                        <i class="bi bi-google"></i> Google Calendar
                    </a>
                </div>

                <!-- Səfəri tamamla: otel + taksi -->
                <div class="hh-flight-next mt-4">
                    <strong>@T["Complete your trip to {0}", Model.ToCity]</strong>

                    <form asp-controller="Rooms"
                          asp-action="Search"
                          method="post"
                          class="m-0">
                        <input type="hidden" name="Destination" value="@Model.ToCity" />
                        <input type="hidden" name="CheckInDate" value="@Model.ArrivalTime.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="CheckOutDate" value="@Model.ArrivalTime.Date.AddDays(stayNights).ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="AdultCount" value="@Model.Passengers" />

                        <button type="submit">
                            <i class="fa-solid fa-bed"></i>
                            @T["Find a hotel in {0}", Model.ToCity]
                        </button>
                    </form>

                    <a asp-controller="Taxis"
                       asp-action="Index"
                       asp-route-city="@Model.ToCity"
                       asp-route-direction="FromAirport"
                       asp-route-date="@Model.ArrivalTime.ToString("yyyy-MM-dd")"
                       asp-route-time="@Model.ArrivalTime.AddMinutes(30).ToString("HH:mm")"
                       asp-route-passengers="@Math.Min(Model.Passengers, TaxiRules.MaxPassengers)">
                        <i class="fa-solid fa-taxi"></i>
                        @T["Airport taxi from {0}", Model.ToCode]
                    </a>
                </div>

                <p class="small text-muted mt-3 mb-0">
                    @T["Please arrive at the airport at least 2 hours before departure with a valid passport."]
                    @T["Signed-in guests can cancel for free up to {0} hours before departure from My Bookings.", FlightRules.FreeCancelHours]
                    @T["Later: {0}% fee, in the last {1} hours: {2}% fee.", HotelTravel.Application.Services.CancellationPolicy.LateFeePercent, HotelTravel.Application.Services.CancellationPolicy.LateHours, HotelTravel.Application.Services.CancellationPolicy.LastMinuteFeePercent]
                </p>
            </div>
        </div>
    </div>
</div>

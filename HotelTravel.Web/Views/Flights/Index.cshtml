@model List<HotelTravel.Application.DTOs.Flights.FlightOptionDto>
@using HotelTravel.Application.DTOs.Flights
@using HotelTravel.Application.Services
@using HotelTravel.Domain.Enums

@{
    ViewData["Title"] = "Flights";

    var cities = ViewBag.Cities as List<string> ?? new List<string>();
    string? from = ViewBag.From as string;
    string? to = ViewBag.To as string;
    var date = (DateTime)ViewBag.Date;
    var passengers = (int)ViewBag.Passengers;
    var cabin = (CabinClass)ViewBag.Cabin;
    string? error = ViewBag.Error as string;
    var dayFares = ViewBag.DayFares as List<FlightDayFareDto> ?? new List<FlightDayFareDto>();

    var cheapest = Model.Where(f => f.IsAvailable).Select(f => (decimal?)f.Fare).Min();
}

<section class="hh-hero hh-hero-small">
    <div class="container">
        <h1><i class="fa-solid fa-plane me-2"></i>@T["Flights"]</h1>
        <p>@T["Direct flights between our hotel cities. Add a hotel and an airport taxi in one trip."]</p>
    </div>
</section>

<div class="container">

    <!-- SEARCH -->
    <form asp-controller="Flights"
          asp-action="Index"
          method="get"
          class="hh-search hh-flight-search">

        <div class="hh-search-field">
            <i class="fa-solid fa-plane-departure"></i>
            <div class="hh-search-body">
                <label for="from">@T["From"]</label>
                <select id="from" name="from">
                    @foreach (var city in cities)
                    {
                        <option value="@city" selected="@(city == from)">@city (@FlightRules.AirportCode(city))</option>
                    }
                </select>
            </div>
        </div>

        <button type="button" class="hh-flight-swap" id="swapCities" title="@T["Swap cities"]" aria-label="@T["Swap cities"]">
            <i class="bi bi-arrow-left-right"></i>
        </button>

        <div class="hh-search-field">
            <i class="fa-solid fa-plane-arrival"></i>
            <div class="hh-search-body">
                <label for="to">@T["To"]</label>
                <select id="to" name="to">
                    @foreach (var city in cities)
                    {
                        <option value="@city" selected="@(city == to)">@city (@FlightRules.AirportCode(city))</option>
                    }
                </select>
            </div>
        </div>

        <div class="hh-search-field">
            <i class="bi bi-calendar3"></i>
            <div class="hh-search-body">
                <label for="date">@T["Departure"]</label>
                <input type="date"
                       id="date"
                       name="date"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       max="@DateTime.Today.AddDays(FlightRules.MaxDaysAhead).ToString("yyyy-MM-dd")"
                       value="@date.ToString("yyyy-MM-dd")" />
            </div>
        </div>

        <div class="hh-search-field">
            <i class="bi bi-people"></i>
            <div class="hh-search-body">
                <label for="passengers">@T["Passengers"]</label>
                <select id="passengers" name="passengers">
                    @for (var i = 1; i <= FlightRules.MaxPassengers; i++)
                    {
                        <option value="@i" selected="@(i == passengers)">@i</option>
                    }
                </select>
            </div>
        </div>

        <div class="hh-search-field">
            <i class="bi bi-star"></i>
            <div class="hh-search-body">
                <label for="cabin">@T["Cabin"]</label>
                <select id="cabin" name="cabin">
                    <option value="@CabinClass.Economy" selected="@(cabin == CabinClass.Economy)">@T["Economy"]</option>
                    <option value="@CabinClass.Business" selected="@(cabin == CabinClass.Business)">@T["Business"]</option>
                </select>
            </div>
        </div>

        <button type="submit" class="hh-search-btn">
            <i class="bi bi-search"></i>
            @T["Search"]
        </button>
    </form>

    @if (error != null)
    {
        <div class="alert alert-danger mt-3">@error</div>
    }

    @if (error == null && from != null && to != null)
    {
        <!-- DATE STRIP -->
        @if (dayFares.Any())
        {
            <nav class="hh-flight-days" aria-label="@T["Nearby dates"]">
                @foreach (var day in dayFares)
                {
                    <a asp-controller="Flights"
                       asp-action="Index"
                       asp-route-from="@from"
                       asp-route-to="@to"
                       asp-route-date="@day.Date.ToString("yyyy-MM-dd")"
                       asp-route-passengers="@passengers"
                       asp-route-cabin="@cabin"
                       class="hh-flight-day @(day.Date == date ? "active" : "")">
                        <span>@day.Date.ToString("ddd, MMM d", System.Globalization.CultureInfo.CurrentUICulture)</span>
                        <strong>@(day.LowestFare.HasValue ? day.LowestFare.Value.ToString("0") + " AZN" : "—")</strong>
                    </a>
                }
            </nav>
        }

        <!-- RESULTS -->
        <section class="hh-section">
            <div class="hh-section-head">
                <div>
                    <h2 class="hh-section-title">@from → @to</h2>
                    <p class="hh-section-sub">
                        @date.ToString("dddd, MMMM d", System.Globalization.CultureInfo.CurrentUICulture)
                        · @T.Plural(passengers, "passenger", "passengers")
                        · @T.Enum(cabin)
                    </p>
                </div>
            </div>

            @if (!Model.Any() && !string.IsNullOrWhiteSpace(from) && !string.IsNullOrWhiteSpace(to)
                 && HotelTravel.Application.Services.FlightNetworkPlanner.IsTooShortForFlight(from, to))
            {
                @* Bakı–Qəbələ kimi yaxın şəhərlər: reys yoxdur, maşın təklif edirik *@
                <div class="hh-empty">
                    <i class="bi bi-car-front fs-3 d-block mb-2"></i>
                    @T["{0} and {1} are only about {2} km apart, so there are no flights. It is easier to go by car.", from, to, HotelTravel.Application.Services.FlightNetworkPlanner.DistanceKm(from, to)!]
                    <div class="mt-2">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Cars" asp-action="Index" asp-route-city="@from"
                           asp-route-pickupDate="@date.ToString("yyyy-MM-dd")" asp-route-returnDate="@date.AddDays(3).ToString("yyyy-MM-dd")">
                            <i class="bi bi-key me-1"></i> @T["Rent a car in {0}", from]
                        </a>
                    </div>
                </div>
            }
            else if (!Model.Any())
            {
                <div class="hh-empty">
                    @T["No direct {0} flights on this route.", T.Enum(cabin).ToLower()]
                    @if (cabin == CabinClass.Business)
                    {
                        <a asp-controller="Flights"
                           asp-action="Index"
                           asp-route-from="@from"
                           asp-route-to="@to"
                           asp-route-date="@date.ToString("yyyy-MM-dd")"
                           asp-route-passengers="@passengers">@T["Try economy"]</a>
                    }
                </div>
            }
            else
            {
                <div class="hh-flight-list">
                    @foreach (var flight in Model)
                    {
                        <article class="hh-flight @(flight.IsAvailable ? "" : "unavailable")">
                            <div class="hh-flight-airline">
                                <partial name="_AirlineBadge" model="flight.Airline" />
                                <div>
                                    <strong>@flight.Airline</strong>
                                    <small>@flight.FlightNumber · @T.Enum(flight.Cabin)</small>
                                </div>
                            </div>

                            <div class="hh-flight-times">
                                <div class="hh-flight-point">
                                    <strong>@flight.Departure.ToString("HH:mm")</strong>
                                    <span>@flight.FromCode</span>
                                </div>

                                <div class="hh-flight-path">
                                    <small>@FlightRules.FormatDuration(flight.DurationMinutes)</small>
                                    <span class="hh-flight-line"><i class="fa-solid fa-plane"></i></span>
                                    <small class="text-success">@T["Direct"]</small>
                                </div>

                                <div class="hh-flight-point">
                                    <strong>
                                        @flight.Arrival.ToString("HH:mm")
                                        @if (flight.ArrivesNextDay)
                                        {
                                            <sup class="hh-flight-plus">+1</sup>
                                        }
                                    </strong>
                                    <span>@flight.ToCode</span>
                                </div>
                            </div>

                            <div class="hh-flight-buy">
                                @if (cheapest.HasValue && flight.IsAvailable && flight.Fare == cheapest.Value)
                                {
                                    <span class="hh-flight-tag">@T["Cheapest"]</span>
                                }

                                <div class="hh-room-price">
                                    <strong>@flight.Fare.ToString("0") AZN</strong>
                                    <small>
                                        @T["per passenger"]
                                        @if (passengers > 1)
                                        {
                                            <text>· @flight.Total.ToString("0") AZN total</text>
                                        }
                                    </small>
                                </div>

                                @if (flight.IsAvailable)
                                {
                                    @if (flight.SeatsLeft <= 9)
                                    {
                                        <small class="hh-flight-seats">@T["Only {0} left", T.Plural(flight.SeatsLeft, "seat", "seats")]</small>
                                    }

                                    <a asp-controller="Flights"
                                       asp-action="Book"
                                       asp-route-routeId="@flight.RouteId"
                                       asp-route-date="@date.ToString("yyyy-MM-dd")"
                                       asp-route-passengers="@passengers"
                                       asp-route-cabin="@cabin"
                                       class="hh-btn hh-btn-primary">
                                        @T["Select"]
                                    </a>
                                }
                                else
                                {
                                    <span class="hh-car-busy">
                                        @(flight.SeatsLeft < passengers ? T["Sold out"] : T["Closed"])
                                    </span>
                                }
                            </div>
                        </article>
                    }
                </div>
            }

            <p class="small text-muted mt-3 mb-0">
                <i class="bi bi-info-circle me-1"></i>
                @T["All times are local. Prices are per passenger, one way, including taxes."]
                @T["Booking early is cheaper: fares rise 14 and 3 days before departure."]
            </p>
        </section>
    }
</div>

@section Scripts {
    <script>
        // From / To yerini dəyiş
        (function () {
            const swap = document.getElementById("swapCities");
            const from = document.getElementById("from");
            const to = document.getElementById("to");

            if (!swap || !from || !to) return;

            swap.addEventListener("click", function () {
                const value = from.value;
                from.value = to.value;
                to.value = value;
            });
        })();
    </script>
}

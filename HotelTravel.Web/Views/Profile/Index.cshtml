@using HotelTravel.Application.Services
@model HotelTravel.Web.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";

    var u = Model.User;
    var s = Model.Summary;
    var initials = AvatarCatalog.GetInitials(u.FirstName, u.LastName, u.Email);
    var avatarUrl = AvatarCatalog.GetUrl(u.AvatarKey);
    var tripsForLevel = s.HotelBookings + s.FlightBookings;
    var toNext = ProfileRules.TripsToNextLevel(tripsForLevel, s.CitiesVisited);
    var isSecurity = Model.ActiveTab == "security";

    // Avatar seçimi: cari stil və dəri tonu (öz şəkli yüklənibsə stil yoxdur)
    var currentStyle = AvatarCatalog.StyleOf(u.AvatarKey);
    var currentTone = AvatarCatalog.ToneOf(u.AvatarKey);
    var hasPhoto = AvatarCatalog.IsUpload(u.AvatarKey);
}

<section class="pf-page">
    <div class="container">

        @if (TempData["ProfileSuccess"] is string ok)
        {
            <div class="pf-alert"><i class="bi bi-check-circle-fill"></i> @ok</div>
        }

        @if (TempData["ProfileError"] is string err)
        {
            <div class="pf-alert pf-alert-error"><i class="bi bi-exclamation-circle-fill"></i> @err</div>
        }

        <!-- HEADER -->
        <div class="pf-hero">
            <button type="button" class="pf-avatar" id="openAvatars" title="@T["Change avatar"]">
                @if (avatarUrl != null)
                {
                    <img src="@avatarUrl" alt="Avatar" />
                }
                else
                {
                    <span>@initials</span>
                }
                <i class="bi bi-pencil-fill pf-avatar-edit"></i>
            </button>

            <div class="pf-hero-text">
                <span class="pf-eyebrow"><i class="bi bi-person-badge"></i> @T["MY ACCOUNT"]</span>
                <h1>@u.FirstName @u.LastName</h1>
                <p>@u.Email @if (!string.IsNullOrWhiteSpace(u.PhoneNumber)) { <span>· @u.PhoneNumber</span> }</p>
            </div>

            <div class="pf-level">
                <span class="pf-level-badge"><i class="bi bi-award"></i> @T[s.Level ?? ""]</span>
                <small>
                    @(toNext > 0 ? T["{0} to the next level", T.Plural(toNext, "more trip", "more trips")].Value : T["Top traveler level reached"].Value)
                </small>
            </div>
        </div>

        <!-- AVATAR SEÇİMİ -->
        <details class="pf-card pf-avatars" id="avatarPicker">
            <summary>
                <span><i class="bi bi-person-bounding-box"></i> @T["Choose your avatar"]</span>
                <small>@T["Pick a picture or keep your initials"]</small>
            </summary>

            <!-- 1) ÖZ ŞƏKLİN -->
            <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data" class="pf-upload">
                <label class="pf-upload-drop">
                    <img id="photoPreview" src="@(hasPhoto ? avatarUrl : "")" alt="" @(hasPhoto ? "" : "hidden") />
                    <i class="bi bi-camera" id="photoIcon" @(hasPhoto ? "hidden" : "")></i>
                    <input type="file" name="photo" id="photoInput" accept="image/jpeg,image/png,image/webp" />
                </label>
                <div>
                    <strong>@T["Use your own photo"]</strong>
                    <small>@T["JPG, PNG or WEBP, up to 2 MB."]</small>
                    <button type="submit" class="pf-btn pf-btn-dark" id="photoSave" disabled>@T["Upload photo"]</button>
                </div>
            </form>

            <!-- 2) HAZIR AVATAR + DƏRİ TONU -->
            <form asp-action="Avatar" method="post">
                <div class="pf-tones" role="radiogroup" aria-label="@T["Skin tone"]">
                    <span>@T["Skin tone"]</span>
                    <button type="button" class="pf-tone pf-tone-default @(currentTone == 0 ? "active" : "")" data-tone="0" title="@T["Original"]"></button>
                    @foreach (var tone in AvatarCatalog.Tones)
                    {
                        <button type="button" class="pf-tone @(currentTone == tone.Number ? "active" : "")" data-tone="@tone.Number"
                                style="background:@tone.Color" title="@T[tone.Label]"></button>
                    }
                </div>

                <div class="pf-av-grid">
                    <label class="pf-av">
                        <input type="radio" name="avatarKey" value="" @(avatarUrl == null ? "checked" : "") />
                        <span class="pf-av-img pf-av-initials">@initials</span>
                        <small>@T["Initials"]</small>
                    </label>

                    @foreach (var option in AvatarCatalog.All)
                    {
                        var key = AvatarCatalog.WithTone(option.Key, currentTone);

                        <label class="pf-av" data-style="@option.Key">
                            <input type="radio" name="avatarKey" value="@key" @(currentStyle == option.Key ? "checked" : "") />
                            <img class="pf-av-img" src="@AvatarCatalog.GetUrl(key)" alt="@T[option.Label]" loading="lazy" />
                            <small>@T[option.Label]</small>
                        </label>
                    }
                </div>

                <button type="submit" class="pf-btn pf-btn-dark">@T["Save avatar"]</button>
            </form>
        </details>

        <!-- STATISTIKA -->
        <div class="pf-stats">
            <div class="pf-stat"><span>@T["Total trips"]</span><strong>@s.TotalTrips</strong></div>
            <div class="pf-stat"><span>@T["Upcoming"]</span><strong>@s.UpcomingTrips</strong></div>
            <div class="pf-stat"><span>@T["Nights booked"]</span><strong>@s.NightsBooked</strong></div>
            <div class="pf-stat"><span>@T["Cities"]</span><strong>@s.CitiesVisited</strong></div>
            <div class="pf-stat"><span>@T["Total spent"]</span><strong>@s.TotalSpent.ToString("N0") AZN</strong></div>
        </div>

        <div class="pf-grid">

            <!-- SOL: səfərlər -->
            <aside class="pf-side">

                <div class="pf-card">
                    <h3>@T["Next trip"]</h3>
                    @if (s.NextTripDate.HasValue)
                    {
                        <div class="pf-next">
                            <div class="pf-next-date">
                                <span>@s.NextTripDate.Value.ToString("MMM", System.Globalization.CultureInfo.CurrentUICulture)</span>
                                <strong>@s.NextTripDate.Value.Day</strong>
                            </div>
                            <div>
                                <strong>@s.NextTripTitle</strong>
                                <p>@s.NextTripDate.Value.ToString("dddd, dd MMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="pf-muted">@T["No upcoming trips yet."]</p>
                        <a asp-controller="Hotels" asp-action="Index" class="pf-link">Find a hotel <i class="bi bi-arrow-right"></i></a>
                    }
                </div>

                <div class="pf-card">
                    <h3>@T["My bookings"]</h3>
                    <ul class="pf-services">
                        <li><i class="bi bi-building"></i> Hotels <b>@s.HotelBookings</b></li>
                        <li><i class="bi bi-airplane"></i> Flights <b>@s.FlightBookings</b></li>
                        <li><i class="bi bi-car-front"></i> Car rentals <b>@s.CarRentals</b></li>
                        <li><i class="bi bi-signpost-split"></i> Airport taxis <b>@s.TaxiBookings</b></li>
                        <li><i class="bi bi-heart"></i> Saved rooms <b>@s.SavedRooms</b></li>
                    </ul>
                    <a asp-controller="Bookings" asp-action="MyBookings" class="pf-btn pf-btn-dark w-100">
                        @T["View all bookings"]
                    </a>
                </div>

            </aside>

            <!-- SAĞ: formlar -->
            <div class="pf-card pf-main">

                <div class="pf-tabs">
                    <button type="button" class="pf-tab @(isSecurity ? "" : "active")" data-tab="details">
                        <i class="bi bi-person"></i> Personal details
                    </button>
                    <button type="button" class="pf-tab @(isSecurity ? "active" : "")" data-tab="security">
                        <i class="bi bi-shield-lock"></i> Password
                    </button>
                </div>

                <!-- PROFİL -->
                <div class="pf-pane @(isSecurity ? "" : "active")" id="pane-details">
                    <form asp-action="Update" method="post" novalidate>
                        @if (!isSecurity)
                        {
                            <div asp-validation-summary="ModelOnly" class="pf-errors"></div>
                        }

                        <div class="pf-row">
                            <div class="pf-field">
                                <label asp-for="Profile.FirstName">@T["First name"]</label>
                                <input asp-for="Profile.FirstName" />
                                <span asp-validation-for="Profile.FirstName" class="pf-error"></span>
                            </div>
                            <div class="pf-field">
                                <label asp-for="Profile.LastName">@T["Last name"]</label>
                                <input asp-for="Profile.LastName" />
                                <span asp-validation-for="Profile.LastName" class="pf-error"></span>
                            </div>
                        </div>

                        <div class="pf-row">
                            <div class="pf-field">
                                <label>@T["Email"]</label>
                                <input value="@u.Email" disabled />
                                <small class="pf-muted">@T["Email is used to sign in and cannot be changed."]</small>
                            </div>
                            <div class="pf-field">
                                <label asp-for="Profile.PhoneNumber">@T["Phone"]</label>
                                <input asp-for="Profile.PhoneNumber" placeholder="+994 50 000 00 00" />
                                <span asp-validation-for="Profile.PhoneNumber" class="pf-error"></span>
                            </div>
                        </div>

                        <button type="submit" class="pf-btn pf-btn-dark">@T["Save changes"]</button>
                    </form>
                </div>

                <!-- ŞİFRƏ -->
                <div class="pf-pane @(isSecurity ? "active" : "")" id="pane-security">
                    <form asp-action="ChangePassword" method="post" novalidate>
                        @if (isSecurity)
                        {
                            <div asp-validation-summary="ModelOnly" class="pf-errors"></div>
                        }

                        <div class="pf-field">
                            <label asp-for="Password.CurrentPassword">@T["Current password"]</label>
                            <input asp-for="Password.CurrentPassword" autocomplete="current-password" />
                            <span asp-validation-for="Password.CurrentPassword" class="pf-error"></span>
                        </div>

                        <div class="pf-row">
                            <div class="pf-field">
                                <label asp-for="Password.NewPassword">@T["New password"]</label>
                                <input asp-for="Password.NewPassword" autocomplete="new-password" />
                                <span asp-validation-for="Password.NewPassword" class="pf-error"></span>
                            </div>
                            <div class="pf-field">
                                <label asp-for="Password.ConfirmPassword">@T["Confirm new password"]</label>
                                <input asp-for="Password.ConfirmPassword" autocomplete="new-password" />
                                <span asp-validation-for="Password.ConfirmPassword" class="pf-error"></span>
                            </div>
                        </div>

                        <p class="pf-muted">@T["At least 6 characters, with an uppercase letter, a lowercase letter and a digit."]</p>

                        <button type="submit" class="pf-btn pf-btn-dark">@T["Change password"]</button>
                    </form>
                </div>

            </div>
        </div>

    </div>
</section>

<style>
    .pf-page { background: #F3EEE5; min-height: 100vh; padding: 60px 0 90px; }
    .pf-alert { background: #e6efe3; color: #2f4a2b; border: 1px solid #c9dcc4; border-radius: 14px; padding: 14px 18px; margin-bottom: 22px; font-weight: 600; }

    .pf-hero { display: flex; align-items: center; gap: 24px; background: #1F2421; color: #fff; border-radius: 24px; padding: 30px 34px; margin-bottom: 22px; flex-wrap: wrap; }
    .pf-avatar { position: relative; width: 88px; height: 88px; border-radius: 50%; background: #52614e; color: #fff; display: grid; place-items: center; font-size: 30px; font-weight: 700; letter-spacing: 1px; border: 3px solid rgba(255,255,255,.25); flex-shrink: 0; padding: 0; cursor: pointer; }
    .pf-avatar img { width: 100%; height: 100%; border-radius: 50%; display: block; }
    .pf-avatar-edit { position: absolute; right: -2px; bottom: -2px; width: 28px; height: 28px; border-radius: 50%; background: #F3EEE5; color: #1F2421; font-size: 12px; display: grid; place-items: center; border: 2px solid #1F2421; }
    .pf-alert-error { background: #fdecea; color: #8a1f17; border-color: #f5c2bd; }

    .pf-avatars { margin-bottom: 22px; }
    .pf-avatars summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
    .pf-avatars summary::-webkit-details-marker { display: none; }
    .pf-avatars summary span { font-family: Georgia, "Times New Roman", serif; font-size: 20px; color: #1F2421; }
    .pf-avatars summary span i { color: #52614e; }
    .pf-avatars summary small { color: #6b7280; }
    .pf-avatars[open] summary { margin-bottom: 20px; }
    .pf-av-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 14px; margin-bottom: 20px; }
    .pf-av { display: flex; flex-direction: column; align-items: center; gap: 6px; cursor: pointer; }
    .pf-av input { position: absolute; opacity: 0; pointer-events: none; }
    .pf-av-img { width: 76px; height: 76px; border-radius: 50%; border: 3px solid transparent; transition: transform .15s, border-color .15s; }
    .pf-av:hover .pf-av-img { transform: translateY(-3px); }
    .pf-av input:checked ~ .pf-av-img { border-color: #1F2421; box-shadow: 0 0 0 3px #F3EEE5, 0 0 0 5px #52614e; }
    .pf-av input:focus-visible ~ .pf-av-img { outline: 2px solid #52614e; outline-offset: 3px; }
    .pf-av small { font-size: 12px; color: #4b5563; text-align: center; }
    .pf-av-initials { background: #52614e; color: #fff; display: grid; place-items: center; font-size: 24px; font-weight: 700; }
    .pf-upload { display: flex; align-items: center; gap: 16px; padding: 14px; margin-bottom: 18px; border: 1px dashed #d6cfc2; border-radius: 16px; background: #FBFAF7; }
    .pf-upload strong { display: block; color: #1F2421; }
    .pf-upload small { display: block; color: #6b7280; margin-bottom: 8px; }
    .pf-upload-drop { position: relative; width: 76px; height: 76px; border-radius: 50%; background: #F3EEE5; display: grid; place-items: center; cursor: pointer; overflow: hidden; flex-shrink: 0; border: 2px solid #e7e0d4; }
    .pf-upload-drop i { font-size: 26px; color: #52614e; }
    .pf-upload-drop img { width: 100%; height: 100%; object-fit: cover; }
    .pf-upload-drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
    .pf-upload .pf-btn:disabled { opacity: .45; cursor: not-allowed; }
    .pf-tones { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
    .pf-tones span { font-weight: 600; color: #374151; margin-right: 4px; }
    .pf-tone { width: 30px; height: 30px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 1px #d1d5db; cursor: pointer; padding: 0; }
    .pf-tone.active { box-shadow: 0 0 0 2px #fff, 0 0 0 4px #1F2421; }
    .pf-tone-default { background: conic-gradient(#f6d7c3 0 20%, #e8b892 0 40%, #c68a5e 0 60%, #9a6440 0 80%, #6b4428 0); }
    .pf-hero-text { flex: 1; min-width: 220px; }
    .pf-eyebrow { font-size: 12px; letter-spacing: .14em; color: #d5e5d1; font-weight: 700; }
    .pf-hero h1 { font-family: Georgia, "Times New Roman", serif; margin: 6px 0 4px; font-size: 32px; color: #fff; }
    .pf-hero p { margin: 0; color: #cbd5c8; }
    .pf-level { text-align: right; }
    .pf-level-badge { display: inline-flex; gap: 8px; align-items: center; background: #F3EEE5; color: #1F2421; padding: 8px 16px; border-radius: 999px; font-weight: 700; }
    .pf-level small { display: block; margin-top: 8px; color: #cbd5c8; }

    .pf-stats { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; margin-bottom: 22px; }
    .pf-stat { background: #fff; border-radius: 18px; padding: 18px 20px; }
    .pf-stat span { display: block; color: #6b7280; font-size: 13px; }
    .pf-stat strong { font-family: Georgia, "Times New Roman", serif; font-size: 28px; color: #1F2421; }

    .pf-grid { display: grid; grid-template-columns: 330px 1fr; gap: 22px; align-items: start; }
    .pf-side { display: grid; gap: 22px; }
    .pf-card { background: #fff; border-radius: 22px; padding: 26px; }
    .pf-card h3 { font-family: Georgia, "Times New Roman", serif; font-size: 20px; margin: 0 0 16px; color: #1F2421; }
    .pf-muted { color: #6b7280; font-size: 13px; }
    .pf-link { color: #52614e; font-weight: 700; text-decoration: none; }

    .pf-next { display: flex; gap: 16px; align-items: center; }
    .pf-next-date { width: 62px; text-align: center; border-radius: 14px; background: #F3EEE5; padding: 8px 0; flex-shrink: 0; }
    .pf-next-date span { display: block; font-size: 12px; text-transform: uppercase; color: #52614e; font-weight: 700; }
    .pf-next-date strong { font-size: 24px; color: #1F2421; }
    .pf-next p { margin: 2px 0 0; color: #6b7280; font-size: 13px; }

    .pf-services { list-style: none; padding: 0; margin: 0 0 18px; }
    .pf-services li { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid #f1ede6; color: #374151; }
    .pf-services li i { color: #52614e; }
    .pf-services li b { margin-left: auto; color: #1F2421; }

    .pf-tabs { display: flex; gap: 8px; margin-bottom: 24px; border-bottom: 1px solid #eee7dc; }
    .pf-tab { background: none; border: none; padding: 10px 14px; font-weight: 700; color: #6b7280; border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .pf-tab.active { color: #1F2421; border-color: #1F2421; }
    .pf-pane { display: none; }
    .pf-pane.active { display: block; }

    .pf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .pf-field { margin-bottom: 18px; display: flex; flex-direction: column; gap: 6px; }
    .pf-field label { font-size: 13px; font-weight: 700; color: #374151; }
    .pf-field input { border: 1px solid #e3ddd2; border-radius: 12px; padding: 12px 14px; font-size: 15px; background: #fcfbf8; }
    .pf-field input:focus { outline: none; border-color: #52614e; box-shadow: 0 0 0 3px rgba(82, 97, 78, .15); }
    .pf-field input:disabled { color: #9ca3af; }
    .pf-error, .pf-errors { color: #b42318; font-size: 13px; }
    .pf-errors ul { margin: 0 0 16px; padding-left: 18px; }

    .pf-btn { display: inline-block; text-align: center; border: none; border-radius: 999px; padding: 12px 26px; font-weight: 700; text-decoration: none; }
    .pf-btn-dark { background: #1F2421; color: #fff; }
    .pf-btn-dark:hover { background: #52614e; color: #fff; }

    @@media (max-width: 992px) {
        .pf-grid { grid-template-columns: 1fr; }
        .pf-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    @@media (max-width: 600px) {
        .pf-row { grid-template-columns: 1fr; }
        .pf-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .pf-level { text-align: left; }
    }
</style>

<script>
    // Avatara klik -> seçim panelini aç
    document.getElementById('openAvatars')?.addEventListener('click', () => {
        const picker = document.getElementById('avatarPicker');
        picker.open = true;
        picker.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // Dəri tonu: bütün avatarların şəklini və dəyərini həmin tona keçir
    document.querySelectorAll('.pf-tone').forEach(btn => {
        btn.addEventListener('click', () => {
            const tone = btn.dataset.tone;
            document.querySelectorAll('.pf-tone').forEach(b => b.classList.toggle('active', b === btn));

            document.querySelectorAll('.pf-av[data-style]').forEach(label => {
                const key = tone === '0' ? label.dataset.style : label.dataset.style + '-t' + tone;
                label.querySelector('input').value = key;
                label.querySelector('img').src = '/assets/images/avatars/' + key + '.svg';
            });
        });
    });

    // Öz şəkli: seçiləndə önizləmə göstər və düyməni aktiv et
    const photoInput = document.getElementById('photoInput');
    photoInput?.addEventListener('change', () => {
        const file = photoInput.files[0];
        const preview = document.getElementById('photoPreview');
        const save = document.getElementById('photoSave');

        if (!file) { save.disabled = true; return; }

        preview.src = URL.createObjectURL(file);
        preview.hidden = false;
        document.getElementById('photoIcon').hidden = true;
        save.disabled = file.size > 2 * 1024 * 1024;
    });

    document.querySelectorAll('.pf-tab').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.pf-tab').forEach(b => b.classList.toggle('active', b === btn));
            document.querySelectorAll('.pf-pane').forEach(p => p.classList.toggle('active', p.id === 'pane-' + btn.dataset.tab));
        });
    });
</script>

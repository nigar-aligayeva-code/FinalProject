@model HotelTravel.Application.DTOs.Rooms.RoomSearchDto
@using HotelTravel.Application.DTOs.Home
@inject HotelTravel.Application.Interfaces.IWishlistService WishlistService
@inject HotelTravel.Web.Services.CurrentUserAccessor CurrentUser

@{
    ViewData["Title"] = "Find your perfect stay";

    var destinations =
        ViewBag.Destinations as List<DestinationDto> ?? new List<DestinationDto>();

    var featuredRooms =
        ViewBag.FeaturedRooms as List<FeaturedRoomDto> ?? new List<FeaturedRoomDto>();

    string? firstName = ViewBag.FirstName as string;

    var heroTitle = string.IsNullOrWhiteSpace(firstName)
        ? T["Find your next stay"].Value
        : string.Format(T["{0}, where to next?"].Value, firstName);

    var isAuthenticated =
        User.Identity != null && User.Identity.IsAuthenticated;

    // Hansı otaqlar "Saved"-dədir (ürək dolu görünsün)
    var savedIds =
        await WishlistService.GetSavedRoomIdsAsync(CurrentUser.GetUserId(User));

    // Şəhər kartı: 1 otel varsa birbaşa otelin səhifəsi, çox otel varsa həmin şəhərin otelləri
    var hotelsByCity = ((ViewBag.MapHotels as List<HotelTravel.Application.DTOs.Hotels.GetHotelDto>)
            ?? new List<HotelTravel.Application.DTOs.Hotels.GetHotelDto>())
        .GroupBy(h => h.City ?? "", StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.Select(h => h.Id).ToList(), StringComparer.OrdinalIgnoreCase);

    string CityLink(string city) =>
        hotelsByCity.TryGetValue(city, out var ids) && ids.Count == 1
            ? Url.Action("Details", "Hotels", new { id = ids[0] })!
            : Url.Action("Index", "Hotels", new { city })!;

    // "Hara gedirsiniz?" siyahısı: şəhərlər (otel sayı, ən ucuz qiymət) + otellər
    var destinationOptions = destinations
        .Select(d => new
        {
            kind = "city",
            label = d.City,
            sub = d.Country,
            hotels = d.HotelCount,
            price = d.MinPrice.HasValue ? d.MinPrice.Value.ToString("0") : null
        })
        .Cast<object>()
        .Concat(((ViewBag.MapHotels as List<HotelTravel.Application.DTOs.Hotels.GetHotelDto>)
                ?? new List<HotelTravel.Application.DTOs.Hotels.GetHotelDto>())
            .OrderBy(h => h.City).ThenBy(h => h.Name)
            .Select(h => (object)new { kind = "hotel", label = h.Name, sub = h.City + ", " + h.Country, hotels = 0, price = (string?)null }))
        .ToList();

    // Booking-style reytinq sözü (1-5 şkalası)
    // Xəritə: koordinatı olan otellər
    var mapHotels = ((ViewBag.MapHotels as List<HotelTravel.Application.DTOs.Hotels.GetHotelDto>)
            ?? new List<HotelTravel.Application.DTOs.Hotels.GetHotelDto>())
        .Where(h => h.Latitude != 0 || h.Longitude != 0)
        .Select(h => new
        {
            name = h.Name,
            city = h.City,
            country = h.Country,
            lat = h.Latitude,
            lng = h.Longitude,
            stars = h.StarRating,
            url = Url.Action("Details", "Hotels", new { id = h.Id })
        })
        .ToList();

    string RatingLabel(double rating) => rating switch
    {
        >= 4.5 => T["Exceptional"],
        >= 4.0 => T["Excellent"],
        >= 3.5 => T["Very good"],
        >= 3.0 => T["Good"],
        _ => T["Pleasant"]
    };
}


<!-- ============================= -->
<!-- HERO -->
<!-- ============================= -->
<section class="hh-hero">
    <div class="container">
        <h1>@heroTitle</h1>
        <p>@T["Search hotels, compare rooms and book your stay in a few clicks."]</p>
    </div>
</section>


<!-- ============================= -->
<!-- SEARCH BAR -->
<!-- ============================= -->
<div class="container hh-search-wrap" id="search">

    <form asp-controller="Home"
          asp-action="Search"
          method="post"
          class="hh-search"
          autocomplete="off">

        <!-- Destination: klikləyəndə şəhərlər və otellər siyahısı açılır -->
        <div class="hh-search-field hh-dest-field" id="destField">
            <i class="bi bi-geo-alt"></i>
            <div class="hh-search-body">
                <label asp-for="Destination">@T["Where are you going?"]</label>
                <input asp-for="Destination"
                       type="text"
                       role="combobox"
                       aria-autocomplete="list"
                       aria-expanded="false"
                       aria-controls="destList"
                       placeholder="@T["City, country or hotel"]" />
            </div>

            <div class="hh-dest-list" id="destList" role="listbox" hidden>
                <div class="hh-dest-head">@T["Where we have hotels"]</div>
                <div class="hh-dest-items" id="destItems"></div>
                <div class="hh-dest-empty" id="destEmpty" hidden>@T["No matching city or hotel. Try another name."]</div>
            </div>
        </div>

        <!-- Dates -->
        <div class="hh-search-field">
            <i class="bi bi-calendar3"></i>
            <div class="hh-search-body">
                <span class="hh-search-label">@T["Check-in"] — @T["Check-out"]</span>
                <div class="hh-search-split">
                    <input asp-for="CheckInDate"
                           type="text"
                           id="homeCheckIn"
                           placeholder="@T["Check-in"]"
                           value="@Model.CheckInDate?.ToString("yyyy-MM-dd")" />
                    <span>—</span>
                    <input asp-for="CheckOutDate"
                           type="text"
                           id="homeCheckOut"
                           placeholder="@T["Check-out"]"
                           value="@Model.CheckOutDate?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
        </div>

        <!-- Guests -->
        <div class="hh-search-field">
            <i class="bi bi-person"></i>
            <div class="hh-search-body">
                <span class="hh-search-label">@T["Guests"]</span>
                <div class="hh-search-split">
                    <select asp-for="AdultCount" aria-label="@T["Adults"]">
                        @for (int i = 1; i <= 6; i++)
                        {
                            <option value="@i">@i @(i == 1 ? T["adult"] : T["adults"])</option>
                        }
                    </select>
                    <span>·</span>
                    <select asp-for="ChildrenCount" aria-label="@T["Children"]">
                        @for (int i = 0; i <= 4; i++)
                        {
                            <option value="@i">@i @(i == 1 ? T["child"] : T["children"])</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <button type="submit" class="hh-search-btn">
            <i class="bi bi-search"></i>
            @T["Search"]
        </button>
    </form>

    <div asp-validation-summary="All"
         class="alert alert-danger hh-search-errors"></div>
</div>


<div class="container">

    <!-- ============================= -->
    <!-- WHY BOOK WITH US -->
    <!-- ============================= -->
    <section class="hh-section">
        <div class="hh-benefits">
            <div class="hh-benefit">
                <span class="hh-benefit-icon"><i class="bi bi-lightning-charge"></i></span>
                <div>
                    <h3>@T["Confirmed by the hotel"]</h3>
                    <p>@T["Your request code arrives right away; the hotel checks its real availability and confirms within 24 hours. You pay only after that."]</p>
                </div>
            </div>

            <div class="hh-benefit">
                <span class="hh-benefit-icon"><i class="bi bi-calendar-x"></i></span>
                <div>
                    <h3>@T["Free cancellation"]</h3>
                    <p>@T["Free up to 3 days before check-in. Requests the hotel has not confirmed yet are always free to cancel."]</p>
                </div>
            </div>

            <div class="hh-benefit">
                <span class="hh-benefit-icon"><i class="bi bi-patch-check"></i></span>
                <div>
                    <h3>@T["Real guest reviews"]</h3>
                    <p>@T["Only guests who completed their stay can leave a review."]</p>
                </div>
            </div>
        </div>
    </section>


    <!-- ============================= -->
    <!-- POPULAR DESTINATIONS -->
    <!-- ============================= -->
    @if (destinations.Any())
    {
        <section class="hh-section" id="destinations">
            <div class="hh-section-head">
                <div>
                    <h2 class="hh-section-title">@T["Popular destinations"]</h2>
                    <p class="hh-section-sub">@T["Cities where our guests love to stay"]</p>
                </div>
            </div>

            <div class="hh-carousel" data-carousel>
                <button type="button"
                        class="hh-carousel-btn hh-carousel-prev"
                        aria-label="Previous">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <div class="hh-dest-row">
                    @foreach (var destination in destinations)
                    {
                        <a href="@CityLink(destination.City)"
                           class="hh-dest">

                            <div class="hh-dest-img">
                                @if (!string.IsNullOrWhiteSpace(destination.ImageUrl))
                                {
                                    <img src="@destination.ImageUrl"
                                         alt="@destination.City"
                                         loading="lazy" />
                                }
                            </div>

                            <div class="hh-dest-body">
                                <h3>@destination.City</h3>

                                <span class="hh-dest-country">
                                    <i class="bi bi-geo-alt"></i>
                                    @destination.Country
                                </span>

                                <div class="hh-dest-meta">
                                    <span>
                                        @destination.HotelCount @(destination.HotelCount == 1 ? T["hotel"] : T["hotels"])
                                        · @destination.RoomCount @(destination.RoomCount == 1 ? T["room"] : T["rooms"])
                                    </span>

                                    @if (destination.MinPrice.HasValue)
                                    {
                                        <span>@T["from"] <strong>@destination.MinPrice.Value.ToString("0") AZN</strong></span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </div>

                <button type="button"
                        class="hh-carousel-btn hh-carousel-next"
                        aria-label="Next">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </section>
    }


    <!-- ============================= -->
    <!-- GUESTS' FAVOURITE ROOMS -->
    <!-- ============================= -->
    <section class="hh-section">
        <div class="hh-section-head">
            <div>
                <h2 class="hh-section-title">@T["Rooms guests love"]</h2>
                <p class="hh-section-sub">@T["Top-rated rooms based on verified guest reviews"]</p>
            </div>

            <a asp-controller="Rooms"
               asp-action="Search"
               class="hh-link-more">
                @T["Search all rooms"] <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        @if (featuredRooms.Any())
        {
            <div class="hh-room-grid">
                @foreach (var room in featuredRooms)
                {
                    var saved = savedIds.Contains(room.Id);

                    <div class="hh-room-wrap">
                    <button type="button"
                            class="hh-save @(saved ? "saved" : "")"
                            data-room-id="@room.Id"
                            aria-label="Save room"
                            aria-pressed="@(saved ? "true" : "false")">
                        <i class="bi @(saved ? "bi-heart-fill" : "bi-heart")"></i>
                    </button>

                    <a asp-controller="Rooms"
                       asp-action="Details"
                       asp-route-id="@room.Id"
                       class="hh-room">

                        <div class="hh-room-img">
                            @if (!string.IsNullOrWhiteSpace(room.MainImage))
                            {
                                <img src="@room.MainImage"
                                     alt="@room.Name"
                                     loading="lazy" />
                            }
                            <span class="hh-room-type">@T.Enum(room.RoomType)</span>
                        </div>

                        <div class="hh-room-body">
                            <h3>@room.Name</h3>

                            <div class="hh-room-meta">
                                @room.HotelName · @room.City
                                <br />
                                <i class="bi bi-people"></i>
                                @T["Up to"] @room.Capacity @(room.Capacity == 1 ? T["guest"] : T["guests"])
                            </div>

                            <div class="hh-rating">
                                @if (room.ReviewCount > 0)
                                {
                                    <span class="hh-score">@room.AverageRating.ToString("0.0")</span>
                                    <strong>@RatingLabel(room.AverageRating)</strong>
                                    <span>
                                        @room.ReviewCount @(room.ReviewCount == 1 ? T["review"] : T["reviews"])
                                    </span>
                                }
                                else
                                {
                                    <span class="hh-badge-new">@T["New"]</span>
                                    <span>@T["No reviews yet"]</span>
                                }
                            </div>

                            <div class="hh-room-price">
                                <small>@T["per night from"]</small>
                                <strong>@room.PricePerNight.ToString("0.00") AZN</strong>
                            </div>
                        </div>
                    </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="hh-empty">
                @T["No rooms are available yet."]
            </div>
        }
    </section>


    <!-- ============================= -->
    <!-- HOTELS ON THE MAP -->
    <!-- ============================= -->
    @if (mapHotels.Any())
    {
        <section class="hh-section" id="map">
            <div class="hh-section-head">
                <div>
                    <h2 class="hh-section-title">@T["Explore on the map"]</h2>
                    <p class="hh-section-sub">@(string.Format(T["{0} hotels across {1} cities. Tap a pin to see the hotel."].Value, mapHotels.Count, mapHotels.Select(h => h.city).Distinct().Count()))</p>
                </div>

                <a asp-controller="Hotels"
                   asp-action="Index"
                   class="hh-link-more">
                    @T["Browse all hotels"] <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div id="homeMap" class="home-map"></div>
        </section>
    }

</div>


@section Styles {
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <style>
        .home-map { height: 420px; border-radius: 20px; overflow: hidden; z-index: 0; box-shadow: 0 10px 30px rgba(31, 36, 33, .08); }
        .home-pin { background: #1F2421; color: #fff; border-radius: 999px; padding: 4px 10px; font-size: 12px; font-weight: 700; white-space: nowrap; border: 2px solid #fff; box-shadow: 0 4px 12px rgba(0,0,0,.25); display: inline-flex; gap: 4px; align-items: center; }
        .home-pin i { color: #f5c451; }
        .home-popup strong { display: block; color: #1F2421; }
        .home-popup span { color: #6b7280; font-size: 12px; }
        .home-popup a { display: inline-block; margin-top: 6px; color: #52614e; font-weight: 700; text-decoration: none; }

        /* "Hara gedirsiniz?" siyahısı */
        .hh-dest-field { position: relative; }
        .hh-dest-list { position: absolute; top: calc(100% + 10px); left: -4px; width: min(440px, calc(100vw - 32px)); max-height: 380px; overflow-y: auto; background: #fff; border-radius: 16px; box-shadow: 0 22px 48px rgba(31,36,33,.22); z-index: 60; padding: 8px; }
        .hh-dest-list[hidden] { display: none; }
        .hh-dest-head { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #9ca3af; padding: 8px 10px 6px; }
        .hh-dest-item { display: flex; gap: 12px; align-items: center; width: 100%; border: 0; background: none; text-align: left; padding: 9px 10px; border-radius: 12px; cursor: pointer; color: #1F2421; }
        .hh-dest-item:hover, .hh-dest-item.active { background: #F3EEE5; }
        .hh-dest-ico { width: 38px; height: 38px; border-radius: 10px; background: #eef2ec; color: #52614e; display: grid; place-items: center; font-size: 18px; flex-shrink: 0; }
        .hh-dest-item.hotel .hh-dest-ico { background: #f7efd9; color: #8a6d2b; }
        .hh-dest-text { flex: 1; min-width: 0; display: grid; }
        .hh-dest-text b { font-size: 15px; }
        .hh-dest-text small { color: #6b7280; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .hh-dest-price { font-size: 12px; color: #52614e; font-weight: 700; white-space: nowrap; }
        .hh-dest-sep { height: 1px; background: #f1ece3; margin: 6px 10px; }
        .hh-dest-empty { padding: 14px 10px; color: #9ca3af; font-size: 14px; }
    </style>
}

@section Scripts {
    <script>
        // "Hara gedirsiniz?" - klikləyəndə şəhərlər və otellər, yazanda süzülür
        (function () {
            const input = document.getElementById('Destination');
            const box = document.getElementById('destList');
            const items = document.getElementById('destItems');
            const empty = document.getElementById('destEmpty');
            const field = document.getElementById('destField');
            if (!input || !box) return;

            const options = @Json.Serialize(destinationOptions);
            const text = {
                hotels: @Json.Serialize(T["hotels"].Value),
                hotel: @Json.Serialize(T["hotel"].Value),
                from: @Json.Serialize(T["from"].Value)
            };
            let active = -1;

            function norm(s) { return String(s || '').toLocaleLowerCase(); }

            function render() {
                const q = norm(input.value.trim());
                const match = o => !q || norm(o.label).includes(q) || norm(o.sub).includes(q);
                const cities = options.filter(o => o.kind === 'city' && match(o));
                // Boş olanda yalnız şəhərlər; yazanda otellər də
                const hotels = q ? options.filter(o => o.kind === 'hotel' && match(o)).slice(0, 6) : [];

                items.innerHTML = '';
                active = -1;

                const add = (o) => {
                    const b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'hh-dest-item ' + o.kind;
                    b.setAttribute('role', 'option');

                    const ico = document.createElement('span');
                    ico.className = 'hh-dest-ico';
                    ico.innerHTML = o.kind === 'city' ? '<i class="bi bi-geo-alt"></i>' : '<i class="bi bi-building"></i>';

                    const t = document.createElement('span');
                    t.className = 'hh-dest-text';
                    const name = document.createElement('b');
                    name.textContent = o.label;
                    const sub = document.createElement('small');
                    sub.textContent = o.kind === 'city'
                        ? o.sub + ' · ' + o.hotels + ' ' + (o.hotels === 1 ? text.hotel : text.hotels)
                        : o.sub;
                    t.append(name, sub);
                    b.append(ico, t);

                    if (o.price) {
                        const p = document.createElement('span');
                        p.className = 'hh-dest-price';
                        p.textContent = text.from + ' ' + o.price + ' AZN';
                        b.append(p);
                    }

                    b.addEventListener('mousedown', e => { e.preventDefault(); choose(o); });
                    items.append(b);
                };

                cities.forEach(add);
                if (cities.length && hotels.length) {
                    const sep = document.createElement('div');
                    sep.className = 'hh-dest-sep';
                    items.append(sep);
                }
                hotels.forEach(add);

                empty.hidden = cities.length + hotels.length > 0;
            }

            function open() { render(); box.hidden = false; input.setAttribute('aria-expanded', 'true'); }
            function close() { box.hidden = true; input.setAttribute('aria-expanded', 'false'); }

            function choose(o) {
                input.value = o.label;
                close();
                // Növbəti addım: tarixlər
                const next = document.getElementById('homeCheckIn');
                if (next) { next.focus(); next.click(); }
            }

            function move(step) {
                const list = items.querySelectorAll('.hh-dest-item');
                if (!list.length) return;
                list.forEach(i => i.classList.remove('active'));
                active = (active + step + list.length) % list.length;
                list[active].classList.add('active');
                list[active].scrollIntoView({ block: 'nearest' });
            }

            input.addEventListener('focus', open);
            input.addEventListener('click', open);
            input.addEventListener('input', open);
            input.addEventListener('blur', () => setTimeout(close, 120));
            input.addEventListener('keydown', e => {
                if (box.hidden && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) open();
                if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
                else if (e.key === 'Enter' && active >= 0) {
                    e.preventDefault();
                    items.querySelectorAll('.hh-dest-item')[active].dispatchEvent(new MouseEvent('mousedown'));
                }
                else if (e.key === 'Escape') close();
            });
            document.addEventListener('click', e => { if (!field.contains(e.target)) close(); });
        })();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script>
        (function () {
            const el = document.getElementById('homeMap');
            if (!el || typeof L === 'undefined') return;

            const hotels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mapHotels));
            const map = L.map(el, { scrollWheelZoom: false });

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

            const markers = hotels.map(h => L.marker([h.lat, h.lng], {
                icon: L.divIcon({ className: '', html: `<span class="home-pin"><i class="bi bi-star-fill"></i>${h.stars} ${esc(h.city)}</span>`, iconSize: null })
            })
                .bindPopup(`<div class="home-popup"><strong>${esc(h.name)}</strong><span>${esc(h.city)}, ${esc(h.country)}</span><br><a href="${h.url}">@T["View hotel"] &rarr;</a></div>`)
                .addTo(map));

            map.fitBounds(L.featureGroup(markers).getBounds().pad(0.2));
        })();
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const checkInInput = document.getElementById("homeCheckIn");
            const checkOutInput = document.getElementById("homeCheckOut");

            if (!checkInInput || !checkOutInput || typeof flatpickr === "undefined") {
                return;
            }

            // Server-ə "yyyy-MM-dd" gedir,
            // istifadəçi isə "Wed, Oct 14" görür
            const common = {
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "D, M j",
                altInputClass: "hh-input",
                disableMobile: true
            };

            const checkOutPicker = flatpickr(checkOutInput, Object.assign({}, common, {
                minDate: new Date().fp_incr(1),
                defaultDate: checkOutInput.value || null
            }));

            flatpickr(checkInInput, Object.assign({}, common, {
                minDate: "today",
                defaultDate: checkInInput.value || null,

                onChange: function (selectedDates) {
                    if (selectedDates.length === 0) {
                        return;
                    }

                    // Check-out ən azı 1 gün sonra olsun
                    const minimumCheckOut = new Date(selectedDates[0]);
                    minimumCheckOut.setDate(minimumCheckOut.getDate() + 1);

                    checkOutPicker.set("minDate", minimumCheckOut);

                    const currentCheckOut = checkOutPicker.selectedDates[0];

                    if (!currentCheckOut || currentCheckOut < minimumCheckOut) {
                        checkOutPicker.setDate(minimumCheckOut, true);
                    }

                    checkOutPicker.open();
                }
            }));

            // Destination kartından gəlibsə, tarix seçiminə yönləndir
            if (window.location.hash === "#search" &&
                document.getElementById("Destination").value) {
                checkInInput._flatpickr.open();
            }
        });
    </script>

    <script>
        // Popular destinations - sola/sağa sürüşdürmə düymələri
        document.querySelectorAll("[data-carousel]").forEach(function (carousel) {
            const row = carousel.querySelector(".hh-dest-row");
            const prev = carousel.querySelector(".hh-carousel-prev");
            const next = carousel.querySelector(".hh-carousel-next");

            const step = () => row.clientWidth * 0.75;

            function update() {
                prev.disabled = row.scrollLeft <= 4;
                next.disabled = row.scrollLeft + row.clientWidth >= row.scrollWidth - 4;
            }

            prev.addEventListener("click", () => row.scrollBy({ left: -step(), behavior: "smooth" }));
            next.addEventListener("click", () => row.scrollBy({ left: step(), behavior: "smooth" }));

            row.addEventListener("scroll", update);
            window.addEventListener("resize", update);
            update();
        });
    </script>
}

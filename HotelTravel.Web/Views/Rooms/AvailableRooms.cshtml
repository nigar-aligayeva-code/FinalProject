@model List<HotelTravel.Application.DTOs.Rooms.GetRoomDto>

@{
    ViewData["Title"] = "Available Rooms";

    var checkInDate = (DateTime)ViewBag.CheckInDate;
    var checkOutDate = (DateTime)ViewBag.CheckOutDate;

    string? destination = ViewBag.Destination as string;
    int adultCount = (int)ViewBag.AdultCount;
    int childrenCount = (int)ViewBag.ChildrenCount;
}

<div class="container mt-5 mb-5">

    <h2 class="mb-4">Available Rooms</h2>

    <!-- SEARCH INFORMATION -->
    <div class="alert alert-info">

        @if (!string.IsNullOrWhiteSpace(destination))
        {
            <div>
                <strong>Destination:</strong>
                @destination
            </div>
        }

        <div>
            <strong>Check-in:</strong>
            @checkInDate.ToString("dd.MM.yyyy")
        </div>

        <div>
            <strong>Check-out:</strong>
            @checkOutDate.ToString("dd.MM.yyyy")
        </div>

        <div>
            <strong>Guests:</strong>
            @adultCount Adult(s),
            @childrenCount Child(ren)
        </div>

    </div>


    @if (Model == null || Model.Count == 0)
    {
        <!-- NO AVAILABLE ROOMS -->
        <div class="alert alert-warning">
            No available rooms were found for the selected dates.
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           asp-fragment="booking-search"
           asp-route-destination="@destination"
           asp-route-checkInDate="@checkInDate.ToString("yyyy-MM-dd")"
           asp-route-checkOutDate="@checkOutDate.ToString("yyyy-MM-dd")"
           asp-route-adultCount="@adultCount"
           asp-route-childrenCount="@childrenCount"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Search Again

        </a>
    }
    else
    {
        <!-- AVAILABLE ROOMS -->
        <div class="row">

            @foreach (var room in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card h-100">

                        @if (!string.IsNullOrWhiteSpace(room.MainImage))
                        {
                            <img src="@room.MainImage"
                                 class="card-img-top"
                                 alt="@room.Name"
                                 style="height:220px; object-fit:cover;" />
                        }

                        <div class="card-body">

                            <h4 class="card-title">
                                @room.Name
                            </h4>

                            <p>
                                <strong>Room:</strong>
                                @room.RoomNumber
                            </p>

                            <p>
                                <strong>Type:</strong>
                                @room.RoomType
                            </p>

                            <p>
                                <strong>Capacity:</strong>
                                @room.Capacity
                            </p>

                            <p>
                                <strong>Price:</strong>
                                @room.PricePerNight.ToString("0.00")
                                AZN / night
                            </p>

                            <p>
                                @room.Description
                            </p>


                            <!-- AMENITIES -->
                            <div class="mb-3">

                                <strong>Amenities:</strong>

                                @if (room.AmenityNames != null &&
                                     room.AmenityNames.Any())
                                {
                                    <div class="d-flex flex-wrap gap-2 mt-2">

                                        @foreach (var amenity in room.AmenityNames)
                                        {
                                            <span class="badge bg-light text-dark border p-2">
                                                ✓ @amenity
                                            </span>
                                        }

                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted mt-2">
                                        No amenities available.
                                    </div>
                                }

                            </div>


                            <!-- DETAILS -->
                            <a asp-controller="Rooms"
                               asp-action="Details"
                               asp-route-id="@room.Id"
                               asp-route-checkInDate="@checkInDate.ToString("yyyy-MM-dd")"
                               asp-route-checkOutDate="@checkOutDate.ToString("yyyy-MM-dd")"
                               asp-route-adultCount="@adultCount"
                               asp-route-childrenCount="@childrenCount"
                               class="btn btn-outline-secondary">

                                Details

                            </a>


                            <!-- BOOK NOW -->
                            <a asp-controller="Bookings"
                               asp-action="Create"
                               asp-route-roomId="@room.Id"
                               asp-route-checkInDate="@checkInDate.ToString("yyyy-MM-dd")"
                               asp-route-checkOutDate="@checkOutDate.ToString("yyyy-MM-dd")"
                               asp-route-adultCount="@adultCount"
                               asp-route-childrenCount="@childrenCount"
                               class="btn btn-success">

                                Book Now

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- SEARCH AGAIN -->
        <a asp-controller="Home"
           asp-action="Index"
           asp-fragment="booking-search"
           asp-route-destination="@destination"
           asp-route-checkInDate="@checkInDate.ToString("yyyy-MM-dd")"
           asp-route-checkOutDate="@checkOutDate.ToString("yyyy-MM-dd")"
           asp-route-adultCount="@adultCount"
           asp-route-childrenCount="@childrenCount"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Search Again

        </a>
    }

</div>
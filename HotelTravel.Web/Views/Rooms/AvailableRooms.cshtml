@model List<HotelTravel.Application.DTOs.Rooms.GetRoomDto>
@inject HotelTravel.Application.Interfaces.IWishlistService WishlistService
@inject HotelTravel.Web.Services.CurrentUserAccessor CurrentUser

@{
    ViewData["Title"] = "Available Rooms";

    var checkInDate = (DateTime)ViewBag.CheckInDate;
    var checkOutDate = (DateTime)ViewBag.CheckOutDate;

    string? destination = ViewBag.Destination as string;
    int adultCount = (int)ViewBag.AdultCount;
    int childrenCount = (int)ViewBag.ChildrenCount;

    var nights = Math.Max(1, (checkOutDate.Date - checkInDate.Date).Days);

    var guestsText = T.Plural(adultCount, "adult", "adults");
    if (childrenCount > 0)
    {
        guestsText += ", " + T.Plural(childrenCount, "child", "children");
    }

    var rooms = Model ?? new List<HotelTravel.Application.DTOs.Rooms.GetRoomDto>();

    // Filtr seçimləri nəticələrin özündən yaranır
    var roomTypes = rooms
        .GroupBy(r => r.RoomType.ToString())
        .Select(g => new { Name = g.Key, Count = g.Count() })
        .OrderBy(x => x.Name)
        .ToList();

    var hotels = rooms
        .GroupBy(r => r.HotelName ?? "Hotel")
        .Select(g => new { Name = g.Key, City = g.First().City, Count = g.Count() })
        .OrderBy(x => x.Name)
        .ToList();

    var amenities = rooms
        .SelectMany(r => r.AmenityNames ?? new List<string>())
        .GroupBy(a => a)
        .Select(g => new { Name = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count)
        .ThenBy(x => x.Name)
        .ToList();

    var minPrice = rooms.Any() ? (int)Math.Floor(rooms.Min(r => r.PricePerNight)) : 0;
    var maxPrice = rooms.Any() ? (int)Math.Ceiling(rooms.Max(r => r.PricePerNight)) : 0;

    var savedIds =
        await WishlistService.GetSavedRoomIdsAsync(CurrentUser.GetUserId(User));

    string RatingLabel(double rating) => rating switch
    {
        >= 4.5 => T["Exceptional"],
        >= 4.0 => T["Excellent"],
        >= 3.5 => T["Very good"],
        >= 3.0 => T["Good"],
        _ => T["Pleasant"]
    };

    var checkInText = checkInDate.ToString("ddd, MMM d", System.Globalization.CultureInfo.CurrentUICulture);
    var checkOutText = checkOutDate.ToString("ddd, MMM d", System.Globalization.CultureInfo.CurrentUICulture);
}

<div class="container hh-results-page">

    <!-- ============================= -->
    <!-- SEARCH SUMMARY -->
    <!-- ============================= -->
    <div class="hh-summary">
        <div class="hh-summary-item">
            <i class="bi bi-geo-alt"></i>
            <span>@(string.IsNullOrWhiteSpace(destination) ? T["All destinations"].Value : destination)</span>
        </div>
        <div class="hh-summary-item">
            <i class="bi bi-calendar3"></i>
            <span>@checkInText — @checkOutText</span>
        </div>
        <div class="hh-summary-item">
            <i class="bi bi-person"></i>
            <span>@guestsText</span>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           asp-fragment="search"
           asp-route-destination="@destination"
           asp-route-checkInDate="@checkInDate.ToString("yyyy-MM-dd")"
           asp-route-checkOutDate="@checkOutDate.ToString("yyyy-MM-dd")"
           asp-route-adultCount="@adultCount"
           asp-route-childrenCount="@childrenCount"
           class="hh-search-btn hh-summary-btn">
            @T["Change search"]
        </a>
    </div>

    @if (!rooms.Any())
    {
        <div class="hh-empty mt-4">
            <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
            <strong class="d-block mb-1">@T["No rooms available for these dates"]</strong>
            @T["Try different dates, fewer guests or another destination."]
        </div>
    }
    else
    {
        <div class="hh-results-layout">

            <!-- ============================= -->
            <!-- FILTERS -->
            <!-- ============================= -->
            <aside class="hh-filters" id="hhFilters">

                <div class="hh-filters-head">
                    <h2>@T["Filter by"]</h2>
                    <button type="button" class="hh-link-btn" id="resetFilters">
                        @T["Reset"]
                    </button>
                </div>

                <!-- Budget -->
                <div class="hh-filter-group">
                    <h3>Your budget (per night)</h3>
                    <div class="hh-range-value">
                        Up to <strong id="priceValue">@maxPrice AZN</strong>
                    </div>
                    <input type="range"
                           id="filterPrice"
                           class="hh-range"
                           min="@minPrice"
                           max="@maxPrice"
                           step="5"
                           value="@maxPrice" />
                    <div class="hh-range-scale">
                        <span>@minPrice AZN</span>
                        <span>@maxPrice AZN</span>
                    </div>
                </div>

                <!-- Rating -->
                <div class="hh-filter-group">
                    <h3>@T["Guest rating"]</h3>
                    <label class="hh-check">
                        <input type="radio" name="filterRating" value="0" checked />
                        <span>@T["Any rating"]</span>
                    </label>
                    <label class="hh-check">
                        <input type="radio" name="filterRating" value="4.5" />
                        <span>@T["Exceptional 4.5+"]</span>
                    </label>
                    <label class="hh-check">
                        <input type="radio" name="filterRating" value="4" />
                        <span>@T["Excellent 4+"]</span>
                    </label>
                    <label class="hh-check">
                        <input type="radio" name="filterRating" value="3" />
                        <span>@T["Good 3+"]</span>
                    </label>
                </div>

                <!-- Room type -->
                <div class="hh-filter-group">
                    <h3>@T["Room type"]</h3>
                    @foreach (var type in roomTypes)
                    {
                        <label class="hh-check">
                            <input type="checkbox" name="filterType" value="@type.Name" />
                            <span>@T.Enum(type.Name)</span>
                            <small>@type.Count</small>
                        </label>
                    }
                </div>

                <!-- Hotel -->
                @if (hotels.Count > 1)
                {
                    <div class="hh-filter-group">
                        <h3>@T["Hotel"]</h3>
                        @foreach (var hotel in hotels)
                        {
                            <label class="hh-check">
                                <input type="checkbox" name="filterHotel" value="@hotel.Name" />
                                <span>@hotel.Name <em>@hotel.City</em></span>
                                <small>@hotel.Count</small>
                            </label>
                        }
                    </div>
                }

                <!-- Amenities -->
                @if (amenities.Any())
                {
                    <div class="hh-filter-group">
                        <h3>@T["Facilities"]</h3>
                        @foreach (var amenity in amenities)
                        {
                            <label class="hh-check">
                                <input type="checkbox" name="filterAmenity" value="@amenity.Name" />
                                <span>@amenity.Name</span>
                                <small>@amenity.Count</small>
                            </label>
                        }
                    </div>
                }
            </aside>


            <!-- ============================= -->
            <!-- RESULTS -->
            <!-- ============================= -->
            <section class="hh-results">

                <div class="hh-results-bar">
                    <div>
                        <h1 class="hh-results-title">
                            @(string.IsNullOrWhiteSpace(destination) ? T["Rooms for your dates"].Value : T["{0}: rooms for your dates", destination].Value)
                        </h1>
                        <span class="hh-results-count" id="resultCount">
                            @T["{0} found", T.Plural(rooms.Count, "room", "rooms")]
                        </span>
                    </div>

                    <div class="hh-results-tools">
                        <button type="button"
                                class="hh-btn hh-btn-outline d-lg-none"
                                id="toggleFilters">
                            <i class="bi bi-sliders"></i>
                            @T["Filters"]
                        </button>

                        <label class="hh-sort">
                            <span>@T["Sort by"]</span>
                            <select id="sortBy">
                                <option value="recommended">@T["Our top picks"]</option>
                                <option value="price-asc">Price (lowest first)</option>
                                <option value="price-desc">Price (highest first)</option>
                                <option value="rating-desc">@T["Guest rating"]</option>
                                <option value="capacity-desc">@T["Most guests"]</option>
                            </select>
                        </label>
                    </div>
                </div>

                <div id="resultList">
                    @foreach (var room in rooms)
                    {
                        var saved = savedIds.Contains(room.Id);
                        var total = room.PricePerNight * nights;
                        var amenityList = room.AmenityNames ?? new List<string>();
                        var description = string.IsNullOrWhiteSpace(room.Description)
                            ? ""
                            : (room.Description.Length > 150
                                ? room.Description.Substring(0, 150).TrimEnd() + "…"
                                : room.Description);

                        <article class="hh-result"
                                 data-price="@room.PricePerNight.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-rating="@room.AverageRating.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                 data-reviews="@room.ReviewCount"
                                 data-capacity="@room.Capacity"
                                 data-type="@room.RoomType"
                                 data-hotel="@(room.HotelName ?? "Hotel")"
                                 data-amenities="@(string.Join("|", amenityList))">

                            <div class="hh-result-img">
                                <a asp-controller="Rooms"
                                   asp-action="Details"
                                   asp-route-id="@room.Id"
                                   asp-route-checkInDate="@checkInDate.ToString("yyyy-MM-dd")"
                                   asp-route-checkOutDate="@checkOutDate.ToString("yyyy-MM-dd")"
                                   asp-route-adultCount="@adultCount"
                                   asp-route-childrenCount="@childrenCount">
                                    @if (!string.IsNullOrWhiteSpace(room.MainImage))
                                    {
                                        <img src="@room.MainImage" alt="@room.Name" loading="lazy" />
                                    }
                                </a>

                                <button type="button"
                                        class="hh-save @(saved ? "saved" : "")"
                                        data-room-id="@room.Id"
                                        aria-label="@T["Save room"]"
                                        aria-pressed="@(saved ? "true" : "false")">
                                    <i class="bi @(saved ? "bi-heart-fill" : "bi-heart")"></i>
                                </button>
                            </div>

                            <div class="hh-result-body">
                                <div class="hh-result-main">
                                    <h2>
                                        <a asp-controller="Rooms"
                                           asp-action="Details"
                                           asp-route-id="@room.Id"
                                           asp-route-checkInDate="@checkInDate.ToString("yyyy-MM-dd")"
                                           asp-route-checkOutDate="@checkOutDate.ToString("yyyy-MM-dd")"
                                           asp-route-adultCount="@adultCount"
                                           asp-route-childrenCount="@childrenCount">
                                            @room.Name
                                        </a>
                                    </h2>

                                    <div class="hh-result-loc">
                                        <i class="bi bi-geo-alt"></i>
                                        @room.HotelName · @room.City
                                    </div>

                                    <div class="hh-result-tags">
                                        <span>@T.Enum(room.RoomType)</span>
                                        <span><i class="bi bi-people"></i> Up to @room.Capacity</span>
                                        <span>@T["Room {0}", room.RoomNumber]</span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(description))
                                    {
                                        <p class="hh-result-desc">@description</p>
                                    }

                                    @if (amenityList.Any())
                                    {
                                        <div class="hh-chips">
                                            @foreach (var amenity in amenityList.Take(5))
                                            {
                                                <span><i class="bi bi-check2"></i> @amenity</span>
                                            }
                                            @if (amenityList.Count > 5)
                                            {
                                                <span class="hh-chip-more">+@(amenityList.Count - 5) more</span>
                                            }
                                        </div>
                                    }

                                    <div class="hh-result-perk">
                                        <i class="bi bi-check-circle-fill"></i>
                                        @T["Free cancellation before check-in"]
                                    </div>

                                    <button type="button"
                                            class="cmp-toggle mt-2"
                                            data-compare-id="@room.Id"
                                            data-compare-name="@room.Name"
                                            data-compare-img="@room.MainImage"
                                            aria-pressed="false">
                                        <i class="bi bi-layout-three-columns"></i>
                                        <span class="cmp-toggle-text">@T["Compare"]</span>
                                    </button>
                                </div>

                                <div class="hh-result-side">
                                    <div class="hh-result-rating">
                                        @if (room.ReviewCount > 0)
                                        {
                                            <div class="text-end">
                                                <strong>@RatingLabel(room.AverageRating)</strong>
                                                <small>@T.Plural(room.ReviewCount, "review", "reviews")</small>
                                            </div>
                                            <span class="hh-score">@room.AverageRating.ToString("0.0")</span>
                                        }
                                        else
                                        {
                                            <span class="hh-badge-new">@T["New"]</span>
                                        }
                                    </div>

                                    <div class="hh-result-price">
                                        <small>@T.Plural(nights, "night", "nights"), @guestsText</small>
                                        <strong>@total.ToString("0.00") AZN</strong>
                                        <small>@room.PricePerNight.ToString("0.00") AZN / night</small>
                                    </div>

                                    <a asp-controller="Bookings"
                                       asp-action="Create"
                                       asp-route-roomId="@room.Id"
                                       asp-route-checkInDate="@checkInDate.ToString("yyyy-MM-dd")"
                                       asp-route-checkOutDate="@checkOutDate.ToString("yyyy-MM-dd")"
                                       asp-route-adultCount="@adultCount"
                                       asp-route-childrenCount="@childrenCount"
                                       class="hh-btn hh-btn-primary w-100">
                                        @T["Request to book"] <i class="bi bi-chevron-right"></i>
                                    </a>
                                    <small class="hh-request-hint d-block text-center mt-2 small" style="color:#8a6d2b">
                                        <i class="bi bi-hourglass-split"></i>
                                        @T["Hotel confirms within {0}h", HotelTravel.Application.Services.BookingRules.HotelAnswerHours]
                                    </small>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                <div class="hh-empty d-none" id="noMatches">
                    <i class="bi bi-funnel fs-2 d-block mb-2"></i>
                    <strong class="d-block mb-1">@T["No rooms match your filters"]</strong>
                    <button type="button" class="hh-link-btn" id="resetFilters2">@T["Reset filters"]</button>
                </div>
            </section>
        </div>
    }
</div>


@section Scripts {
    <script>
        (function () {
            const list = document.getElementById("resultList");
            if (!list) return;

            const cards = Array.from(list.querySelectorAll(".hh-result"));
            const price = document.getElementById("filterPrice");
            const priceValue = document.getElementById("priceValue");
            const sortBy = document.getElementById("sortBy");
            const countLabel = document.getElementById("resultCount");
            const noMatches = document.getElementById("noMatches");
            const filters = document.getElementById("hhFilters");

            const checked = (name) =>
                Array.from(document.querySelectorAll(`input[name="${name}"]:checked`))
                    .map(i => i.value);

            const num = (card, key) => parseFloat(card.dataset[key]) || 0;

            const sorters = {
                "recommended": (a, b) =>
                    num(b, "rating") - num(a, "rating") ||
                    num(b, "reviews") - num(a, "reviews") ||
                    num(a, "price") - num(b, "price"),
                "price-asc": (a, b) => num(a, "price") - num(b, "price"),
                "price-desc": (a, b) => num(b, "price") - num(a, "price"),
                "rating-desc": (a, b) => num(b, "rating") - num(a, "rating") || num(b, "reviews") - num(a, "reviews"),
                "capacity-desc": (a, b) => num(b, "capacity") - num(a, "capacity") || num(a, "price") - num(b, "price")
            };

            function apply() {
                const maxPrice = parseFloat(price.value);
                const minRating = parseFloat(checked("filterRating")[0] || "0");
                const types = checked("filterType");
                const hotels = checked("filterHotel");
                const amenities = checked("filterAmenity");

                priceValue.textContent = price.value + " AZN";

                let visible = 0;

                cards.forEach(card => {
                    const cardAmenities = (card.dataset.amenities || "").split("|");

                    const ok =
                        num(card, "price") <= maxPrice &&
                        num(card, "rating") >= minRating &&
                        (types.length === 0 || types.includes(card.dataset.type)) &&
                        (hotels.length === 0 || hotels.includes(card.dataset.hotel)) &&
                        amenities.every(a => cardAmenities.includes(a));

                    card.hidden = !ok;
                    if (ok) visible++;
                });

                cards
                    .slice()
                    .sort(sorters[sortBy.value] || sorters.recommended)
                    .forEach(card => list.appendChild(card));

                countLabel.textContent = visible + (visible === 1 ? " room found" : " rooms found");
                noMatches.classList.toggle("d-none", visible > 0);
            }

            function reset() {
                price.value = price.max;
                document.querySelectorAll('input[name="filterType"], input[name="filterHotel"], input[name="filterAmenity"]')
                    .forEach(i => i.checked = false);
                document.querySelector('input[name="filterRating"][value="0"]').checked = true;
                apply();
            }

            document.querySelectorAll("#hhFilters input").forEach(i => i.addEventListener("input", apply));
            sortBy.addEventListener("change", apply);
            document.getElementById("resetFilters").addEventListener("click", reset);
            document.getElementById("resetFilters2").addEventListener("click", reset);

            document.getElementById("toggleFilters").addEventListener("click", () => {
                filters.classList.toggle("open");
            });

            apply();
        })();
    </script>
}

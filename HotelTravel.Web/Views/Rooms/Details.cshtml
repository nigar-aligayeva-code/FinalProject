@model HotelTravel.Application.DTOs.Rooms.GetRoomDto

@{
    ViewData["Title"] = "Room Details";
}

<div class="container mt-5 mb-5">

    <h2 class="mb-4">
        @Model.Name
    </h2>

    <!-- ========================= -->
    <!-- ROOM GALLERY -->
    <!-- ========================= -->
    <div class="row mb-5">

        <!-- MAIN IMAGE -->
        <div class="col-lg-8 mb-3">

            @if (!string.IsNullOrWhiteSpace(Model.MainImage))
            {
                <img id="mainRoomImage"
                     src="@Model.MainImage"
                     alt="@Model.Name"
                     class="img-fluid rounded"
                     style="width: 100%;
                height: 500px;
                object-fit: cover;
                cursor: pointer;" />
            }
            else
            {
                <div class="border rounded d-flex align-items-center justify-content-center"
                     style="height: 500px;">

                    <span class="text-muted">
                        No main image available.
                    </span>

                </div>
            }

        </div>


        <!-- GALLERY -->
        <div class="col-lg-4">

            @if (Model.ImageUrls != null &&
                 Model.ImageUrls.Any())
            {
                <div class="row">

                    @foreach (var imageUrl in Model.ImageUrls)
                    {
                        <div class="col-6 mb-3">

                            <img src="@imageUrl"
                                 alt="@Model.Name"
                                 class="img-fluid rounded room-thumbnail"
                                 onclick="changeMainImage('@imageUrl')"
                                 style="width: 100%;
                            height: 150px;
                            object-fit: cover;
                            cursor: pointer;
                            border: 2px solid transparent;" />

                        </div>
                    }

                </div>

                <small class="text-muted">
                    Click an image to view it larger.
                </small>
            }
            else
            {
                <div class="border rounded p-4 text-center">

                    <span class="text-muted">
                        No gallery images available.
                    </span>

                </div>
            }

        </div>

    </div>


    <!-- ========================= -->
    <!-- ROOM INFORMATION -->
    <!-- ========================= -->
    <div class="card">

        <div class="card-body">

            <h4 class="mb-4">
                Room Information
            </h4>


            <div class="row">

                <div class="col-md-6">

                    <p>
                        <strong>Room Number:</strong>
                        @Model.RoomNumber
                    </p>

                    <p>
                        <strong>Room Type:</strong>
                        @Model.RoomType
                    </p>

                    <p>
                        <strong>Capacity:</strong>
                        @Model.Capacity guest(s)
                    </p>

                </div>


                <div class="col-md-6">

                    <p>
                        <strong>Price Per Night:</strong>
                        @Model.PricePerNight.ToString("0.00") AZN
                    </p>

                    <p>
                        <strong>Hotel Id:</strong>
                        @Model.HotelId
                    </p>

                </div>

            </div>


            <!-- ========================= -->
            <!-- DESCRIPTION -->
            <!-- ========================= -->
            <hr />

            <div class="mt-4">

                <h5>
                    Description
                </h5>

                <p class="mt-3">
                    @Model.Description
                </p>

            </div>


            <!-- ========================= -->
            <!-- AMENITIES -->
            <!-- ========================= -->
            <hr />

            <div class="mt-4 mb-4">

                <h5>
                    Amenities
                </h5>

                @if (Model.AmenityNames != null &&
                     Model.AmenityNames.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mt-3">

                        @foreach (var amenity in Model.AmenityNames)
                        {
                            <span class="badge bg-light text-dark border p-2">
                                ✓ @amenity
                            </span>
                        }

                    </div>
                }
                else
                {
                    <p class="text-muted mt-2">
                        No amenities available.
                    </p>
                }

            </div>

            <!-- ========================= -->
            <!-- ACTIONS -->
            <!-- ========================= -->
            <hr />

            <div class="mt-4">

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">
                        Edit Room
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back
                    </a>
                }
                else
                {
                    @if (ViewBag.CheckInDate != null &&
                         ViewBag.CheckOutDate != null &&
                         ViewBag.AdultCount != null &&
                         ViewBag.ChildrenCount != null)
                    {
                        <a asp-controller="Bookings"
                           asp-action="Create"
                           asp-route-roomId="@Model.Id"
                           asp-route-checkInDate="@(((DateTime)ViewBag.CheckInDate).ToString("yyyy-MM-dd"))"
                           asp-route-checkOutDate="@(((DateTime)ViewBag.CheckOutDate).ToString("yyyy-MM-dd"))"
                           asp-route-adultCount="@ViewBag.AdultCount"
                           asp-route-childrenCount="@ViewBag.ChildrenCount"
                           class="btn btn-success">
                            Book Now
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Bookings"
                           asp-action="Create"
                           asp-route-roomId="@Model.Id"
                           class="btn btn-success">
                            Book Now
                        </a>
                    }

                    <a asp-action="Search"
                       class="btn btn-secondary">
                        Back to Search
                    </a>
                }

            </div>

@section Scripts {

    <script>

        function changeMainImage(imageUrl) {

            const mainImage =
                document.getElementById("mainRoomImage");

            if (mainImage) {
                mainImage.src = imageUrl;
            }

        }

    </script>

}
@model HotelTravel.Application.DTOs.Rooms.RoomSearchDto
@using System.Text.Json

@{
    ViewData["Title"] = "Search Rooms";

    var fullyBookedDates =
        ViewBag.FullyBookedDates as List<string>
        ?? new List<string>();
}

<div class="container mt-5 mb-5">

    <h2 class="mb-4">Search Available Rooms</h2>

    <form asp-controller="Rooms"
          asp-action="Search"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <!-- CHECK IN -->
        <div class="mb-3">

            <label class="form-label">
                Check-in Date
            </label>

            <input type="text"
                   id="checkInDate"
                   name="CheckInDate"
                   class="form-control"
                   placeholder="Select check-in date"
                   autocomplete="off"
                   required />
            <div class="calendar-info">
                <span></span>
                Fully booked dates cannot be selected.
            </div>

        </div>

        <!-- CHECK OUT -->
        <div class="mb-3">

            <label class="form-label">
                Check-out Date
            </label>

            <input type="text"
                   id="checkOutDate"
                   name="CheckOutDate"
                   class="form-control"
                   placeholder="Select check-out date"
                   autocomplete="off"
                   required />

        </div>

        <!-- ADULTS -->
        <div class="mb-3">

            <label asp-for="AdultCount"
                   class="form-label">
                Adults
            </label>

            <select asp-for="AdultCount"
                    class="form-control">

                <option value="1">1 Adult</option>
                <option value="2">2 Adults</option>
                <option value="3">3 Adults</option>
                <option value="4">4 Adults</option>

            </select>

        </div>

        <!-- CHILDREN -->
        <div class="mb-3">

            <label asp-for="ChildrenCount"
                   class="form-label">
                Children
            </label>

            <select asp-for="ChildrenCount"
                    class="form-control">

                <option value="0">0 Children</option>
                <option value="1">1 Child</option>
                <option value="2">2 Children</option>
                <option value="3">3 Children</option>
                <option value="4">4 Children</option>

            </select>

        </div>

        <button type="submit"
                class="btn btn-primary">
            Search Rooms
        </button>

    </form>

</div>

<style>
    /* Fully booked / disabled days */
    .flatpickr-day.flatpickr-disabled {
        color: #999 !important;
        background-color: #eeeeee !important;
        text-decoration: line-through;
        cursor: not-allowed !important;
    }

        .flatpickr-day.flatpickr-disabled:hover {
            background-color: #eeeeee !important;
        }

    .calendar-info {
        margin-top: 10px;
        font-size: 14px;
        color: #aaa;
    }

        .calendar-info span {
            display: inline-block;
            width: 14px;
            height: 14px;
            background-color: #eeeeee;
            border: 1px solid #999;
            margin-right: 6px;
            vertical-align: middle;
        }
</style>
@section Scripts {

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            // Backend-dən gələn tam dolu tarixlər
            const fullyBookedDates =
                        @Html.Raw(JsonSerializer.Serialize(fullyBookedDates));


            // CHECK OUT
            const checkOutCalendar =
                flatpickr("#checkOutDate", {

                    dateFormat: "Y-m-d",

                    altInput: true,

                    altFormat: "d F Y",

                    minDate: new Date().fp_incr(1),

                    disable: fullyBookedDates,

                    allowInput: false

                });


            // CHECK IN
            flatpickr("#checkInDate", {

                dateFormat: "Y-m-d",

                altInput: true,

                altFormat: "d F Y",

                minDate: "today",

                disable: fullyBookedDates,

                allowInput: false,

                onChange: function(selectedDates) {

                    if (selectedDates.length === 0) {
                        return;
                    }

                    const minimumCheckOut =
                        new Date(selectedDates[0]);

                    minimumCheckOut.setDate(
                        minimumCheckOut.getDate() + 1
                    );

                    checkOutCalendar.set(
                        "minDate",
                        minimumCheckOut
                    );

                    checkOutCalendar.clear();

                    checkOutCalendar.open();
                }

            });

        });

    </script>
}
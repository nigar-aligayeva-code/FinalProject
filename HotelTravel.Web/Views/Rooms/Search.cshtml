@model HotelTravel.Application.DTOs.Rooms.RoomSearchDto
@using System.Text.Json

@{
    ViewData["Title"] = "Search Rooms";

    var fullyBookedDates =
        ViewBag.FullyBookedDates as List<string>
        ?? new List<string>();
}

<div class="container mt-5 mb-5">

    <h2 class="mb-4">Search Available Rooms</h2>

    <form asp-controller="Rooms"
          asp-action="Search"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <!-- CHECK IN -->
        <div class="mb-3">

            <label class="form-label">
                Check-in Date
            </label>

            <input type="text"
                   id="checkInDate"
                   name="CheckInDate"
                   class="form-control"
                   placeholder="Select check-in date"
                   autocomplete="off"
                   required />

            <div class="calendar-info">

                <div class="calendar-info-item">
                    <span class="past-date-example"></span>
                    Past date
                </div>

                <div class="calendar-info-item">
                    <span class="fully-booked-example"></span>
                    Fully booked
                </div>

            </div>

        </div>

        <!-- CHECK OUT -->
        <div class="mb-3">

            <label class="form-label">
                Check-out Date
            </label>

            <input type="text"
                   id="checkOutDate"
                   name="CheckOutDate"
                   class="form-control"
                   placeholder="Select check-out date"
                   autocomplete="off"
                   required />

        </div>

        <!-- ADULTS -->
        <div class="mb-3">

            <label asp-for="AdultCount"
                   class="form-label">
                Adults
            </label>

            <select asp-for="AdultCount"
                    class="form-control">

                <option value="1">1 Adult</option>
                <option value="2">2 Adults</option>
                <option value="3">3 Adults</option>
                <option value="4">4 Adults</option>

            </select>

        </div>

        <!-- CHILDREN -->
        <div class="mb-3">

            <label asp-for="ChildrenCount"
                   class="form-label">
                Children
            </label>

            <select asp-for="ChildrenCount"
                    class="form-control">

                <option value="0">0 Children</option>
                <option value="1">1 Child</option>
                <option value="2">2 Children</option>
                <option value="3">3 Children</option>
                <option value="4">4 Children</option>

            </select>

        </div>

        <button type="submit"
                class="btn btn-primary">
            Search Rooms
        </button>

    </form>

</div>

<style>

    /* ============================= */
    /* PAST DATES                    */
    /* ============================= */

    .flatpickr-day.flatpickr-disabled {
        color: #b5b5b5 !important;
        background-color: #f5f5f5 !important;
        cursor: not-allowed !important;
    }

        .flatpickr-day.flatpickr-disabled:hover {
            background-color: #f5f5f5 !important;
        }


    /* ============================= */
    /* FULLY BOOKED DATES            */
    /* ============================= */

    .flatpickr-day.fully-booked-date {
        color: #b02a37 !important;
        background-color: #f8d7da !important;
        border-color: #f5c2c7 !important;
        text-decoration: line-through;
        font-weight: 600;
        cursor: not-allowed !important;
    }

        .flatpickr-day.fully-booked-date:hover {
            color: #b02a37 !important;
            background-color: #f8d7da !important;
        }


    /* ============================= */
    /* CALENDAR INFORMATION          */
    /* ============================= */

    .calendar-info {
        display: flex;
        gap: 20px;
        margin-top: 10px;
        font-size: 14px;
        color: #777;
    }

    .calendar-info-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .calendar-info-item span {
            display: inline-block;
            width: 14px;
            height: 14px;
            border-radius: 3px;
        }

    .past-date-example {
        background-color: #f5f5f5;
        border: 1px solid #b5b5b5;
    }

    .fully-booked-example {
        background-color: #f8d7da;
        border: 1px solid #b02a37;
    }

</style>


@section Scripts {

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            // Backend-dən gələn tam dolu tarixlər
            const fullyBookedDates =
                        @Html.Raw(JsonSerializer.Serialize(fullyBookedDates));


            // Tarixi YYYY-MM-DD formatına çevirir
            function formatDate(date) {

                const year =
                    date.getFullYear();

                const month =
                    String(date.getMonth() + 1)
                        .padStart(2, "0");

                const day =
                    String(date.getDate())
                        .padStart(2, "0");

                return `${year}-${month}-${day}`;
            }


            // Fully booked günlərə ayrıca class verir
            function markFullyBookedDates(
                dayElement,
                date
            ) {

                const formattedDate =
                    formatDate(date);

                if (fullyBookedDates.includes(
                    formattedDate
                )) {

                    dayElement.classList.add(
                        "fully-booked-date"
                    );

                    dayElement.title =
                        "Fully booked";
                }
            }


            // CHECK OUT
            // CHECK OUT
            const checkOutCalendar =
                flatpickr("#checkOutDate", {

                    dateFormat: "Y-m-d",

                    altInput: true,

                    altFormat: "d F Y",

                    minDate:
                        new Date().fp_incr(1),

                    allowInput: false,

                    onDayCreate:
                        function(
                            dObj,
                            dStr,
                            fp,
                            dayElem
                        ) {

                            markFullyBookedDates(
                                dayElem,
                                dayElem.dateObj
                            );
                        }

                });


            // CHECK IN
            flatpickr("#checkInDate", {

                dateFormat: "Y-m-d",

                altInput: true,

                altFormat: "d F Y",

                minDate: "today",

                disable:
                    fullyBookedDates,

                allowInput: false,

                onDayCreate:
                    function(
                        dObj,
                        dStr,
                        fp,
                        dayElem
                    ) {

                        markFullyBookedDates(
                            dayElem,
                            dayElem.dateObj
                        );
                    },

                onChange:
                    function(selectedDates) {

                        if (selectedDates.length === 0) {
                            return;
                        }

                        const minimumCheckOut =
                            new Date(
                                selectedDates[0]
                            );

                        minimumCheckOut.setDate(
                            minimumCheckOut.getDate() + 1
                        );

                        checkOutCalendar.set(
                            "minDate",
                            minimumCheckOut
                        );

                        checkOutCalendar.clear();

                        checkOutCalendar.open();
                    }

            });

        });

    </script>
}
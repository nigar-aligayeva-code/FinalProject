@model List<HotelTravel.Application.DTOs.Rooms.GetRoomDto>

@{
    ViewData["Title"] = "Rooms";
}

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Rooms</h2>

        <a asp-controller="Rooms"
           asp-action="Create"
           class="btn btn-primary">
            Add New Room
        </a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No rooms have been added yet.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Image</th>
                    <th>Room Number</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Capacity</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var room in Model)
                {
                    <tr>

                        <td>
                            @if (!string.IsNullOrEmpty(room.MainImage))
                            {
                                <img src="@room.MainImage"
                                     alt="@room.Name"
                                     width="100" />
                            }
                        </td>

                        <td>@room.RoomNumber</td>

                        <td>@room.Name</td>

                        <td>@room.RoomType</td>

                        <td>@room.Capacity</td>

                        <td>@room.PricePerNight.ToString("0.00")</td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@room.Id"
                               class="btn btn-info btn-sm">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@room.Id"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@room.Id"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>
                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>
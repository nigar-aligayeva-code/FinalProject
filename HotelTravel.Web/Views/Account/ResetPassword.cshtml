@model HotelTravel.Application.DTOs.Auth.ResetPasswordDto

@{
    ViewData["Title"] = "Choose a new password";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="text-center mb-2">@T["Choose a new password"]</h2>
                    <p class="text-center text-muted mb-4">for <strong>@Model.Email</strong></p>

                    <form asp-controller="Account" asp-action="ResetPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">@T["New password"]</label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">@T["Confirm new password"]</label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <p class="small text-muted">@T["At least 6 characters, with an uppercase letter, a lowercase letter and a digit."]</p>

                        <button type="submit" class="btn btn-primary w-100">@T["Save new password"]</button>
                    </form>

                    <p class="text-center mt-3 mb-0">
                        <a asp-controller="Account" asp-action="ForgotPassword">@T["Request a new link"]</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

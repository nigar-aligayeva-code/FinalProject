@model HotelTravel.Application.DTOs.Account.RegisterDto

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="text-center mb-4">
                        @T["Create Account"]
                    </h2>

                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="FirstName"
                                   class="form-label">
                                @T["First Name"]
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   placeholder="@T["Enter your first name"]" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName"
                                   class="form-label">
                                @T["Last Name"]
                            </label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   placeholder="@T["Enter your last name"]" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label">
                                @T["Email"]
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="@T["Enter your email"]"
                                   data-check-url="@Url.Action("CheckEmail", "Account")" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                            <!-- Canlı yoxlama: yazı səhvi / birdəfəlik e-poçt / poçt serveri -->
                            <div id="emailHint" class="small mt-1" hidden></div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password"
                                   class="form-label">
                                @T["Password"]
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="@T["Enter password"]" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                                @T["Confirm Password"]
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   placeholder="@T["Confirm password"]" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            @T["Register"]
                        </button>

                    </form>

                    <div class="text-center mt-3">
                        @T["Already have an account?"]

                        <a asp-controller="Account"
                           asp-action="Login">
                            @T["Login"]
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // E-poçt yazılıb sahədən çıxanda server yoxlayır: "gmial.com" -> "gmail.com?" təklifi,
        // birdəfəlik (temp-mail) və poçt serveri olmayan domenlər üçün xəbərdarlıq
        (function () {
            const input = document.getElementById('Email');
            const hint = document.getElementById('emailHint');
            if (!input || !hint) return;

            let last = '';

            input.addEventListener('blur', async () => {
                const email = input.value.trim();
                if (!email || email === last || !email.includes('@@')) return;
                last = email;

                try {
                    const response = await fetch(input.dataset.checkUrl + '?email=' + encodeURIComponent(email));
                    const r = await response.json();

                    hint.hidden = false;
                    hint.innerHTML = '';

                    if (!r.isValid) {
                        hint.className = 'small mt-1 text-danger';
                        hint.textContent = r.reason || '';
                    } else if (r.suggestion) {
                        hint.className = 'small mt-1 text-warning-emphasis';
                    } else {
                        hint.className = 'small mt-1 text-success';
                        hint.textContent = '✓';
                    }

                    // "Did you mean ...?" -> klik edəndə düzəlt
                    if (r.suggestion) {
                        const link = document.createElement('a');
                        link.href = '#';
                        link.textContent = ' ' + r.didYouMean;
                        link.addEventListener('click', e => {
                            e.preventDefault();
                            input.value = r.suggestion;
                            hint.hidden = true;
                            last = '';
                        });
                        hint.appendChild(link);
                    }
                } catch {
                    hint.hidden = true;
                }
            });
        })();
    </script>
}
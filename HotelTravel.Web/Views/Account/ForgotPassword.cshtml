@model HotelTravel.Application.DTOs.Auth.ForgotPasswordDto

@{
    ViewData["Title"] = "Forgot password";
    var sent = TempData["ResetSent"] as string;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="text-center mb-2">Forgot your password?</h2>
                    <p class="text-center text-muted mb-4">
                        Enter your email and we'll send you a link to choose a new password.
                    </p>

                    @if (sent != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-envelope-check me-1"></i> @sent
                            <div class="small mt-1">The link is valid for 24 hours. Check your spam folder too.</div>
                        </div>
                    }

                    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="you@example.com" autofocus />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Send reset link</button>
                    </form>

                    <p class="text-center mt-3 mb-0">
                        <a asp-controller="Account" asp-action="Login">Back to sign in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@model HotelTravel.Application.DTOs.Auth.ForgotPasswordDto
@inject HotelTravel.Web.Services.BotGuard BotGuard

@{
    ViewData["Title"] = "Forgot password";
    var sent = TempData["ResetSent"] as string;
    var sentTo = TempData["ResetEmail"] as string;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="text-center mb-2">@T["Forgot your password?"]</h2>
                    <p class="text-center text-muted mb-4">
                        @T["Enter your email and we'll send you a link to choose a new password."]
                    </p>

                    @if (sent != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-envelope-check me-1"></i> @T[sent]
                            @if (!string.IsNullOrWhiteSpace(sentTo))
                            {
                                <div class="mt-1">@T["Address you entered:"] <strong>@sentTo</strong></div>
                            }
                            <div class="small mt-1">@T["The link is valid for 24 hours. Check your spam folder too."]</div>
                            <div class="small mt-1">@T["No email after a few minutes? Check that the address is spelled correctly and try again."]</div>
                        </div>
                    }

                    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @* Bot qoruması: açılma vaxtı (şifrəli) + insanın görmədiyi sahə *@
                        <input type="hidden" name="@HotelTravel.Web.Services.BotGuard.TimeField" value="@BotGuard.Issue()" />
                        <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden" aria-hidden="true">
                            <label>Website <input type="text" name="@HotelTravel.Web.Services.BotGuard.HoneypotField" tabindex="-1" autocomplete="off" /></label>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">@T["Email"]</label>
                            <input asp-for="Email" class="form-control" placeholder="you@example.com" autofocus />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">@T["Send reset link"]</button>
                    </form>

                    <p class="text-center mt-3 mb-0">
                        <a asp-controller="Account" asp-action="Login">@T["Back to sign in"]</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@model HotelTravel.Application.DTOs.Availability.HotelAvailabilityDto
@using HotelTravel.Application.Services
@{
    // Partnyor (Partner) və admin (Admin) eyni paneli istifadə edir.
    // Stillər bu faylın içindədir ki, hər iki layout-da eyni görünsün.
    var area = ViewData["AvArea"] as string ?? "Partner";
    var isAdmin = area == "Admin";
    var today = DateTime.Today;
    var culture = System.Globalization.CultureInfo.CurrentUICulture;

    // Eyni anda "bütün otaqlar" üçün bağlanan tarixlər bir sətirdə göstərilir
    var blockGroups = Model.Blocks
        .GroupBy(b => new { b.StartDate, b.EndDate, Reason = b.Reason ?? "" })
        .OrderBy(g => g.Key.StartDate)
        .ToList();
}

<div class="pv">

    <!-- TƏZƏLİK -->
    <section class="pv-card pv-hero">
        <div class="pv-hero-icon"><i class="bi bi-shield-check"></i></div>
        <div class="pv-hero-text">
            <h3>@T["Is our availability up to date?"]</h3>
            <p>@T["We do not see bookings you take on other sites or at the reception. Close those dates below and confirm here after each check."]</p>
            <partial name="_FreshnessBadge" model="Model.AvailabilityUpdatedAt" />
        </div>
        <form asp-area="@area" asp-controller="Availability" asp-action="MarkUpToDate" method="post" class="pv-hero-action">
            @if (isAdmin)
            {
                <input type="hidden" name="hotelId" value="@Model.HotelId" />
            }
            <button type="submit" class="pv-btn pv-btn-green">
                <i class="bi bi-check2-circle"></i> @T["I checked — availability is correct"]
            </button>
        </form>
    </section>

    <!-- BOŞ OLMAYAN TARİXLƏR -->
    <section class="pv-card">
        <div class="pv-head">
            <div class="pv-head-icon red"><i class="bi bi-calendar-x"></i></div>
            <div>
                <h3>@T["Unavailable dates"]</h3>
                <p>@T["Rooms sold elsewhere, under renovation or kept for the hotel. Closed rooms are hidden from search for these dates."]</p>
            </div>
        </div>

        <form asp-area="@area" asp-controller="Availability" asp-action="AddBlock" method="post" class="pv-form">
            @if (isAdmin)
            {
                <input type="hidden" name="hotelId" value="@Model.HotelId" />
            }
            <label>
                <span>@T["Room"]</span>
                <select name="RoomId">
                    <option value="">@T["All rooms of the hotel"]</option>
                    @foreach (var room in Model.Rooms)
                    {
                        <option value="@room.Id">@room.RoomNumber · @room.Name</option>
                    }
                </select>
            </label>
            <label>
                <span>@T["From"]</span>
                <input type="date" name="StartDate" value="@today.ToString("yyyy-MM-dd")" min="@today.ToString("yyyy-MM-dd")" required />
            </label>
            <label>
                <span>@T["Until (check-out day)"]</span>
                <input type="date" name="EndDate" value="@today.AddDays(1).ToString("yyyy-MM-dd")" min="@today.AddDays(1).ToString("yyyy-MM-dd")" required />
            </label>
            <label class="pv-grow">
                <span>@T["Reason (optional)"]</span>
                <input type="text" name="Reason" maxlength="200" placeholder="@T["e.g. Sold on Booking.com"]" />
            </label>
            <button type="submit" class="pv-btn pv-btn-dark">
                <i class="bi bi-slash-circle"></i> @T["Mark as unavailable"]
            </button>
        </form>

        @if (blockGroups.Any())
        {
            <div class="pv-blocks">
                @foreach (var g in blockGroups)
                {
                    var first = g.First();
                    var nights = (g.Key.EndDate.Date - g.Key.StartDate.Date).Days;
                    var allRooms = g.Count() > 1 && g.Count() >= Model.Rooms.Count;

                    <div class="pv-block">
                        <div class="pv-block-date">
                            <b>@g.Key.StartDate.ToString("dd MMM", culture)</b>
                            <i class="bi bi-arrow-right"></i>
                            <b>@g.Key.EndDate.ToString("dd MMM yyyy", culture)</b>
                            <small>@T.Plural(nights, "night", "nights")</small>
                        </div>
                        <div class="pv-block-rooms">
                            @if (allRooms)
                            {
                                <span class="pv-chip pv-chip-all"><i class="bi bi-building"></i> @T["All rooms ({0})", g.Count()]</span>
                            }
                            else
                            {
                                foreach (var b in g)
                                {
                                    <span class="pv-chip">@b.RoomNumber · @b.RoomName</span>
                                }
                            }
                            @if (!string.IsNullOrWhiteSpace(g.Key.Reason))
                            {
                                <span class="pv-reason"><i class="bi bi-chat-left-text"></i> @g.Key.Reason</span>
                            }
                        </div>
                        <form asp-area="@area" asp-controller="Availability" asp-action="RemoveBlock" method="post" class="pv-block-action">
                            @if (isAdmin)
                            {
                                <input type="hidden" name="hotelId" value="@Model.HotelId" />
                            }
                            @foreach (var b in g)
                            {
                                <input type="hidden" name="ids" value="@b.Id" />
                            }
                            <button type="submit" class="pv-btn pv-btn-outline">
                                <i class="bi bi-arrow-counterclockwise"></i> @T["Make available again"]
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="pv-empty"><i class="bi bi-check2-all"></i> @T["No closed dates. All rooms are open for booking."]</div>
        }
    </section>

    <!-- OTAQLAR VƏ QİYMƏTLƏR -->
    <section class="pv-card">
        <div class="pv-head">
            <div class="pv-head-icon gold"><i class="bi bi-door-open"></i></div>
            <div>
                <h3>@T["Rooms and prices"]</h3>
                <p>@T["New bookings use the new price. Existing bookings keep their price."]</p>
            </div>
        </div>

        <div class="pv-rooms">
            @foreach (var room in Model.Rooms)
            {
                <div class="pv-room">
                    <div class="pv-room-num">@room.RoomNumber</div>
                    <div class="pv-room-info">
                        <b>@room.Name</b>
                        <small>@T.Enum(room.RoomType) · @T["Up to {0}", room.Capacity] · @T["Upcoming bookings"]: @room.UpcomingBookings</small>
                    </div>
                    <div>
                        @if (room.ClosedToday)
                        {
                            <span class="pv-pill pv-pill-closed">@T["Unavailable today"]</span>
                        }
                        else
                        {
                            <span class="pv-pill pv-pill-open">@T["Available today"]</span>
                        }
                    </div>
                    <form asp-area="@area" asp-controller="Availability" asp-action="UpdatePrice" method="post" class="pv-price">
                        @if (isAdmin)
                        {
                            <input type="hidden" name="hotelId" value="@Model.HotelId" />
                        }
                        <input type="hidden" name="roomId" value="@room.Id" />
                        <div class="pv-price-input">
                            <input type="number" name="pricePerNight" min="1" max="100000" step="0.01"
                                   value="@room.PricePerNight.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   aria-label="@T["Price per night (AZN)"]" />
                            <span>AZN</span>
                        </div>
                        <button type="submit" class="pv-btn pv-btn-outline pv-btn-sm">@T["Save"]</button>
                    </form>
                </div>
            }
        </div>
    </section>
</div>

<style>
    .pv { display: grid; gap: 18px; font-size: 15px; color: #1F2421; }
    .pv-card { background: #fff; border: 1px solid #ebe5da; border-radius: 20px; padding: 22px 24px; box-shadow: 0 6px 18px rgba(31,36,33,.04); }
    .pv h3 { font-size: 19px; font-weight: 700; margin: 0 0 4px; }
    .pv p { color: #6b7280; font-size: 14px; margin: 0 0 10px; }

    .pv-hero { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; background: linear-gradient(135deg, #f6faf4, #fff); }
    .pv-hero-icon { width: 54px; height: 54px; border-radius: 16px; background: #e3f1dd; color: #2f6b3a; display: grid; place-items: center; font-size: 26px; flex-shrink: 0; }
    .pv-hero-text { flex: 1; min-width: 260px; }
    .pv-hero-action { margin: 0; }

    .pv-head { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 14px; }
    .pv-head-icon { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; font-size: 20px; flex-shrink: 0; }
    .pv-head-icon.red { background: #fde8e8; color: #b42318; }
    .pv-head-icon.gold { background: #f7efd9; color: #8a6d2b; }

    .pv-btn { display: inline-flex; align-items: center; gap: 8px; border: 1px solid transparent; border-radius: 999px; padding: 10px 18px; font-size: 14px; font-weight: 700; cursor: pointer; text-decoration: none; transition: background .15s, transform .1s; white-space: nowrap; line-height: 1.2; }
    .pv-btn:active { transform: translateY(1px); }
    .pv-btn-dark { background: #1F2421; color: #fff; }
    .pv-btn-dark:hover { background: #374038; }
    .pv-btn-green { background: #2f7d46; color: #fff; }
    .pv-btn-green:hover { background: #276a3b; }
    .pv-btn-outline { background: #fff; color: #1F2421; border-color: #d9d2c5; }
    .pv-btn-outline:hover { background: #f7f4ee; }
    .pv-btn-sm { padding: 7px 14px; font-size: 13px; }

    .pv-form { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; background: #faf8f4; border-radius: 14px; padding: 14px; }
    .pv-form label { display: grid; gap: 5px; font-size: 12px; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: .03em; }
    .pv-form input, .pv-form select { border: 1px solid #e2dbcf; border-radius: 12px; padding: 9px 12px; font-size: 14px; background: #fff; color: #1F2421; min-height: 40px; }
    .pv-grow { flex: 1; min-width: 200px; }

    .pv-blocks { display: grid; gap: 10px; margin-top: 16px; }
    .pv-block { display: grid; grid-template-columns: 230px 1fr auto; gap: 14px; align-items: center; border: 1px solid #f2d6d3; background: #fffafa; border-left: 4px solid #d1504a; border-radius: 14px; padding: 12px 16px; }
    .pv-block-date { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .pv-block-date small { width: 100%; color: #9ca3af; font-size: 12px; }
    .pv-block-rooms { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .pv-chip { background: #f3f0ea; border-radius: 999px; padding: 4px 10px; font-size: 13px; font-weight: 600; }
    .pv-chip-all { background: #1F2421; color: #fff; }
    .pv-reason { color: #6b7280; font-size: 13px; margin-left: 4px; }
    .pv-block-action { margin: 0; }

    .pv-rooms { display: grid; gap: 8px; }
    .pv-room { display: grid; grid-template-columns: 64px 1fr auto auto; gap: 14px; align-items: center; padding: 10px 12px; border-radius: 14px; border: 1px solid #f0ebe2; }
    .pv-room:hover { background: #fcfbf8; }
    .pv-room-num { font-weight: 800; font-size: 16px; background: #f3f0ea; border-radius: 10px; text-align: center; padding: 8px 4px; }
    .pv-room-info { display: grid; gap: 2px; min-width: 0; }
    .pv-room-info small { color: #6b7280; font-size: 13px; }
    .pv-price { display: flex; gap: 8px; align-items: center; margin: 0; }
    .pv-price-input { display: flex; align-items: center; border: 1px solid #e2dbcf; border-radius: 12px; overflow: hidden; background: #fff; }
    .pv-price-input input { border: 0; width: 100px; padding: 7px 10px; font-size: 14px; font-weight: 700; outline: none; }
    .pv-price-input span { padding: 0 10px; color: #6b7280; font-size: 12px; font-weight: 700; background: #faf8f4; align-self: stretch; display: grid; place-items: center; }

    .pv-pill { font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; white-space: nowrap; }
    .pv-pill-open { background: #dcfce7; color: #166534; }
    .pv-pill-closed { background: #fee2e2; color: #b91c1c; }
    .pv-empty { margin-top: 14px; padding: 16px; text-align: center; color: #2f6b3a; background: #f3f8f1; border-radius: 14px; font-weight: 600; }

    @@media (max-width: 860px) {
        .pv-block { grid-template-columns: 1fr; }
        .pv-room { grid-template-columns: 56px 1fr; }
        .pv-room > div:nth-child(3), .pv-price { grid-column: 2; }
    }
</style>

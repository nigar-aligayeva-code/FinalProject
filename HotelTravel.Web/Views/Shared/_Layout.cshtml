    .account-user {
        color: white;
        font-size: 14px;
    }

    .account-link {
        color: white;
        background: transparent;
        border: none;
        padding: 0;
        font-size: 14px;
        text-decoration: none;
        cursor: pointer;
    }

    .account-link:hover {
        color: #d6c6a5;
    }

    .account-separator {
        color: white;
    }

    .logout-form {
        margin: 0;
        padding: 0;
        display: inline;
    }

@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    // Brend adı appsettings.json -> "Brand:Name" dəyərindən gəlir
    var brand = Config["Brand:Name"] ?? "Tripio";

    // Seçilmiş interfeys dili (en / az / ru)
    var uiLang = HotelTravel.Application.Services.LanguageRules.Normalize(
        System.Globalization.CultureInfo.CurrentUICulture.Name);
}
<!DOCTYPE html>
<html lang="@uiLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(T[ViewData["Title"]?.ToString() ?? ""]) - @brand</title>

    <!-- Dark mode: səhifə çəkilməmişdən əvvəl tətbiq olunur (ağ "yanıb-sönmə" olmasın) -->
    <script>
        (function () {
            var theme = null;
            try { theme = localStorage.getItem('tripio-theme'); } catch (e) { }
            if (!theme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
            if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        })();
    </script>

    <link rel="icon"
          type="image/png"
          sizes="56x56"
          href="~/assets/images/fav-icon/icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" />

    <!-- Vendor -->
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/css/all.min.css" />
    <link rel="stylesheet" href="~/assets/css/bootstrap-icons.css" />
    <!-- Amenity ikonları (flaticon-wifi və s.) üçün -->
    <link rel="stylesheet" href="~/assets/css/flaticon.css" />

    <!-- Site theme -->
    <link rel="stylesheet" href="~/css/hotelhub-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/compare.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-mode.css" asp-append-version="true" />
    <style>
        /* Dil seçimi (JS-siz, <details> ilə) */
        .hh-lang-menu { position: relative; }
        .hh-lang-btn { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 10px; border: 1px solid rgba(255,255,255,.25); border-radius: 6px; color: #fff; font-weight: 600; font-size: 14px; }
        .hh-lang-btn::-webkit-details-marker { display: none; }
        .hh-lang-btn:hover { background: rgba(255,255,255,.1); }
        .hh-lang-list { position: absolute; right: 0; top: calc(100% + 8px); min-width: 190px; background: #fff; border-radius: 14px; box-shadow: 0 18px 40px rgba(31,36,33,.2); padding: 6px; z-index: 2000; }
        .hh-lang-list a { display: flex; gap: 10px; align-items: center; padding: 8px 10px; border-radius: 10px; color: #1F2421; font-weight: 600; font-size: 14px; text-decoration: none; }
        .hh-lang-list a:hover { background: #F3EEE5; }
        .hh-lang-list a.active { background: #e6efe3; color: #2f4a2b; }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-auth="@(User.Identity?.IsAuthenticated == true ? "1" : "0")"
      data-login-url="@Url.Action("Login", "Account", new { area = "" })"
      data-wishlist-url="@Url.Action("Toggle", "Wishlist", new { area = "" })">

    <!-- AJAX sorğuları (ürək düyməsi) üçün antiforgery token -->
    <form id="hhAntiforgery" class="d-none">@Html.AntiForgeryToken()</form>

    @{
        var currentController =
            ViewContext.RouteData.Values["controller"]?.ToString();

        var isAuthenticated =
            User.Identity != null && User.Identity.IsAuthenticated;

        var isAdmin = User.IsInRole("Admin");

        // Admin / otel işçisi rezervasiya etmir: qonaq menyusu (🔔, Saxlananlar, Səfərlər) göstərilmir
        var isStaff = HotelTravel.Web.Filters.GuestOnlyAttribute.IsStaff(User);

        // Ad varsa adı, yoxdursa email göstərilir (profil yenilənəndə dərhal dəyişir)
        var firstName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;

        var userName = !string.IsNullOrWhiteSpace(firstName)
            ? firstName
            : User.Identity?.Name ?? "";

        var initial = string.IsNullOrEmpty(userName)
            ? "?"
            : userName.Substring(0, 1).ToUpper();

        // Seçilmiş avatar (yoxdursa baş hərf göstərilir)
        var avatarUrl = HotelTravel.Application.Services.AvatarCatalog.GetUrl(
            User.FindFirst(HotelTravel.Web.Services.AuthClaimTypes.Avatar)?.Value);

        // Booking-style xidmət tab-ı aktivdirmi?
        var currentService = ViewData["Service"] as string;

        var isStays =
            currentService == null &&
            (currentController == "Home" ||
             currentController == "Rooms" ||
             currentController == "Bookings" ||
             currentController == "Reviews");

        string ServiceTab(string service) =>
            currentService == service ? "hh-tab active" : "hh-tab";
    }

    <!-- ============================= -->
    <!-- HEADER -->
    <!-- ============================= -->
    <header class="hh-header">
        <div class="container">

            <div class="hh-topbar">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="hh-logo"
                   aria-label="@brand home">
                    <span class="hh-logo-mark"><i class="bi bi-hexagon-fill"></i></span>
                    <span class="hh-logo-text">@brand</span>
                </a>

                <div class="hh-actions">

                    <!-- DİL SEÇİMİ -->
                    <details class="hh-lang-menu">
                        <summary class="hh-lang-btn" title="@T["Language"]">
                            <i class="bi bi-translate"></i>
                            <span>@uiLang.ToUpperInvariant()</span>
                        </summary>
                        <div class="hh-lang-list">
                            @foreach (var lang in HotelTravel.Application.Services.LanguageRules.Languages)
                            {
                                <a asp-area="" asp-controller="Language" asp-action="Set"
                                   asp-route-culture="@lang.Code"
                                   asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                   class="@(lang.Code == uiLang ? "active" : "")">
                                    <span class="no-dark-invert">@lang.Flag</span> @lang.Label
                                </a>
                            }
                        </div>
                    </details>

                    <!-- DARK MODE -->
                    <button type="button" class="hh-theme-toggle" id="themeToggle" title="@T["Dark mode"]" aria-label="@T["Dark mode"]">
                        <i class="bi bi-moon-stars"></i>
                    </button>

                    <!-- VALYUTA SEÇİMİ (yalnız göstəriş; ödəniş AZN-dədir) -->
                    <div class="hh-currency-menu" id="currencyMenu" data-no-currency>
                        <button type="button" class="hh-currency" id="currencyBtn" title="@T["Change currency"]">
                            <span>AZN</span> <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="hh-currency-list" id="currencyList" hidden>
                            <div class="hh-currency-head">
                                <b>@T["Currency"]</b>
                                <small id="currencyUpdated"></small>
                            </div>
                            <button type="button" data-code="AZN"><b>₼</b> AZN <small>Azerbaijani manat</small></button>
                            <button type="button" data-code="USD"><b>$</b> USD <small>US dollar</small></button>
                            <button type="button" data-code="EUR"><b>€</b> EUR <small>Euro</small></button>
                            <button type="button" data-code="TRY"><b>₺</b> TRY <small>Turkish lira</small></button>
                            <button type="button" data-code="GEL"><b>₾</b> GEL <small>Georgian lari</small></button>
                            <button type="button" data-code="AED"><b>د.إ</b> AED <small>UAE dirham</small></button>
                            <p class="hh-currency-foot">@T["You always pay in AZN. Other currencies are shown for convenience."]</p>
                        </div>
                    </div>

                    <a asp-area=""
                       asp-controller="Bookings"
                       asp-action="Find"
                       class="hh-btn hh-btn-ghost"
                       title="@T["Find my booking"]">
                        <i class="bi bi-ticket-perforated"></i>
                        <span class="d-none d-lg-inline">@T["Find booking"]</span>
                    </a>

                    @if (isAuthenticated)
                    {
                        @if (User.IsInRole("HotelPartner"))
                        {
                            <a asp-area="Partner"
                               asp-controller="Dashboard"
                               asp-action="Index"
                               class="hh-btn hh-btn-ghost"
                               title="@T["Hotel partner panel"]">
                                <i class="bi bi-building-check"></i>
                                <span class="d-none d-md-inline">@T["Hotel panel"]</span>
                            </a>
                        }

                        @if (isAdmin)
                        {
                            <a asp-area="Admin"
                               asp-controller="Dashboard"
                               asp-action="Index"
                               class="hh-btn hh-btn-ghost"
                               title="Admin Panel">
                                <i class="bi bi-speedometer2"></i>
                                <span class="d-none d-md-inline">@T["Admin Panel"]</span>
                            </a>
                        }

                        @if (!isStaff)
                        {
                        @* BİLDİRİŞLƏR 🔔: təsdiq, rədd, ləğv, xatırlatmalar (bazada saxlanılır) *@
                        <div class="hh-notif-menu" id="notifMenu">
                            <button type="button" class="hh-btn hh-btn-ghost hh-notif-btn" id="notifBtn" title="@T["Notifications"]" aria-haspopup="true">
                                <i class="bi bi-bell"></i>
                                <span class="hh-notif-count" id="notifCount" hidden>0</span>
                            </button>
                            <div class="hh-notif-panel" id="notifPanel" hidden>
                                <div class="hh-notif-head">
                                    <b>@T["Notifications"]</b>
                                    <a asp-area="" asp-controller="Bookings" asp-action="MyBookings">@T["My bookings"]</a>
                                </div>
                                <div class="hh-notif-list" id="notifList">
                                    <div class="hh-notif-empty">@T["No notifications yet. Booking updates and reminders will appear here."]</div>
                                </div>
                            </div>
                        </div>

                        <a asp-area=""
                           asp-controller="Wishlist"
                           asp-action="Index"
                           class="hh-btn hh-btn-ghost"
                           title="@T["Saved"]">
                            <i class="bi bi-heart"></i>
                            <span class="d-none d-lg-inline">@T["Saved"]</span>
                        </a>

                        <a asp-area=""
                           asp-controller="Bookings"
                           asp-action="MyBookings"
                           class="hh-btn hh-btn-ghost"
                           title="@T["My bookings"]">
                            <i class="bi bi-briefcase"></i>
                            <span class="d-none d-xl-inline">@T["Trips"]</span>
                        </a>
                        }

                        <a asp-area=""
                           asp-controller="Profile"
                           asp-action="Index"
                           class="hh-user"
                           title="@T["My profile"]">
                            @if (avatarUrl != null)
                            {
                                <img class="hh-avatar" src="@avatarUrl" alt="" style="padding:0;object-fit:cover;" />
                            }
                            else
                            {
                                <span class="hh-avatar">@initial</span>
                            }
                            <span class="hh-user-text d-none d-sm-flex">
                                <strong>@userName</strong>
                                <small>@T["My profile"]</small>
                            </span>
                        </a>

                        <form asp-area=""
                              asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="m-0"
                              onsubmit="return confirm(this.dataset.confirm);"
                              data-confirm="@T["Are you sure you want to log out?"]">
                            <button type="submit"
                                    class="hh-btn hh-btn-ghost"
                                    title="@T["Log out"]">
                                <i class="bi bi-box-arrow-right"></i>
                                <span class="d-none d-md-inline">@T["Log out"]</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-area=""
                           asp-controller="Account"
                           asp-action="Register"
                           class="hh-btn hh-btn-light">
                            @T["Register"]
                        </a>

                        <a asp-area=""
                           asp-controller="Account"
                           asp-action="Login"
                           class="hh-btn hh-btn-light">
                            @T["Sign in"]
                        </a>
                    }
                </div>
            </div>

            <!-- TABS (Booking-style xidmətlər) -->
            <nav class="hh-tabs" aria-label="@T["Services"]">

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="@(isStays ? "hh-tab active" : "hh-tab")">
                    <i class="fa-solid fa-bed"></i>
                    @T["Stays"]
                </a>

                <a asp-area=""
                   asp-controller="Hotels"
                   asp-action="Index"
                   class="@(currentController == "Hotels" ? "hh-tab active" : "hh-tab")">
                    <i class="fa-solid fa-hotel"></i>
                    @T["Hotels"]
                </a>

                <a asp-area=""
                   asp-controller="Trips"
                   asp-action="Index"
                   class="@(currentController == "Trips" ? "hh-tab active" : "hh-tab")">
                    <i class="fa-solid fa-suitcase-rolling"></i>
                    @T["Packages"]
                </a>

                <a asp-area=""
                   asp-controller="Flights"
                   asp-action="Index"
                   class="@(currentController == "Flights" ? "hh-tab active" : "hh-tab")">
                    <i class="fa-solid fa-plane"></i>
                    @T["Flights"]
                </a>

                <a asp-area=""
                   asp-controller="Cars"
                   asp-action="Index"
                   class="@(currentController == "Cars" ? "hh-tab active" : "hh-tab")">
                    <i class="fa-solid fa-car"></i>
                    @T["Car rental"]
                </a>

                <a asp-area=""
                   asp-controller="Guide"
                   asp-action="Index"
                   class="@(currentController == "Guide" ? "hh-tab active" : "hh-tab")">
                    <i class="fa-solid fa-landmark"></i>
                    @T["Attractions"]
                </a>

                <a asp-area=""
                   asp-controller="Taxis"
                   asp-action="Index"
                   class="@(currentController == "Taxis" ? "hh-tab active" : "hh-tab")">
                    <i class="fa-solid fa-taxi"></i>
                    @T["Airport taxis"]
                </a>
            </nav>

        </div>
    </header>


    <!-- ============================= -->
    <!-- PAGE -->
    <!-- ============================= -->
    <main class="hh-main">
        @RenderBody()
    </main>


    <!-- ============================= -->
    <!-- FOOTER -->
    <!-- ============================= -->
    <footer class="hh-footer">
        <div class="container">

            <div class="row g-4">

                <div class="col-lg-4 col-md-6">
                    <div class="hh-logo hh-footer-brand">
                        <span class="hh-logo-mark"><i class="bi bi-hexagon-fill"></i></span>
                        <span class="hh-logo-text">@brand</span>
                    </div>

                    <p class="hh-footer-text">
                        @T["Search hotels, compare rooms and book your stay in a few clicks. Manage or cancel your reservations any time before check-in."]
                    </p>

                    @* Əlaqə və sosial şəbəkələr: appsettings.json -> "Brand" *@
                    <ul class="hh-footer-contact">
                        @if (!string.IsNullOrWhiteSpace(Config["Brand:Phone"]))
                        {
                            <li><i class="bi bi-telephone"></i> <a href="tel:@(new string(Config["Brand:Phone"]!.Where(ch => char.IsDigit(ch) || ch == '+').ToArray()))">@Config["Brand:Phone"]</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Config["Brand:Email"]))
                        {
                            <li><i class="bi bi-envelope"></i> <a href="mailto:@Config["Brand:Email"]">@Config["Brand:Email"]</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Config["Brand:Address"]))
                        {
                            <li><i class="bi bi-geo-alt"></i> @Config["Brand:Address"]</li>
                        }
                    </ul>

                    <div class="hh-socials">
                        @foreach (var (key, icon, label) in new[]
                        {
                            ("Instagram", "bi-instagram", "Instagram"),
                            ("Facebook", "bi-facebook", "Facebook"),
                            ("Telegram", "bi-telegram", "Telegram"),
                            ("WhatsApp", "bi-whatsapp", "WhatsApp")
                        })
                        {
                            var url = Config["Brand:" + key];
                            if (!string.IsNullOrWhiteSpace(url))
                            {
                                <a href="@url" target="_blank" rel="noopener" aria-label="@label" title="@label"><i class="bi @icon"></i></a>
                            }
                        }
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h4 class="hh-footer-title">@T["Explore"]</h4>
                    <ul class="hh-footer-links">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index">@T["Home"]</a></li>
                        <li><a asp-area="" asp-controller="Rooms" asp-action="Search">@T["Search rooms"]</a></li>
                        <li><a asp-area="" asp-controller="Hotels" asp-action="Index">@T["All hotels & map"]</a></li>
                        <li><a asp-area="" asp-controller="Trips" asp-action="Index">@T["Trip packages"]</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="destinations">@T["Destinations"]</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h4 class="hh-footer-title">@T["Your trips"]</h4>
                    <ul class="hh-footer-links">
                        <li><a asp-area="" asp-controller="Bookings" asp-action="Find">@T["Find my booking"]</a></li>

                        @if (isAuthenticated && !isStaff)
                        {
                            <li><a asp-area="" asp-controller="Bookings" asp-action="MyBookings">@T["My bookings"]</a></li>
                            <li><a asp-area="" asp-controller="Profile" asp-action="Index">@T["My profile"]</a></li>
                            <li><a asp-area="" asp-controller="Wishlist" asp-action="Index">@T["Saved rooms"]</a></li>
                        }
                        else if (isAuthenticated)
                        {
                            <li><a asp-area="" asp-controller="Profile" asp-action="Index">@T["My profile"]</a></li>
                        }
                        else
                        {
                            <li><a asp-area="" asp-controller="Account" asp-action="Login">@T["Sign in"]</a></li>
                            <li><a asp-area="" asp-controller="Account" asp-action="Register">@T["Create account"]</a></li>
                        }
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h4 class="hh-footer-title">@T["Good to know"]</h4>
                    <ul class="hh-footer-links hh-footer-facts">
                        <li><i class="bi bi-check2-circle"></i> @T["Request code right away, hotel confirms within 24 h"]</li>
                        <li><i class="bi bi-check2-circle"></i> @T["Free cancellation up to {0} days before check-in.", HotelTravel.Application.Services.CancellationPolicy.FreeHours / 24]</li>
                        <li><i class="bi bi-check2-circle"></i> @T["Reviews from real guests"]</li>
                    </ul>
                </div>
            </div>

            <div class="hh-footer-bottom">
                <span>© @DateTime.Now.Year @brand. @T["All rights reserved."]</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">@T["Privacy"]</a>
            </div>
        </div>
    </footer>


    <script src="~/assets/js/vendor/jquery-3.6.2.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="~/js/hotelhub.js" asp-append-version="true"></script>

    <!-- CANLI FƏALİYYƏT: "Someone just booked..." (anonim) -->
    <div class="live-activity" id="liveActivity" role="status" aria-live="polite">
        <span class="la-icon">✨</span>
        <span class="la-text" data-ago="@T["just now"]"></span>
        <button type="button" class="la-close" aria-label="Close">×</button>
    </div>
    <style>
        .live-activity { position: fixed; left: 20px; bottom: 20px; z-index: 1500; display: flex; align-items: center; gap: 12px; max-width: 360px; background: #fff; color: #1F2421; border-radius: 16px; padding: 12px 14px; box-shadow: 0 18px 40px rgba(31,36,33,.18); border-left: 4px solid #52614e; opacity: 0; transform: translateY(20px); pointer-events: none; transition: opacity .4s, transform .4s; }
        .live-activity.show { opacity: 1; transform: none; pointer-events: auto; }
        .la-icon { width: 36px; height: 36px; border-radius: 10px; background: #F3EEE5; display: grid; place-items: center; font-size: 18px; flex-shrink: 0; }
        .la-text { font-size: 14px; font-weight: 600; flex: 1; }
        .la-text::after { content: attr(data-ago); display: block; font-size: 11px; font-weight: 500; color: #6b7280; }
        .la-close { border: none; background: none; font-size: 20px; color: #9ca3af; line-height: 1; }

        /* Qonağın öz bildirişi: rezervasiya təsdiqi, xatırlatma (sağ altda, özü bağlanmır) */
        .hh-footer-contact { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 6px; font-size: 14px; }
        .hh-footer-contact i { margin-right: 6px; opacity: .8; }
        .hh-footer-contact a { color: inherit; text-decoration: none; }
        .hh-footer-contact a:hover { text-decoration: underline; }
        .hh-socials { display: flex; gap: 10px; margin-top: 14px; }
        .hh-socials a { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.1); color: #fff; font-size: 17px; text-decoration: none; transition: background .2s, transform .2s; }
        .hh-socials a:hover { background: #c9a24a; transform: translateY(-2px); }
        .guest-toast { position: fixed; right: 20px; bottom: 20px; z-index: 1600; display: flex; gap: 12px; align-items: flex-start; max-width: 380px; background: #fff; color: #1F2421; border-radius: 16px; padding: 14px 16px; box-shadow: 0 18px 40px rgba(31,36,33,.22); border-left: 4px solid #16834b; opacity: 0; transform: translateY(20px); pointer-events: none; transition: opacity .4s, transform .4s; }
        .guest-toast.show { opacity: 1; transform: none; pointer-events: auto; }
        .guest-toast.bad { border-left-color: #c33434; }
        .guest-toast.info { border-left-color: #d97706; }
        .guest-toast .gt-icon { font-size: 22px; line-height: 1; }
        .guest-toast .gt-text { font-size: 14px; font-weight: 600; flex: 1; }
        .guest-toast .gt-text a { display: block; font-size: 12px; font-weight: 700; color: #52614e; margin-top: 4px; }
        .guest-toast .gt-close { border: none; background: none; font-size: 20px; color: #9ca3af; line-height: 1; }

        /* 🔔 bildiriş paneli */
        .hh-notif-menu { position: relative; }
        .hh-notif-btn { position: relative; }
        .hh-notif-btn.ring i { animation: hhRing .8s ease; display: inline-block; }
        @@keyframes hhRing { 0%,100% { transform: rotate(0); } 20% { transform: rotate(18deg); } 40% { transform: rotate(-16deg); } 60% { transform: rotate(10deg); } 80% { transform: rotate(-6deg); } }
        .hh-notif-count { position: absolute; top: 2px; right: 2px; min-width: 18px; height: 18px; border-radius: 999px; background: #ef4444; color: #fff; font-size: 11px; font-weight: 700; display: grid; place-items: center; padding: 0 4px; line-height: 1; }
        .hh-notif-count[hidden] { display: none; }
        .hh-notif-panel { position: absolute; right: 0; top: calc(100% + 10px); width: 360px; max-width: calc(100vw - 32px); background: #fff; color: #1F2421; border: 1px solid #e7e0d4; border-radius: 16px; box-shadow: 0 20px 40px rgba(31,36,33,.18); z-index: 1700; overflow: hidden; }
        .hh-notif-panel[hidden] { display: none; }
        .hh-notif-head { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid #f1ece3; }
        .hh-notif-head a { font-size: 12px; font-weight: 700; color: #52614e; text-decoration: none; }
        .hh-notif-list { max-height: 400px; overflow-y: auto; }
        .hh-notif-empty { padding: 26px 16px; text-align: center; color: #9ca3af; font-size: 13px; }
        .hh-notif-item { display: flex; gap: 12px; padding: 12px 16px; border-bottom: 1px solid #f7f3ec; text-decoration: none; color: inherit; }
        .hh-notif-item:hover { background: #FBFAF7; color: inherit; }
        .hh-notif-item.unread { background: #f3f8f1; }
        .hh-notif-icon { width: 36px; height: 36px; border-radius: 10px; background: #F3EEE5; display: grid; place-items: center; font-size: 18px; flex-shrink: 0; }
        .hh-notif-body { display: grid; gap: 2px; min-width: 0; font-size: 13px; }
        .hh-notif-body em { font-size: 11px; color: #9ca3af; font-style: normal; }
    </style>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="guest-toast" id="guestToast" role="alert" aria-live="assertive">
            <span class="gt-icon">🔔</span>
            <div class="gt-text"><span></span><a href="#">@T["Open booking"]</a></div>
            <button type="button" class="gt-close" aria-label="Close">×</button>
        </div>
    }
    <script>
        // compare.js və digər skriptlər üçün tərcümələr
        window.tripioText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
        {
            ["compare"] = T["Compare"],
            ["added"] = T["Added to compare"],
            ["addRoom"] = T["Add room"],
            ["clear"] = T["Clear"],
            ["max"] = T["You can compare up to 3 rooms. Remove one first."],
            ["light"] = T["Light mode"],
            ["dark"] = T["Dark mode"],
            ["save"] = T["Save"],
            ["saved"] = T["Saved"],
            ["act_hotel"] = T["Someone just booked a stay in {0}"],
            ["act_hotel_any"] = T["Someone just booked a stay"],
            ["act_flight"] = T["Someone just booked a flight to {0}"],
            ["act_taxi"] = T["Someone just booked an airport taxi in {0}"],
            ["act_taxi_any"] = T["Someone just booked an airport taxi"],
            ["act_car"] = T["Someone just rented a car in {0}"],
            ["act_car_any"] = T["Someone just rented a car"],
            ["act_trip"] = T["Someone just booked a trip package to {0}"],
            // Qonağın öz bildirişləri: {0} = otel / şəhər, {1} = kod, {2} = tarix və ya saat
            ["g_requested"] = T["Your request {1} was sent to {0}. The hotel answers within 24 hours."],
            ["g_partner_request"] = T["New booking request {1} ({2}). Please confirm or reject within 24 hours."],
            ["g_expired"] = T["{0} did not answer in time. Request {1} was closed, nothing was charged."],
            ["g_confirmed"] = T["{0} confirmed your booking {1}. You can pay now."],
            ["g_cancelled_by_you"] = T["You cancelled booking {1} at {0}."],
            ["g_cancelled_by_you_fee"] = T["You cancelled booking {1} at {0}. Cancellation fee: {2} AZN."],
            ["g_flight_cancelled"] = T["You cancelled flight {1} to {0}."],
            ["g_flight_cancelled_fee"] = T["You cancelled flight {1} to {0}. Cancellation fee: {2} AZN."],
            ["notif_empty"] = T["No notifications yet. Booking updates and reminders will appear here."],
            ["g_rejected"] = T["{0} has no free room for your dates. Request {1} was declined."],
            ["g_cancelled"] = T["{0} cancelled your booking {1}. No fee is charged."],
            ["g_hotel_reminder"] = T["Reminder: your stay at {0} starts on {2}."],
            ["g_hotel_tomorrow"] = T["Your stay at {0} starts tomorrow. Check-in from 14:00."],
            ["g_flight_reminder"] = T["Reminder: your flight to {0} departs at {2} within 24 hours."],
            ["g_flight_soon"] = T["Your flight to {0} departs at {2}. Time to head to the airport!"]
        }));
        // Brauzer API-yə birbaşa qoşulur (SignalR, valyuta). Docker-də bu ünvan server ünvanından fərqlidir: Api:PublicUrl
        // Daxil olmuş istifadəçi token ilə qoşulur ki, öz bildirişlərini (təsdiq, xatırlatma) alsın
        window.tripioLive = {
            apiBase: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Config["Api:PublicUrl"] ?? Config["Api:BaseUrl"] ?? "").TrimEnd('/'))),
            token: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.Identity?.IsAuthenticated == true ? User.FindFirst(HotelTravel.Web.Services.AuthClaimTypes.AccessToken)?.Value ?? "" : ""))
        };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/live-activity.js" asp-append-version="true"></script>

    <!-- Seçilmiş valyutada göstərilir -->
    <div class="hh-currency-note" id="currencyNote" hidden data-no-currency>
        <i class="bi bi-info-circle"></i> @T["Prices converted from AZN · you pay in AZN"]
    </div>
    <style>
        .hh-currency-menu { position: relative; }
        .hh-currency { background: none; border: 1px solid rgba(255,255,255,.25); cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
        .hh-currency:hover { background: rgba(255,255,255,.1); }
        .hh-currency i { font-size: 11px; }
        .hh-currency-list { position: absolute; right: 0; top: calc(100% + 8px); width: 260px; background: #fff; border-radius: 14px; box-shadow: 0 18px 40px rgba(31,36,33,.2); padding: 8px; z-index: 2000; }
        .hh-currency-list[hidden] { display: none; }
        .hh-currency-head { display: flex; justify-content: space-between; align-items: center; padding: 6px 10px 8px; color: #1F2421; }
        .hh-currency-head small { color: #6b7280; font-size: 11px; }
        .hh-currency-list button[data-code] { display: flex; align-items: center; gap: 10px; width: 100%; border: none; background: none; text-align: left; padding: 8px 10px; border-radius: 10px; color: #1F2421; font-weight: 600; font-size: 14px; }
        .hh-currency-list button[data-code]:hover { background: #F3EEE5; }
        .hh-currency-list button[data-code].active { background: #e6efe3; color: #2f4a2b; }
        .hh-currency-list button[data-code]:disabled { opacity: .4; cursor: not-allowed; }
        .hh-currency-list button b { width: 30px; text-align: center; color: #52614e; }
        .hh-currency-list button small { margin-left: auto; color: #6b7280; font-weight: 400; font-size: 12px; }
        .hh-currency-foot { margin: 6px 10px 4px; font-size: 11px; color: #6b7280; }
        .hh-currency-note { position: fixed; right: 20px; bottom: 20px; z-index: 1400; background: #1F2421; color: #fff; border-radius: 999px; padding: 8px 14px; font-size: 12px; box-shadow: 0 10px 25px rgba(0,0,0,.2); }
        .hh-currency-note[hidden] { display: none; }
        @@media (max-width: 768px) { .hh-currency-menu { display: block; } .hh-currency { display: inline-flex !important; } }
    </style>
    <script src="~/js/currency.js" asp-append-version="true"></script>
    <script src="~/js/compare.js" asp-append-version="true"></script>

    <script>
        // Dark mode düyməsi (seçim brauzerdə yadda qalır)
        (function () {
            var root = document.documentElement;
            var button = document.getElementById('themeToggle');
            if (!button) return;

            function render() {
                var dark = root.getAttribute('data-theme') === 'dark';
                button.innerHTML = dark ? '<i class="bi bi-sun"></i>' : '<i class="bi bi-moon-stars"></i>';
                var text = window.tripioText || {};
                button.title = dark ? (text.light || 'Light mode') : (text.dark || 'Dark mode');
            }

            button.addEventListener('click', function () {
                var dark = root.getAttribute('data-theme') !== 'dark';

                root.classList.add('theme-transition');
                if (dark) root.setAttribute('data-theme', 'dark'); else root.removeAttribute('data-theme');
                setTimeout(function () { root.classList.remove('theme-transition'); }, 300);

                try { localStorage.setItem('tripio-theme', dark ? 'dark' : 'light'); } catch (e) { }
                render();
            });

            render();
        })();
    </script>

    <script src="~/js/date-limits.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (uiLang != "en")
    {
        <!-- Təqvim (flatpickr) ay və gün adları seçilmiş dildə (flatpickr-dan SONRA yüklənməlidir) -->
        <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/@(uiLang).js"></script>
    }

    <script>
        // flatpickr səhifədə varsa, DOMContentLoaded-dan əvvəl dili tətbiq edirik
        (function () {
            var lang = '@uiLang';
            if (lang !== 'en' && window.flatpickr && flatpickr.l10ns && flatpickr.l10ns[lang]) {
                flatpickr.localize(flatpickr.l10ns[lang]);
            }
        })();
    </script>

</body>
</html>

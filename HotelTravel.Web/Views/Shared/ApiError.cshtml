@{
    ViewData["Title"] = "Something went wrong";
}

<section class="hh-hero hh-hero-small">
    <div class="container">
        <h1><i class="bi bi-exclamation-triangle me-2"></i>@T["Something went wrong"]</h1>
        <p>@T["Your request could not be completed."]</p>
    </div>
</section>

<div class="container">
    <div class="hh-soon">
        <p class="mb-4">@(T[ViewData["ErrorMessage"]?.ToString() ?? ""])</p>
        <a href="javascript:history.back()" class="hh-btn hh-btn-outline">@T["Go back"]</a>
        <a asp-controller="Home" asp-action="Index" class="hh-btn hh-btn-primary">@T["Home"]</a>
    </div>
</div>

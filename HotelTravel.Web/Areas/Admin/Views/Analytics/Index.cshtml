@using System.Text.Json
@model HotelTravel.Application.DTOs.Analytics.AnalyticsDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Analytics";

    var labels = JsonSerializer.Serialize(Model.Monthly.Select(m => m.Label));
    var hotelsSeries = JsonSerializer.Serialize(Model.Monthly.Select(m => m.Hotels));
    var carsSeries = JsonSerializer.Serialize(Model.Monthly.Select(m => m.Cars));
    var taxisSeries = JsonSerializer.Serialize(Model.Monthly.Select(m => m.Taxis));
    var flightsSeries = JsonSerializer.Serialize(Model.Monthly.Select(m => m.Flights));

    var split = JsonSerializer.Serialize(new[] { Model.HotelRevenue, Model.CarRevenue, Model.TaxiRevenue, Model.FlightRevenue });

    var cityLabels = JsonSerializer.Serialize(Model.TopCities.Select(c => c.City));
    var cityRevenue = JsonSerializer.Serialize(Model.TopCities.Select(c => c.Revenue));
    var cityBookings = JsonSerializer.Serialize(Model.TopCities.Select(c => c.Bookings));

    string Money(decimal v) => v.ToString("N0") + " AZN";
}

<style>
    .an-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 26px; }
    .an-head h1 { margin: 0 0 6px; font-size: 28px; color: #0f172a; }
    .an-head p { margin: 0; color: #64748b; }
    .an-updated { color: #94a3b8; font-size: 13px; }

    .an-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-bottom: 22px; }
    .an-card, .an-panel { background: #fff; border: 1px solid #edf2f7; border-radius: 16px; padding: 22px; box-shadow: 0 5px 25px rgba(30, 41, 59, .04); }
    .an-card .lbl { color: #64748b; font-size: 13px; margin-bottom: 8px; }
    .an-card .val { font-size: 28px; font-weight: 750; color: #0f172a; }
    .an-card .sub { color: #94a3b8; font-size: 12px; margin-top: 6px; }
    .an-card.accent { background: linear-gradient(135deg, #1e3a8a, #2563eb); border: none; }
    .an-card.accent .lbl, .an-card.accent .sub { color: #bfdbfe; }
    .an-card.accent .val { color: #fff; }

    .an-panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-bottom: 22px; }
    .an-panel.wide { grid-column: 1 / -1; }
    .an-panel h3 { margin: 0 0 4px; font-size: 17px; color: #0f172a; }
    .an-panel p.hint { margin: 0 0 18px; color: #64748b; font-size: 13px; }
    .an-chart { position: relative; height: 300px; }

    .an-gauge { display: flex; align-items: center; gap: 22px; }
    .an-gauge .ring { width: 130px; height: 130px; border-radius: 50%; display: grid; place-items: center; flex-shrink: 0; }
    .an-gauge .ring span { width: 100px; height: 100px; border-radius: 50%; background: #fff; display: grid; place-items: center; font-size: 24px; font-weight: 750; color: #0f172a; }
    .an-kv { display: grid; gap: 10px; font-size: 14px; color: #334155; flex: 1; }
    .an-kv div { display: flex; justify-content: space-between; border-bottom: 1px dashed #e2e8f0; padding-bottom: 6px; }
    .an-kv b { color: #0f172a; }

    .an-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .an-table th { text-align: left; color: #64748b; font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; padding: 8px 6px; border-bottom: 1px solid #e2e8f0; }
    .an-table td { padding: 10px 6px; border-bottom: 1px solid #f1f5f9; color: #334155; }
    .an-table td.num { text-align: right; font-weight: 600; color: #0f172a; }
    .an-stars { color: #f59e0b; letter-spacing: 1px; }
    .an-empty { color: #94a3b8; font-size: 14px; padding: 12px 0; }

    @@media (max-width: 1100px) { .an-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 760px) { .an-grid, .an-panels { grid-template-columns: 1fr; } }
</style>

<div class="an-head">
    <div>
        <h1>Analytics</h1>
        <p>Revenue, occupancy and performance across hotels, cars, taxis and flights.</p>
    </div>
    <div class="an-updated">Updated @Model.GeneratedAt.ToString("dd MMM yyyy, HH:mm")</div>
</div>

<!-- ƏSAS RƏQƏMLƏR -->
<div class="an-grid">
    <div class="an-card accent">
        <div class="lbl">Total revenue</div>
        <div class="val">@Money(Model.TotalRevenue)</div>
        <div class="sub">@Model.TotalOrders orders in all services</div>
    </div>
    <div class="an-card">
        <div class="lbl">Average booking value</div>
        <div class="val">@Money(Model.AverageBookingValue)</div>
        <div class="sub">Hotel bookings, cancellations excluded</div>
    </div>
    <div class="an-card">
        <div class="lbl">Cancellation rate</div>
        <div class="val">@Model.CancellationRate%</div>
        <div class="sub">Out of @Model.HotelBookings hotel bookings</div>
    </div>
    <div class="an-card">
        <div class="lbl">Promo discounts given</div>
        <div class="val">@Money(Model.DiscountGiven)</div>
        <div class="sub">@Model.DiscountedBookings bookings used a promo code</div>
    </div>
</div>

<div class="an-panels">
    <!-- AYLIQ GƏLİR -->
    <div class="an-panel wide">
        <h3>Monthly revenue by service</h3>
        <p class="hint">Last 5 months and next 6 months (by stay, pickup or departure date).</p>
        <div class="an-chart"><canvas id="monthlyChart"></canvas></div>
    </div>

    <!-- GƏLİR PAYI -->
    <div class="an-panel">
        <h3>Revenue split</h3>
        <p class="hint">Share of each service in total revenue.</p>
        <div class="an-chart"><canvas id="splitChart"></canvas></div>
    </div>

    <!-- DOLULUQ -->
    <div class="an-panel">
        <h3>Occupancy forecast</h3>
        <p class="hint">Booked room-nights in the next 30 days.</p>
        @{
            var occ = Model.OccupancyNext30Days;
            var deg = (int)Math.Round(occ * 3.6m);
            var color = occ >= 70 ? "#16a34a" : occ >= 35 ? "#2563eb" : "#f59e0b";
        }
        <div class="an-gauge">
            <div class="ring" style="background: conic-gradient(@color @(deg)deg, #e2e8f0 0deg);">
                <span>@occ%</span>
            </div>
            <div class="an-kv">
                <div><span>Check-ins next 7 days</span><b>@Model.UpcomingCheckIns7Days</b></div>
                <div><span>Average stay</span><b>@Model.AverageStayNights nights</b></div>
                <div><span>Booked in advance</span><b>@Model.AverageLeadTimeDays days</b></div>
                <div><span>Cars / Taxis / Flights</span><b>@Model.CarRentals / @Model.TaxiBookings / @Model.FlightBookings</b></div>
            </div>
        </div>
    </div>

    <!-- ŞƏHƏRLƏR -->
    <div class="an-panel wide">
        <h3>Top cities</h3>
        <p class="hint">Hotel revenue and number of bookings per city.</p>
        @if (Model.TopCities.Any())
        {
            <div class="an-chart"><canvas id="citiesChart"></canvas></div>
        }
        else
        {
            <div class="an-empty">No bookings yet.</div>
        }
    </div>

    <!-- TOP OTAQLAR -->
    <div class="an-panel">
        <h3>Most booked rooms</h3>
        <p class="hint">Top 5 by number of bookings.</p>
        @if (Model.TopRooms.Any())
        {
            <table class="an-table">
                <thead><tr><th>Room</th><th>Hotel</th><th style="text-align:right">Bookings</th><th style="text-align:right">Revenue</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.TopRooms)
                    {
                        <tr>
                            <td>@r.RoomName</td>
                            <td>@r.HotelName</td>
                            <td class="num">@r.Bookings</td>
                            <td class="num">@Money(r.Revenue)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="an-empty">No bookings yet.</div>
        }
    </div>

    <!-- REYTİNQLƏR -->
    <div class="an-panel">
        <h3>Guest ratings by hotel</h3>
        <p class="hint">Average review score.</p>
        @if (Model.HotelRatings.Any())
        {
            <table class="an-table">
                <thead><tr><th>Hotel</th><th>City</th><th>Rating</th><th style="text-align:right">Reviews</th></tr></thead>
                <tbody>
                    @foreach (var h in Model.HotelRatings.Take(8))
                    {
                        var full = (int)Math.Round(h.AverageRating);
                        <tr>
                            <td>@h.HotelName</td>
                            <td>@h.City</td>
                            <td><span class="an-stars">@(new string('★', full))@(new string('☆', 5 - full))</span> @h.AverageRating</td>
                            <td class="num">@h.Reviews</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="an-empty">No reviews yet.</div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    const money = v => Number(v).toLocaleString() + ' AZN';
    const colors = { hotels: '#2563eb', cars: '#16a34a', taxis: '#f59e0b', flights: '#9333ea' };

    new Chart(document.getElementById('monthlyChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(labels),
            datasets: [
                { label: 'Hotels', data: @Html.Raw(hotelsSeries), backgroundColor: colors.hotels, borderRadius: 6 },
                { label: 'Cars', data: @Html.Raw(carsSeries), backgroundColor: colors.cars, borderRadius: 6 },
                { label: 'Taxis', data: @Html.Raw(taxisSeries), backgroundColor: colors.taxis, borderRadius: 6 },
                { label: 'Flights', data: @Html.Raw(flightsSeries), backgroundColor: colors.flights, borderRadius: 6 }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { tooltip: { callbacks: { label: c => c.dataset.label + ': ' + money(c.raw) } } },
            scales: {
                x: { stacked: true, grid: { display: false } },
                y: { stacked: true, beginAtZero: true, ticks: { callback: money } }
            }
        }
    });

    new Chart(document.getElementById('splitChart'), {
        type: 'doughnut',
        data: {
            labels: ['Hotels', 'Cars', 'Taxis', 'Flights'],
            datasets: [{
                data: @Html.Raw(split),
                backgroundColor: [colors.hotels, colors.cars, colors.taxis, colors.flights],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '62%',
            plugins: {
                legend: { position: 'bottom' },
                tooltip: { callbacks: { label: c => c.label + ': ' + money(c.raw) } }
            }
        }
    });

    const citiesCanvas = document.getElementById('citiesChart');
    if (citiesCanvas) {
        new Chart(citiesCanvas, {
            type: 'bar',
            data: {
                labels: @Html.Raw(cityLabels),
                datasets: [
                    { label: 'Revenue', data: @Html.Raw(cityRevenue), backgroundColor: colors.hotels, borderRadius: 6, yAxisID: 'y' },
                    { label: 'Bookings', data: @Html.Raw(cityBookings), type: 'line', borderColor: colors.taxis, backgroundColor: colors.taxis, tension: .3, yAxisID: 'y1' }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { callback: money } },
                    y1: { beginAtZero: true, position: 'right', grid: { display: false }, ticks: { precision: 0 } }
                }
            }
        });
    }
</script>

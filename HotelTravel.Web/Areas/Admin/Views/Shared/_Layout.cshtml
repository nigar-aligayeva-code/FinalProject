@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - HotelHub Admin</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: 'Segoe UI', Arial, sans-serif;
                background: #f4f7fc;
                color: #1e293b;
            }

            .sidebar {
                width: 250px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background: #101a32;
                padding: 30px 18px;
                color: white;
                overflow-y: auto;
            }

            .brand {
                font-size: 24px;
                font-weight: 750;
                margin-bottom: 45px;
                padding-left: 12px;
            }

                .brand span {
                    color: #60a5fa;
                }

            .menu-label {
                font-size: 11px;
                letter-spacing: 2px;
                color: #8796b5;
                margin: 0 12px 16px;
            }

            .sidebar a {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 14px 16px;
                margin-bottom: 8px;
                border-radius: 12px;
                color: #cbd5e1;
                text-decoration: none;
                font-size: 15px;
                transition: 0.2s;
            }

                .sidebar a:hover {
                    background: #243456;
                    color: white;
                }

                .sidebar a.active {
                    background: #2563eb;
                    color: white;
                    font-weight: 600;
                }

            .menu-icon {
                font-size: 19px;
                width: 24px;
                text-align: center;
            }

            .main-area {
                margin-left: 250px;
                min-height: 100vh;
            }

            .topbar {
                background: white;
                padding: 20px 35px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px solid #e5eaf3;
            }

            .topbar-title {
                font-size: 20px;
                font-weight: 700;
            }

            .admin-profile {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: #dbeafe;
                color: #2563eb;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
            }

            .content {
                padding: 35px;
            }

                .content h1 {
                    font-size: 28px;
                    margin-top: 0;
                }

                .content > p {
                    color: #64748b;
                }

            .admin-card {
                background: white;
                padding: 25px;
                border-radius: 16px;
                box-shadow: 0 5px 25px rgba(30, 41, 59, 0.04);
            }

            .admin-table {
                width: 100%;
                border-collapse: collapse;
            }

                .admin-table th {
                    background: #f1f5f9;
                    color: #475569;
                    font-size: 13px;
                    padding: 15px;
                    text-align: left;
                }

                .admin-table td {
                    padding: 15px;
                    border-bottom: 1px solid #edf0f5;
                }

            .btn-primary {
                display: inline-block;
                padding: 10px 18px;
                border: 0;
                border-radius: 9px;
                background: #2563eb;
                color: white;
                text-decoration: none;
                cursor: pointer;
            }

                .btn-primary:hover {
                    background: #1d4ed8;
                }

            @@media (max-width: 768px) {
                .sidebar {
                    width: 76px;
                    padding: 25px 10px;
                }

                .brand {
                    font-size: 14px;
                    padding-left: 0;
                }

                .menu-label, .menu-text {
                    display: none;
                }

                .sidebar a {
                    justify-content: center;
                    padding: 14px 8px;
                }

                .main-area {
                    margin-left: 76px;
                }

                .topbar, .content {
                    padding: 20px;
                }
            }
    </style>
</head>

<body>
    <aside class="sidebar">
        <div class="brand">
            Hotel<span>Hub</span>
        </div>

        <div class="menu-label">MAIN MENU</div>

        <nav>
            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="@(currentController == "Dashboard" ? "active" : "")">
                <span class="menu-icon">▦</span>
                <span class="menu-text">Dashboard</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Hotels"
               asp-action="Index"
               class="@(currentController == "Hotels" ? "active" : "")">
                <span class="menu-icon">⌂</span>
                <span class="menu-text">Hotels</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Rooms"
               asp-action="Index"
               class="@(currentController == "Rooms" ? "active" : "")">
                <span class="menu-icon">▤</span>
                <span class="menu-text">Rooms</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Bookings"
               asp-action="Index"
               class="@(currentController == "Bookings" ? "active" : "")">
                <span class="menu-icon">▣</span>
                <span class="menu-text">Bookings</span>
            </a>
        </nav>
    </aside>

    <div class="main-area">
        <header class="topbar">
            <div class="topbar-title">
                @ViewData["Title"]
            </div>

            <div class="admin-profile">
                <div>
                    <strong>Administrator</strong>
                    <div style="font-size:12px;color:#94a3b8;">
                        Admin Panel
                    </div>
                </div>
                <div class="avatar">A</div>
            </div>
        </header>

        <main class="content">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

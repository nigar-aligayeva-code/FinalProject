@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var brand = Config["Brand:Name"] ?? "Tripio";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    // Canlı bildirişlər: brauzer API-dəki SignalR hub-a admin token-i ilə qoşulur
    // Brauzerin görə bildiyi API ünvanı (Docker-də Api:PublicUrl, lokalda Api:BaseUrl)
    var liveApiBase = (Config["Api:PublicUrl"] ?? Config["Api:BaseUrl"] ?? "").TrimEnd('/');
    var liveToken = User.FindFirst(HotelTravel.Web.Services.AuthClaimTypes.AccessToken)?.Value ?? "";

    // Seçilmiş interfeys dili (en / az / ru)
    var uiLang = HotelTravel.Application.Services.LanguageRules.Normalize(
        System.Globalization.CultureInfo.CurrentUICulture.Name);

    // live-admin.js üçün tərcümələr
    var adminTexts = new[]
    {
        "🔊 Sound on", "🔇 Sound off", "💬 Pop-ups on", "🚫 Pop-ups off", "Open", "click to open",
        "reconnecting…", "live", "offline",
        "New hotel booking", "Booking cancelled", "New flight booking", "New airport taxi",
        "New car rental", "New trip package"
    }.ToDictionary(k => k, k => T[k].Value);
}

<!DOCTYPE html>
<html lang="@uiLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(T[ViewData["Title"]?.ToString() ?? ""]) - @brand Admin</title>
    <!-- İkonlar (bi bi-...) admin səhifələrində də işləsin -->
    <link rel="stylesheet" href="~/assets/css/bootstrap-icons.css" />

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: 'Segoe UI', Arial, sans-serif;
                background: #f4f7fc;
                color: #1e293b;
            }

            .sidebar {
                width: 250px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background: #101a32;
                padding: 30px 18px;
                color: white;
                overflow-y: auto;
            }

            .brand {
                font-size: 24px;
                font-weight: 750;
                margin-bottom: 45px;
                padding-left: 12px;
            }

                .brand span {
                    color: #60a5fa;
                }

            /* Sayta qayıtmaq / çıxış */
            .topbar-actions {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .topbar-btn {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 9px 14px;
                border-radius: 10px;
                border: 1px solid #e2e8f0;
                background: white;
                color: #334155;
                font-size: 14px;
                font-weight: 600;
                text-decoration: none;
                cursor: pointer;
            }

                .topbar-btn:hover {
                    background: #f1f5f9;
                    color: #0f172a;
                }

            .topbar-btn-danger {
                color: #b91c1c;
                border-color: #fecaca;
            }

                .topbar-btn-danger:hover {
                    background: #fee2e2;
                    color: #991b1b;
                }

            .sidebar .menu-site {
                margin-top: 24px;
                border-top: 1px solid rgba(255, 255, 255, .1);
                padding-top: 18px;
            }

            .menu-label {
                font-size: 11px;
                letter-spacing: 2px;
                color: #8796b5;
                margin: 0 12px 16px;
            }

            .sidebar a {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 14px 16px;
                margin-bottom: 8px;
                border-radius: 12px;
                color: #cbd5e1;
                text-decoration: none;
                font-size: 15px;
                transition: 0.2s;
            }

                .sidebar a:hover {
                    background: #243456;
                    color: white;
                }

                .sidebar a.active {
                    background: #2563eb;
                    color: white;
                    font-weight: 600;
                }

            .menu-icon {
                font-size: 19px;
                width: 24px;
                text-align: center;
            }

            .main-area {
                margin-left: 250px;
                min-height: 100vh;
            }

            .topbar {
                background: white;
                padding: 20px 35px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px solid #e5eaf3;
            }

            .topbar-title {
                font-size: 20px;
                font-weight: 700;
            }

            .admin-profile {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: #dbeafe;
                color: #2563eb;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
            }

            .content {
                padding: 35px;
            }

                .content h1 {
                    font-size: 28px;
                    margin-top: 0;
                }

                .content > p {
                    color: #64748b;
                }

            .admin-card {
                background: white;
                padding: 25px;
                border-radius: 16px;
                box-shadow: 0 5px 25px rgba(30, 41, 59, 0.04);
            }

            .admin-table {
                width: 100%;
                border-collapse: collapse;
            }

                .admin-table th {
                    background: #f1f5f9;
                    color: #475569;
                    font-size: 13px;
                    padding: 15px;
                    text-align: left;
                }

                .admin-table td {
                    padding: 15px;
                    border-bottom: 1px solid #edf0f5;
                }

            .btn-primary {
                display: inline-block;
                padding: 10px 18px;
                border: 0;
                border-radius: 9px;
                background: #2563eb;
                color: white;
                text-decoration: none;
                cursor: pointer;
            }

                .btn-primary:hover {
                    background: #1d4ed8;
                }

            @@media (max-width: 768px) {
                .sidebar {
                    width: 76px;
                    padding: 25px 10px;
                }

                .brand {
                    font-size: 14px;
                    padding-left: 0;
                }

                .menu-label, .menu-text {
                    display: none;
                }

                .sidebar a {
                    justify-content: center;
                    padding: 14px 8px;
                }

                .main-area {
                    margin-left: 76px;
                }

                .topbar, .content {
                    padding: 20px;
                }
            }
    </style>
</head>

<body>
    <aside class="sidebar">
        <div class="brand">
            @brand<span>.</span>
        </div>

        <div class="menu-label">@T["MAIN MENU"]</div>

        <nav>
            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="@(currentController == "Dashboard" ? "active" : "")">
                <span class="menu-icon">▦</span>
                <span class="menu-text">@T["Dashboard"]</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Analytics"
               asp-action="Index"
               class="@(currentController == "Analytics" ? "active" : "")">
                <span class="menu-icon">◔</span>
                <span class="menu-text">@T["Analytics"]</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Emails"
               asp-action="Index"
               class="@(currentController == "Emails" ? "active" : "")">
                <span class="menu-icon">✉</span>
                <span class="menu-text">@T["Emails"]</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Hotels"
               asp-action="Index"
               class="@(currentController == "Hotels" ? "active" : "")">
                <span class="menu-icon">⌂</span>
                <span class="menu-text">@T["Hotels"]</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Partners"
               asp-action="Index"
               class="@(currentController == "Partners" || currentController == "Availability" ? "active" : "")">
                <span class="menu-icon">🤝</span>
                <span class="menu-text">@T["Hotel partners"]</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Rooms"
               asp-action="Index"
               class="@(currentController == "Rooms" ? "active" : "")">
                <span class="menu-icon">▤</span>
                <span class="menu-text">@T["Rooms"]</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Bookings"
               asp-action="Index"
               class="@(currentController == "Bookings" ? "active" : "")">
                <span class="menu-icon">▣</span>
                <span class="menu-text">@T["Bookings"]</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Reviews"
               asp-action="Index"
               class="@(currentController == "Reviews" ? "active" : "")">
                <span class="menu-icon">★</span>
                <span class="menu-text">@T["Reviews"]</span>
            </a>

            <a asp-area="Admin"
               asp-controller="PromoCodes"
               asp-action="Index"
               class="@(currentController == "PromoCodes" ? "active" : "")">
                <span class="menu-icon">%</span>
                <span class="menu-text">@T["Promo Codes"]</span>
            </a>

            <a asp-area="Admin"
               asp-controller="CityGuide"
               asp-action="Index"
               class="@(currentController == "CityGuide" ? "active" : "")">
                <span class="menu-icon">⌖</span>
                <span class="menu-text">@T["City Guide"]</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Cars"
               asp-action="Index"
               class="@(currentController == "Cars" ? "active" : "")">
                <span class="menu-icon">⛟</span>
                <span class="menu-text">@T["Car Rental"]</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Taxis"
               asp-action="Index"
               class="@(currentController == "Taxis" ? "active" : "")">
                <span class="menu-icon">✈</span>
                <span class="menu-text">@T["Airport Taxis"]</span>
            </a>

            <a asp-area="Admin"
               asp-controller="Flights"
               asp-action="Index"
               class="@(currentController == "Flights" ? "active" : "")">
                <span class="menu-icon">✦</span>
                <span class="menu-text">@T["Flights"]</span>
            </a>

            <!-- Əsas sayta qayıt -->
            <a asp-area=""
               asp-controller="Home"
               asp-action="Index"
               class="menu-site">
                <span class="menu-icon">↗</span>
                <span class="menu-text">@T["View website"]</span>
            </a>
        </nav>
    </aside>

    <div class="main-area">
        <header class="topbar">
            <div class="topbar-title">
                @(T[ViewData["Title"]?.ToString() ?? ""])
            </div>

            <div class="topbar-actions">
                <!-- CANLI BİLDİRİŞLƏR -->
                <div class="live-bell" id="liveBell">
                    <button type="button" class="topbar-btn" id="liveBellBtn" title="@T["Live activity"]">
                        <span id="liveBellIcon">🔔</span> <span class="live-count" id="liveCount" hidden>0</span>
                    </button>
                    <div class="live-panel" id="livePanel" hidden>
                        <div class="live-panel-head">
                            <b>@T["Live activity"]</b>
                            <span class="live-status off" id="liveStatus">connecting…</span>
                        </div>
                        <div class="live-settings">
                            <button type="button" class="live-toggle" id="liveSoundToggle">@T["🔊 Sound on"]</button>
                            <button type="button" class="live-toggle" id="livePopupToggle">@T["💬 Pop-ups on"]</button>
                        </div>
                        <div class="live-list" id="liveList">
                            <div class="live-empty">@T["New bookings will appear here instantly."]</div>
                        </div>
                    </div>
                </div>

                <!-- DİL SEÇİMİ -->
                <div class="admin-lang">
                    @foreach (var lang in HotelTravel.Application.Services.LanguageRules.Languages)
                    {
                        <a asp-area="" asp-controller="Language" asp-action="Set"
                           asp-route-culture="@lang.Code"
                           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                           class="@(lang.Code == uiLang ? "active" : "")"
                           title="@lang.Label">@lang.Code.ToUpperInvariant()</a>
                    }
                </div>

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="topbar-btn">
                    @T["↗ View website"]
                </a>

                <form asp-area=""
                      asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      style="margin:0"
                      onsubmit="return confirm(this.dataset.confirm);"
                      data-confirm="@T["Are you sure you want to log out?"]">
                    <button type="submit" class="topbar-btn topbar-btn-danger">
                        @T["⎋ Logout"]
                    </button>
                </form>

            <div class="admin-profile">
                <div>
                    <strong>@T["Administrator"]</strong>
                    <div style="font-size:12px;color:#94a3b8;">
                        @T["Admin Panel"]
                    </div>
                </div>
                <div class="avatar">A</div>
            </div>
            </div>
        </header>

        <main class="content">
            @RenderBody()
        </main>
    </div>

    <div class="live-toasts" id="liveToasts"></div>

    <style>
        .live-bell { position: relative; }
        .live-bell .topbar-btn { position: relative; }
        .live-count { position: absolute; top: -6px; right: -6px; min-width: 18px; height: 18px; border-radius: 999px; background: #ef4444; color: #fff; font-size: 11px; font-weight: 700; display: grid; place-items: center; padding: 0 4px; }
        .live-count[hidden] { display: none; }
        .live-panel { position: absolute; right: 0; top: calc(100% + 10px); width: 360px; background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; box-shadow: 0 20px 40px rgba(15,23,42,.15); z-index: 1000; overflow: hidden; }
        .live-panel-head { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid #f1f5f9; color: #0f172a; }
        .live-status { font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; }
        .live-status::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
        .live-status.ok { color: #16a34a; } .live-status.off { color: #94a3b8; }
        .live-list { max-height: 380px; overflow-y: auto; }
        .live-empty { padding: 26px 16px; text-align: center; color: #94a3b8; font-size: 13px; }
        .live-item { display: flex; gap: 12px; padding: 12px 16px; border-bottom: 1px solid #f8fafc; text-decoration: none; color: inherit; }
        .live-item:hover { background: #f8fafc; }
        .live-icon { width: 36px; height: 36px; border-radius: 10px; background: #f1f5f9; display: grid; place-items: center; font-size: 18px; flex-shrink: 0; }
        .live-body { display: grid; gap: 2px; min-width: 0; }
        .live-body b { font-size: 13px; color: #0f172a; }
        .live-body small { font-size: 12px; color: #475569; }
        .live-body em { font-size: 11px; color: #94a3b8; font-style: normal; }
        .live-cancel .live-icon { background: #fee2e2; }
        .live-trip .live-icon { background: #ede9fe; }
        .live-toasts { position: fixed; right: 20px; bottom: 20px; display: grid; gap: 10px; z-index: 2000; width: 340px; }
        .live-toast { background: #fff; border-radius: 14px; box-shadow: 0 15px 35px rgba(15,23,42,.2); border-left: 4px solid #2563eb; animation: liveIn .35s ease; transition: opacity .5s, transform .5s; }
        .live-toast.live-cancel { border-left-color: #ef4444; }
        .live-toast.live-trip { border-left-color: #7c3aed; }
        .live-toast.hide { opacity: 0; transform: translateX(30px); }
        .ring { animation: liveRing .8s ease; }
        .live-settings { display: flex; gap: 8px; padding: 10px 16px; border-bottom: 1px solid #f1f5f9; background: #f8fafc; }
        .live-toggle { flex: 1; border: 1px solid #e2e8f0; background: #fff; border-radius: 999px; padding: 6px 10px; font-size: 12px; font-weight: 600; color: #0f172a; cursor: pointer; }
        .live-toggle.off { color: #94a3b8; background: #f1f5f9; }
        .live-highlight, .live-highlight > td { background: #fef9c3 !important; transition: background 1s; }
        .live-highlight { outline: 2px solid #facc15; outline-offset: -2px; }
        @@keyframes liveIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
        @@keyframes liveRing { 0%,100% { transform: rotate(0); } 20% { transform: rotate(-15deg); } 40% { transform: rotate(12deg); } 60% { transform: rotate(-8deg); } 80% { transform: rotate(5deg); } }
    </style>

    <style>
        .admin-lang { display: inline-flex; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
        .admin-lang a { padding: 7px 10px; font-size: 12px; font-weight: 700; color: #64748b; text-decoration: none; }
        .admin-lang a:hover { background: #f1f5f9; }
        .admin-lang a.active { background: #1F2421; color: #fff; }
    </style>
    <script>
        window.tripioAdminText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(adminTexts));
        window.tripioLive = {
            apiBase: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(liveApiBase)),
            token: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(liveToken))
        };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/live-admin.js" asp-append-version="true"></script>

    <script src="~/js/date-limits.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

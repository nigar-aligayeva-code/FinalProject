@model string
@* Model = hesabatın növü: bookings | flights | taxis | cars *@

<div class="export-buttons">
    <a asp-area="Admin" asp-controller="Exports" asp-action="Download"
       asp-route-type="@Model" asp-route-format="xlsx"
       class="export-btn export-btn-excel" title="Download as Excel">
        ⬇ Excel
    </a>
    <a asp-area="Admin" asp-controller="Exports" asp-action="Download"
       asp-route-type="@Model" asp-route-format="csv"
       class="export-btn" title="Download as CSV">
        ⬇ CSV
    </a>
</div>

<style>
    .export-buttons { display: inline-flex; gap: 8px; align-items: center; }
    .export-btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 14px; border-radius: 10px; border: 1px solid #e2e8f0; background: #fff; color: #0f172a; font-weight: 600; font-size: 14px; text-decoration: none; }
    .export-btn:hover { border-color: #16a34a; color: #16a34a; }
    .export-btn-excel { background: #16a34a; border-color: #16a34a; color: #fff; }
    .export-btn-excel:hover { background: #15803d; color: #fff; }
</style>

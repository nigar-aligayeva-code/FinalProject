@model HotelTravel.Application.DTOs.Availability.CreatePartnerDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Hotel partners";

    var partners = ViewBag.Partners as List<HotelTravel.Application.DTOs.Availability.PartnerAccountDto> ?? new();
    var hotels = ViewBag.Hotels as List<HotelTravel.Application.DTOs.Hotels.GetHotelDto> ?? new();
    var withPartner = partners.Select(p => p.HotelId).ToHashSet();
}

<div class="mb-3">
    <h1 style="font-size:28px;margin:0">@T["Hotel partners"]</h1>
    <p class="text-muted">@T["Hotel staff accounts. A partner sees only their own hotel: confirms or rejects requests, closes sold dates and updates prices."]</p>
</div>

@if (TempData["SuccessMessage"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5>@T["Partner accounts"]</h5>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@T["Hotel"]</th>
                                <th>@T["Name"]</th>
                                <th>@T["Email"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in partners)
                            {
                                <tr>
                                    <td>
                                        <a asp-area="Admin" asp-controller="Availability" asp-action="Index" asp-route-hotelId="@p.HotelId">@p.HotelName</a>
                                    </td>
                                    <td>@p.FullName</td>
                                    <td>@p.Email</td>
                                    <td class="text-end">
                                        <form asp-area="Admin" asp-controller="Partners" asp-action="Remove" method="post" class="m-0"
                                              onsubmit='return confirm(@Json.Serialize(T["Remove partner access for this account?"].Value));'>
                                            <input type="hidden" name="userId" value="@p.UserId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">@T["Remove access"]</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!partners.Any())
                            {
                                <tr><td colspan="4" class="text-muted text-center py-4">@T["No partner accounts yet."]</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body">
                <h5>@T["Hotels without a partner"]</h5>
                <p class="text-muted small">@T["For these hotels the admin confirms requests after calling the hotel."]</p>
                <ul class="mb-0">
                    @foreach (var h in hotels.Where(h => !withPartner.Contains(h.Id)))
                    {
                        <li>
                            @h.Name ·
                            <a asp-area="Admin" asp-controller="Availability" asp-action="Index" asp-route-hotelId="@h.Id">@T["Availability and prices"]</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5>@T["New partner account"]</h5>

                <form asp-area="Admin" asp-controller="Partners" asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="mb-2">
                        <label asp-for="HotelId" class="form-label">@T["Hotel"]</label>
                        <select asp-for="HotelId" class="form-select">
                            <option value="0">@T["Choose a hotel"]</option>
                            @foreach (var h in hotels)
                            {
                                <option value="@h.Id">@h.Name (@h.City)</option>
                            }
                        </select>
                        <span asp-validation-for="HotelId" class="text-danger small"></span>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col">
                            <label asp-for="FirstName" class="form-label">@T["First name"]</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col">
                            <label asp-for="LastName" class="form-label">@T["Last name"]</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Email" class="form-label">@T["Email"]</label>
                        <input asp-for="Email" class="form-control" placeholder="reception@hotel.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">@T["Password"]</label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">@T["At least 6 characters with an uppercase letter, a lowercase letter and a digit. Give it to the hotel privately."]</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-dark w-100">@T["Create partner account"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

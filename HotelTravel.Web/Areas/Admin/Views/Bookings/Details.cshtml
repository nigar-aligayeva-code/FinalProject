@model HotelTravel.Application.DTOs.Bookings.GetBookingDto
@using HotelTravel.Domain.Enums

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Booking Details";
    var statusClass = Model.Status switch
    {
        BookingStatus.Confirmed => "confirmed",
        BookingStatus.CheckedIn => "checkedin",
        BookingStatus.CheckedOut => "checkedout",
        BookingStatus.Cancelled => "cancelled",
        _ => "checkedout"
    };
    var fromDashboard =
    Context.Request.Query["returnTo"].ToString() == "dashboard";
    bool canCheckIn = Model.Status == BookingStatus.Confirmed && DateTime.Today >= Model.CheckInDate.Date;
    bool canCheckOut = Model.Status == BookingStatus.CheckedIn && DateTime.Today >= Model.CheckInDate.Date;
    bool canCancel = Model.Status == BookingStatus.Confirmed;
    int nights = Math.Max(0, (Model.CheckOutDate.Date - Model.CheckInDate.Date).Days);
}

<style>
    .bd-page {
        color: #101c34;
        max-width: 1300px;
        margin: 0 auto;
    }

    .bd-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .bd-eyebrow {
        font-size: 12px;
        letter-spacing: 1.7px;
        text-transform: uppercase;
        font-weight: 750;
        color: #64748b;
        margin-bottom: 7px;
    }

    .bd-title {
        font-size: 30px;
        letter-spacing: -.8px;
        font-weight: 800;
        margin: 0 0 9px;
    }

    .bd-sub {
        color: #64748b;
        font-size: 14px;
        margin: 0;
    }

    .bd-code {
        color: #2563eb;
        font-weight: 750;
    }

    .bd-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 9px 15px;
        font-size: 13px;
        font-weight: 750;
    }

        .bd-status::before {
            content: "";
            width: 8px;
            height: 8px;
            background: currentColor;
            border-radius: 50%;
        }

        .bd-status.confirmed {
            background: #e9f9ef;
            color: #16834b;
        }

        .bd-status.checkedin {
            background: #e9f1ff;
            color: #1d4ed8;
        }

        .bd-status.checkedout {
            background: #eef2f6;
            color: #475569;
        }

        .bd-status.cancelled {
            background: #fff0f0;
            color: #c33434;
        }

    .bd-summary {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        margin-bottom: 20px;
        overflow: hidden;
        box-shadow: 0 8px 28px rgba(15,23,42,.025);
    }

    .bd-stat {
        padding: 24px;
        min-width: 0;
        border-right: 1px solid #e9eef5;
    }

        .bd-stat:last-child {
            border-right: none;
        }

    .bd-stat-label {
        font-size: 12px;
        color: #64748b;
        font-weight: 650;
        margin-bottom: 11px;
    }

    .bd-stat-value {
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .bd-stat-note {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 7px;
    }

    .bd-grid {
        display: grid;
        grid-template-columns: minmax(0,1.2fr) minmax(0,1fr);
        gap: 20px;
    }

    .bd-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 8px 28px rgba(15,23,42,.025);
    }

    .bd-card-title {
        font-size: 17px;
        font-weight: 800;
        margin: 0 0 20px;
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .bd-icon {
        display: inline-flex;
        width: 37px;
        height: 37px;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #edf4ff;
        color: #2563eb;
        font-size: 19px;
    }

    .bd-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 21px 16px;
    }

    .bd-field-label {
        font-size: 12px;
        font-weight: 650;
        color: #64748b;
        margin-bottom: 7px;
    }

    .bd-field-value {
        font-size: 15px;
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .bd-management-note {
        background: #f8fafc;
        border: 1px solid #e8eef5;
        border-radius: 12px;
        padding: 15px;
        color: #64748b;
        font-size: 13px;
        line-height: 1.65;
    }

    .bd-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 18px;
    }

        .bd-actions form {
            flex: 1;
            min-width: 130px;
        }

    .bd-action {
        width: 100%;
        border: 0;
        border-radius: 11px;
        padding: 13px 15px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 750;
    }

        .bd-action.checkin {
            background: #2563eb;
            color: #fff;
        }

        .bd-action.checkout {
            background: #0f766e;
            color: #fff;
        }

        .bd-action.cancel {
            background: #fee2e2;
            color: #b91c1c;
        }

    .bd-back {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 12px 17px;
        border-radius: 11px;
        background: #e9eef6;
        color: #334155;
        text-decoration: none;
        font-size: 13px;
        font-weight: 750;
    }

        .bd-back:hover {
            background: #dce6f2;
        }

    .bd-alert {
        padding: 14px 17px;
        border-radius: 11px;
        margin-bottom: 20px;
        font-size: 14px;
    }

        .bd-alert.success {
            background: #dcfce7;
            color: #166534;
        }

        .bd-alert.error {
            background: #fee2e2;
            color: #991b1b;
        }

    @@media(max-width:1050px) {
        .bd-summary {
            grid-template-columns: repeat(2,1fr);
        }

        .bd-stat:nth-child(2) {
            border-right: 0;
        }

        .bd-stat:nth-child(-n+2) {
            border-bottom: 1px solid #e9eef5;
        }
    }

    @@media(max-width:780px) {
        .bd-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media(max-width:520px) {
        .bd-summary {
            grid-template-columns: 1fr;
        }

        .bd-stat {
            border-right: 0;
            border-bottom: 1px solid #e9eef5;
        }

            .bd-stat:last-child {
                border-bottom: 0;
            }

        .bd-info {
            grid-template-columns: 1fr;
        }

        .bd-title {
            font-size: 25px;
        }

        .bd-card {
            padding: 19px;
        }
    }
</style>

<div class="bd-page">
    <div class="bd-header">
        <div>
            <div class="bd-eyebrow">@T["Reservation overview"]</div>
            <h1 class="bd-title">@T["Booking Details"]</h1>
            <p class="bd-sub">@T["Confirmation"] <span class="bd-code">#@Model.ConfirmationCode</span></p>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px">
            <span class="bd-status @statusClass">@T.Enum(Model.Status)</span>
            @if (Model.PaymentStatus == HotelTravel.Domain.Enums.PaymentStatus.Paid)
            {
                <span style="font-size:12px;font-weight:700;color:#166534;background:#dcfce7;padding:3px 10px;border-radius:999px">💳 @T["Paid online"]</span>
            }
            else
            {
                <span style="font-size:12px;font-weight:700;color:#92400e;background:#fef3c7;padding:3px 10px;border-radius:999px">@T["Pay at the hotel"]</span>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bd-alert success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bd-alert error">@TempData["Error"]</div>
    }

    <div class="bd-summary">
        <div class="bd-stat">
            <div class="bd-stat-label">@T["Check-in"]</div>
            <div class="bd-stat-value">@Model.CheckInDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)</div>
            <div class="bd-stat-note">@T["Arrival date"]</div>
        </div>
        <div class="bd-stat">
            <div class="bd-stat-label">@T["Check-out"]</div>
            <div class="bd-stat-value">@Model.CheckOutDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)</div>
            <div class="bd-stat-note">@T["Departure date"]</div>
        </div>
        <div class="bd-stat">
            <div class="bd-stat-label">@T["Length of stay"]</div>
            <div class="bd-stat-value">@nights @(nights == 1 ? "night" : "nights")</div>
            <div class="bd-stat-note">@(Model.AdultCount + Model.ChildrenCount) total guests</div>
        </div>
        <div class="bd-stat">
            <div class="bd-stat-label">@T["Total amount"]</div>
            <div class="bd-stat-value">@Model.TotalPrice.ToString("0.00") AZN</div>
            <div class="bd-stat-note">
                @if (Model.DiscountAmount > 0)
                {
                    <span>@Model.OriginalPrice.ToString("0.00") AZN − @Model.DiscountAmount.ToString("0.00") AZN (@Model.DiscountNote)</span>
                }
                else
                {
                    <span>@T["Booking total"]</span>
                }
            </div>
        </div>
    </div>

    <div class="bd-grid">
        <div>
            <section class="bd-card">
                <h2 class="bd-card-title"><span class="bd-icon">♙</span> @T["Guest Information"]</h2>
                <div class="bd-info">
                    <div><div class="bd-field-label">@T["Full name"]</div><div class="bd-field-value">@Model.GuestName</div></div>
                    <div><div class="bd-field-label">@T["Email address"]</div><div class="bd-field-value">@Model.GuestEmail</div></div>
                    <div><div class="bd-field-label">@T["Adults"]</div><div class="bd-field-value">@Model.AdultCount</div></div>
                    <div><div class="bd-field-label">@T["Children"]</div><div class="bd-field-value">@Model.ChildrenCount</div></div>
                </div>
            </section>
            <section class="bd-card">
                <h2 class="bd-card-title"><span class="bd-icon">▣</span> @T["Room Information"]</h2>
                <div class="bd-info">
                    <div><div class="bd-field-label">@T["Room name"]</div><div class="bd-field-value">@Model.RoomName</div></div>
                    <div><div class="bd-field-label">@T["Room number"]</div><div class="bd-field-value">#@Model.RoomNumber</div></div>
                </div>
            </section>
        </div>
        <div>
            <section class="bd-card">
                <h2 class="bd-card-title"><span class="bd-icon">✓</span> @T["Booking Management"]</h2>
                <div class="bd-field-label">@T["Current status"]</div>
                <div style="margin:10px 0 18px"><span class="bd-status @statusClass">@T.Enum(Model.Status)</span></div>
                @if (canCheckIn || canCheckOut || canCancel)
                {
                    <div class="bd-management-note">@T["Choose an available action below to update the booking status."]</div>
                    <div class="bd-actions">
                        @if (canCheckIn)
                        {
                            <form asp-area="Admin" asp-controller="Bookings" asp-action="ChangeStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="@BookingStatus.CheckedIn" />
                                <button class="bd-action checkin" type="submit" onclick="return confirm('Check in this guest?');">@T["Check In"]</button>
                            </form>
                        }
                        @if (canCheckOut)
                        {
                            <form asp-area="Admin" asp-controller="Bookings" asp-action="ChangeStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="@BookingStatus.CheckedOut" />
                                <button class="bd-action checkout" type="submit" onclick="return confirm('Check out this guest?');">@T["Check Out"]</button>
                            </form>
                        }
                        @if (canCancel)
                        {
                            <form asp-area="Admin" asp-controller="Bookings" asp-action="ChangeStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="@BookingStatus.Cancelled" />
                                <button class="bd-action cancel" type="submit" onclick="return confirm('Are you sure you want to cancel this booking?');">@T["Cancel Booking"]</button>
                            </form>
                        }
                    </div>
                }
                else
                {
                    <div class="bd-management-note">@T["This reservation has no further status changes available."]</div>
                }
            </section>
            @if (fromDashboard)
            {
                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   asp-fragment="recent-bookings"
                   class="btn btn-secondary">
                    @T["← Back to Dashboard"]
                </a>
            }
            else
            {
                <a asp-area="Admin"
                   asp-controller="Bookings"
                   asp-action="Index"
                   class="btn btn-secondary">
                    @T["← Back to Bookings"]
                </a>
            }
        </div>
    </div>
</div>

@model List<HotelTravel.Application.DTOs.Flights.FlightRouteDto>
@using HotelTravel.Application.DTOs.Flights
@using HotelTravel.Application.Services
@using HotelTravel.Domain.Enums

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Flights";

    string? selectedCity = ViewBag.City as string;
    var status = ViewBag.Status as FlightBookingStatus?;
    var cities = ViewBag.Cities as List<string> ?? new List<string>();
    var bookings = ViewBag.Bookings as List<FlightBookingDto> ?? new List<FlightBookingDto>();

    string StatusClass(FlightBookingStatus s) => s switch
    {
        FlightBookingStatus.Confirmed => "cg-Food",
        FlightBookingStatus.Completed => "cg-Sight",
        _ => "cg-Shopping"
    };
}

<partial name="~/Areas/Admin/Views/CityGuide/_Styles.cshtml" />

<div class="cg-heading">
    <div>
        <h1>@T["Flights"]</h1>
        <p>@T["Daily flight schedule between hotel cities and guests' flight bookings."]</p>
        <p style="font-size:13px;color:#64748b;margin-top:4px">
            @T["Routes between hotel cities are created automatically when the API starts. You only edit prices or switch flights off."]
        </p>
    </div>

    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <partial name="_ExportButtons" model="@("flights")" />

        <!-- Reyslər əllə yaradılmır: şəbəkə avtomatik qurulur -->
        <form asp-area="Admin" asp-controller="Flights" asp-action="Generate" method="post" style="margin:0">
            <button type="submit" class="cg-btn" style="background:#52614e" title="@T["Create daily flights for every pair of hotel cities that has none yet."]">
                ✈ @T["Auto-generate missing routes"]
            </button>
        </form>

        @if (ViewBag.RealDataEnabled is true)
        {
            <form asp-area="Admin" asp-controller="Flights" asp-action="ImportReal" method="post" style="margin:0">
                <button type="submit" class="cg-btn" style="background:#1d4ed8" title="@T["Real flight numbers, airlines and times from AviationStack."]">
                    🌍 @T["Import real schedules"]
                </button>
            </form>
        }

        <a asp-area="Admin"
           asp-controller="Flights"
           asp-action="Edit"
           class="cg-btn">
            @T["+ Add flight"]
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="cg-alert cg-alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="cg-alert cg-alert-error">@TempData["ErrorMessage"]</div>
}

<!-- SCHEDULE -->
<div class="cg-chips">
    <a asp-area="Admin"
       asp-controller="Flights"
       asp-action="Index"
       class="cg-chip @(string.IsNullOrEmpty(selectedCity) ? "active" : "")">
        @T["All cities"]
    </a>

    @foreach (var city in cities)
    {
        <a asp-area="Admin"
           asp-controller="Flights"
           asp-action="Index"
           asp-route-city="@city"
           class="cg-chip @(string.Equals(city, selectedCity, StringComparison.OrdinalIgnoreCase) ? "active" : "")">
            @city
        </a>
    }
</div>

<div class="cg-card" style="margin-bottom:24px">
    <h2 style="font-size:18px;margin:0 0 16px;color:#0f172a">Schedule (@Model.Count)</h2>

    <div class="cg-table-wrap">
        <table class="cg-table">
            <thead>
                <tr>
                    <th>@T["Flight"]</th>
                    <th>@T["Route"]</th>
                    <th>@T["Daily at"]</th>
                    <th>@T["Economy"]</th>
                    <th>@T["Business"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["Action"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var route in Model)
                {
                    <tr>
                        <td>
                            <strong>@route.FlightNumber</strong>
                            <div class="cg-desc">@route.Airline</div>
                        </td>
                        <td>
                            @route.FromCity (@route.FromCode) → @route.ToCity (@route.ToCode)
                        </td>
                        <td style="white-space:nowrap">
                            @route.DepartureTime.ToString(@"hh\:mm")
                            <div class="cg-desc">@FlightRules.FormatDuration(route.DurationMinutes)</div>
                        </td>
                        <td style="white-space:nowrap">
                            @route.EconomyPrice.ToString("0") AZN
                            <div class="cg-desc">@route.EconomySeats seats</div>
                        </td>
                        <td style="white-space:nowrap">
                            @if (route.BusinessSeats > 0)
                            {
                                <span>@route.BusinessPrice.ToString("0") AZN</span>
                                <div class="cg-desc">@route.BusinessSeats seats</div>
                            }
                            else
                            {
                                <span class="cg-desc">—</span>
                            }
                        </td>
                        <td>
                            <span class="cg-badge @(route.IsActive ? "cg-Food" : "cg-Shopping")">
                                @(route.IsActive ? T["Active"] : T["Inactive"])
                            </span>
                        </td>
                        <td>
                            <div class="cg-actions">
                                <a asp-area="Admin"
                                   asp-controller="Flights"
                                   asp-action="Edit"
                                   asp-route-id="@route.Id"
                                   class="cg-edit">
                                    @T["Edit"]
                                </a>

                                <form asp-area="Admin"
                                      asp-controller="Flights"
                                      asp-action="Toggle"
                                      asp-route-id="@route.Id"
                                      asp-route-city="@selectedCity"
                                      method="post">
                                    <button type="submit" class="cg-edit">
                                        @(route.IsActive ? T["Deactivate"] : T["Activate"])
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="cg-empty">@T["No flights yet."]</div>
        }
    </div>
</div>

<!-- BOOKINGS -->
<div class="cg-chips">
    <a asp-area="Admin"
       asp-controller="Flights"
       asp-action="Index"
       asp-route-city="@selectedCity"
       class="cg-chip @(status == null ? "active" : "")">
        @T["All bookings"]
    </a>

    @foreach (var item in Enum.GetValues<FlightBookingStatus>())
    {
        <a asp-area="Admin"
           asp-controller="Flights"
           asp-action="Index"
           asp-route-city="@selectedCity"
           asp-route-status="@item"
           class="cg-chip @(status == item ? "active" : "")">
            @item
        </a>
    }
</div>

<div class="cg-card">
    <h2 style="font-size:18px;margin:0 0 16px;color:#0f172a">Bookings (@bookings.Count)</h2>

    <div class="cg-table-wrap">
        <table class="cg-table">
            <thead>
                <tr>
                    <th>@T["Reference"]</th>
                    <th>@T["Flight"]</th>
                    <th>@T["Departure"]</th>
                    <th>@T["Passengers"]</th>
                    <th>@T["Contact"]</th>
                    <th>@T["Total"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["Action"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in bookings)
                {
                    <tr>
                        <td><strong>@booking.ConfirmationCode</strong></td>
                        <td>
                            @booking.FlightNumber · @T.Enum(booking.Cabin)
                            <div class="cg-desc">@booking.FromCode → @booking.ToCode</div>
                        </td>
                        <td style="white-space:nowrap">
                            @booking.DepartureTime.ToString("dd MMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)
                            <div class="cg-desc">@booking.DepartureTime.ToString("HH:mm") → @booking.ArrivalTime.ToString("HH:mm")</div>
                        </td>
                        <td class="cg-desc">
                            @foreach (var name in booking.PassengerList)
                            {
                                <div>@name</div>
                            }
                        </td>
                        <td>
                            @booking.ContactName
                            <div class="cg-desc">@booking.Email · @booking.Phone</div>
                        </td>
                        <td style="white-space:nowrap">@booking.TotalPrice.ToString("0.00") AZN</td>
                        <td>
                            <span class="cg-badge @StatusClass(booking.Status)">@T.Enum(booking.Status)</span>
                        </td>
                        <td>
                            @if (booking.Status == FlightBookingStatus.Confirmed)
                            {
                                <div class="cg-actions">
                                    <form asp-area="Admin"
                                          asp-controller="Flights"
                                          asp-action="BookingStatus"
                                          asp-route-id="@booking.Id"
                                          asp-route-status="@FlightBookingStatus.Completed"
                                          asp-route-filter="@status"
                                          method="post">
                                        <button type="submit" class="cg-edit">@T["Complete"]</button>
                                    </form>

                                    <form asp-area="Admin"
                                          asp-controller="Flights"
                                          asp-action="BookingStatus"
                                          asp-route-id="@booking.Id"
                                          asp-route-status="@FlightBookingStatus.Cancelled"
                                          asp-route-filter="@status"
                                          method="post"
                                          onsubmit="return confirm('Cancel this flight booking?');">
                                        <button type="submit" class="cg-delete">@T["Cancel"]</button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!bookings.Any())
        {
            <div class="cg-empty">@T["No flight bookings yet."]</div>
        }
    </div>
</div>

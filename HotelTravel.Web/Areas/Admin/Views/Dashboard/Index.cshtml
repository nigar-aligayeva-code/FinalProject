@using System.Text.Json

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";

    var monthlyBookings = JsonSerializer.Serialize(ViewBag.MonthlyBookings);
    var monthlyRevenue = JsonSerializer.Serialize(ViewBag.MonthlyRevenue);
    var bookingStatuses = JsonSerializer.Serialize(ViewBag.BookingStatuses);
    var bookingStatusCounts = JsonSerializer.Serialize(ViewBag.BookingStatusCounts);
}

<style>
    .dashboard-heading {
        margin-bottom: 28px;
    }

        .dashboard-heading h1 {
            margin: 0 0 8px;
            font-size: 28px;
            color: #0f172a;
        }

        .dashboard-heading p {
            color: #64748b;
            margin: 0;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 28px;
    }

    .stat-card, .chart-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        border: 1px solid #edf2f7;
        box-shadow: 0 5px 25px rgba(30, 41, 59, 0.04);
    }

    .stat-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(30, 41, 59, 0.09);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 18px;
    }

    .icon-hotels {
        background: #dbeafe;
        color: #2563eb;
    }

    .icon-rooms {
        background: #dcfce7;
        color: #16a34a;
    }

    .icon-bookings {
        background: #f3e8ff;
        color: #9333ea;
    }

    .icon-revenue {
        background: #ffedd5;
        color: #ea580c;
    }

    .stat-label {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .stat-value {
        font-size: 30px;
        font-weight: 750;
        color: #0f172a;
        overflow-wrap: anywhere;
    }

    .charts-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .chart-card h3 {
        margin: 0 0 6px;
        font-size: 18px;
        color: #0f172a;
    }

    .chart-card p {
        color: #64748b;
        font-size: 13px;
        margin: 0 0 24px;
    }

    .chart-container {
        position: relative;
        height: 300px;
    }

    .chart-card.full-width {
        grid-column: 1 / -1;
    }

    @@media (max-width: 1100px) {
        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .stats-grid, .charts-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-heading">
    <h1>Dashboard Overview</h1>
    <p>Welcome back! Here is your hotel management overview.</p>
</div>

<!-- STATISTICS -->
<div class="stats-grid">

    <div class="stat-card">
        <div class="stat-icon icon-hotels">⌂</div>
        <div class="stat-label">Total Hotels</div>
        <div class="stat-value">@ViewBag.TotalHotels</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon icon-rooms">▤</div>
        <div class="stat-label">Total Rooms</div>
        <div class="stat-value">@ViewBag.TotalRooms</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon icon-bookings">▦</div>
        <div class="stat-label">Total Bookings</div>
        <div class="stat-value">@ViewBag.TotalBookings</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon icon-revenue">₼</div>
        <div class="stat-label">Total Revenue (Estimated)</div>
        <div class="stat-value">
            @(((decimal)ViewBag.TotalRevenue).ToString("N2")) AZN
        </div>
    </div>

</div>

<!-- CHARTS -->
<div class="charts-grid">

    <div class="chart-card">
        <h3>Monthly Bookings</h3>
        <p>Bookings by check-in month — @ViewBag.ChartYear</p>
        <div class="chart-container">
            <canvas id="bookingsChart"></canvas>
        </div>
    </div>

    <div class="chart-card">
        <h3>Booking Status</h3>
        <p>Distribution of reservation statuses</p>
        <div class="chart-container">
            <canvas id="statusChart"></canvas>
        </div>
    </div>

    <div class="chart-card full-width">
        <h3>Monthly Revenue</h3>
        <p>Non-cancelled booking value by check-in month — @ViewBag.ChartYear</p>
        <div class="chart-container">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const months = [
        'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
        'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'
    ];

    const monthlyBookings = @Html.Raw(monthlyBookings);
    const monthlyRevenue = @Html.Raw(monthlyRevenue);
    const bookingStatuses = @Html.Raw(bookingStatuses);
    const bookingStatusCounts = @Html.Raw(bookingStatusCounts);

    new Chart(document.getElementById('bookingsChart'), {
        type: 'bar',
        data: {
            labels: months,
            datasets: [{
                label: 'Bookings',
                data: monthlyBookings,
                backgroundColor: '#3b82f6',
                borderRadius: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { precision: 0 }
                }
            }
        }
    });

    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
            labels: bookingStatuses,
            datasets: [{
                data: bookingStatusCounts,
                backgroundColor: [
                    '#3b82f6',
                    '#22c55e',
                    '#f59e0b',
                    '#ef4444',
                    '#a855f7',
                    '#14b8a6'
                ],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });

    new Chart(document.getElementById('revenueChart'), {
        type: 'line',
        data: {
            labels: months,
            datasets: [{
                label: 'Revenue (AZN)',
                data: monthlyRevenue,
                borderColor: '#16a34a',
                backgroundColor: 'rgba(22,163,74,0.1)',
                fill: true,
                tension: 0.4,
                pointRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
</script>

@model List<HotelTravel.Application.DTOs.Rooms.GetRoomDto>

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Rooms";

    var hotelNames =
        ViewBag.HotelNames as Dictionary<int, string>
        ?? new Dictionary<int, string>();
}

<style>
    .rooms-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        gap: 16px;
    }

        .rooms-heading h1 {
            font-size: 28px;
            margin: 0 0 6px;
            color: #0f172a;
        }

        .rooms-heading p {
            color: #64748b;
            margin: 0;
        }

    .rooms-panel {
        background: white;
        border-radius: 16px;
        padding: 24px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 5px 25px rgba(30,41,59,.04);
    }

    .rooms-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
    }

    .rooms-search {
        width: 340px;
        max-width: 100%;
        padding: 12px 15px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        outline: none;
    }

        .rooms-search:focus {
            border-color: #2563eb;
        }

    .rooms-table-wrap {
        overflow-x: auto;
    }

    .rooms-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

        .rooms-table th {
            padding: 15px;
            background: #f8fafc;
            color: #64748b;
            font-size: 13px;
            white-space: nowrap;
        }

        .rooms-table td {
            padding: 15px;
            border-bottom: 1px solid #f1f5f9;
            color: #334155;
            vertical-align: middle;
        }

    .room-info {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 190px;
    }

    .room-image {
        width: 64px;
        height: 55px;
        border-radius: 10px;
        object-fit: cover;
        background: #f1f5f9;
    }

    .room-name {
        font-weight: 650;
        color: #0f172a;
    }

    .room-number {
        font-size: 12px;
        color: #64748b;
        margin-top: 4px;
    }

    .room-type {
        display: inline-block;
        background: #eff6ff;
        color: #2563eb;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
    }

    .room-placeholder {
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: #2563eb;
        font-size: 27px;
        flex-shrink: 0;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .edit-btn, .delete-btn {
        border: none;
        padding: 9px 13px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
    }

    .edit-btn {
        background: #dbeafe;
        color: #2563eb;
    }

    .delete-btn {
        background: #fee2e2;
        color: #dc2626;
    }

    .success-message {
        padding: 14px;
        background: #dcfce7;
        color: #166534;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .delete-dialog {
        border: none;
        border-radius: 16px;
        padding: 28px;
        width: 390px;
        max-width: calc(100% - 32px);
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
    }

        .delete-dialog::backdrop {
            background: rgba(15,23,42,.5);
        }

    .dialog-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
    }
</style>

<div class="rooms-heading">
    <div>
        <h1>Rooms Management</h1>
        <p>Manage hotel rooms, prices and availability details.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="success-message">
        @TempData["Success"]
    </div>
}

<div class="rooms-panel">

    <div class="rooms-toolbar">
        <h3>All Rooms (@Model.Count)</h3>

        <input type="text"
               id="roomSearch"
               class="rooms-search"
               placeholder="Search rooms, hotels, numbers..." />
    </div>

    <div class="rooms-table-wrap">
        <table class="rooms-table">
            <thead>
                <tr>
                    <th>Room</th>
                    <th>Hotel</th>
                    <th>Type</th>
                    <th>Capacity</th>
                    <th>Price / Night</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody id="roomsTableBody">
                @foreach (var room in Model)
                {
                    var hotelName = hotelNames.TryGetValue(
                        room.HotelId, out var name)
                        ? name
                        : "Unknown Hotel";

                    <tr>
                        <td>
                            <div class="room-info">
                                @if (!string.IsNullOrWhiteSpace(room.MainImage))
                                {
                                    <img class="room-image"
                                         src="@Url.Content(room.MainImage.StartsWith("~/")
                                                 ? room.MainImage
                                                 : room.MainImage.StartsWith("/")
                                                     ? "~" + room.MainImage
                                                     : "~/" + room.MainImage)"
                                         alt="@room.Name"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                    <div class="room-image room-placeholder" style="display:none;">
                                        🛏️
                                    </div>
                                }
                                else
                                {
                                    <div class="room-image room-placeholder">
                                        🛏️
                                    </div>
                                }

                                <div>
                                    <div class="room-name">
                                        @room.Name
                                    </div>
                                    <div class="room-number">
                                        Room #@room.RoomNumber
                                    </div>
                                </div>
                            </div>
                        </td>

                        <td>@hotelName</td>

                        <td>
                            <span class="room-type">
                                @room.RoomType
                            </span>
                        </td>

                        <td>@room.Capacity guests</td>

                        <td>
                            <strong>
                                @room.PricePerNight.ToString("N2") AZN
                            </strong>
                        </td>

                        <td>
                            <div class="action-buttons">
                                <a asp-area="Admin"
                                   asp-controller="Rooms"
                                   asp-action="Edit"
                                   asp-route-id="@room.Id"
                                   class="edit-btn">
                                    Edit
                                </a>

                                <button type="button"
                                        class="delete-btn"
                                        data-room-id="@room.Id"
                                        data-room-name="@room.Name"
                                        onclick="openDeleteDialog(this)">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p id="noRoomsFound"
       style="display:none; text-align:center; padding:25px; color:#64748b;">
        No matching rooms found.
    </p>
</div>

<dialog id="deleteDialog" class="delete-dialog">
    <h3 style="margin-top:0;">Delete Room?</h3>

    <p style="color:#64748b;">
        Are you sure you want to delete
        <strong id="deleteRoomName"></strong>?
    </p>

    <p style="color:#dc2626;font-size:13px;">
        This room will no longer appear in active room listings.
    </p>

    <form id="deleteRoomForm"
          asp-area="Admin"
          asp-controller="Rooms"
          asp-action="Delete"
          method="post">

        @Html.AntiForgeryToken()

        <div class="dialog-actions">
            <button type="button"
                    class="edit-btn"
                    onclick="document.getElementById('deleteDialog').close()">
                Cancel
            </button>

            <button type="submit" class="delete-btn">
                Yes, Delete
            </button>
        </div>
    </form>
</dialog>

<script>
    const roomSearch = document.getElementById('roomSearch');
    const roomRows = document.querySelectorAll('#roomsTableBody tr');

    roomSearch.addEventListener('input', function() {
        const query = this.value.toLowerCase().trim();
        let visibleCount = 0;

        roomRows.forEach(row => {
            const match = row.innerText.toLowerCase().includes(query);
            row.style.display = match ? '' : 'none';

            if (match) visibleCount++;
        });

        document.getElementById('noRoomsFound').style.display =
            visibleCount === 0 ? 'block' : 'none';
    });

    function openDeleteDialog(button) {
        const roomId = button.dataset.roomId;
        const roomName = button.dataset.roomName;

        document.getElementById('deleteRoomName').textContent = roomName;

        const form = document.getElementById('deleteRoomForm');
        form.action = '@Url.Action("Delete", "Rooms", new { area = "Admin" })'
            + '?id=' + encodeURIComponent(roomId);

        document.getElementById('deleteDialog').showModal();
    }
</script>

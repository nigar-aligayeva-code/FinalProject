# Bu faylı ".env" adı ilə kopyalayın və dəyərləri dəyişin.
# .env GitHub-a getmir (.gitignore), parollar repoda saxlanmır.

# SQL Server "sa" parolu: ən azı 8 simvol, böyük/kiçik hərf, rəqəm və simvol
SA_PASSWORD=Tripio_Demo_Pass_2026!

# JWT imza açarı: ən azı 32 simvol
JWT_KEY=change-me-to-a-long-random-secret-key-2026

# İlk admin istifadəçi
ADMIN_EMAIL=admin@tripio.az
ADMIN_PASSWORD=Admin123!
